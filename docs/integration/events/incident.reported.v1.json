    "trip_no": {
      "type": "string"
    },
    "plate_no": {
      "type": "string"
    },
    "incident_type": {
      "type": "string"
    },
    "severity": {
      "type": "string"
    },
    "injuries": {
      "type": "boolean"
    },
    "out_of_service": {
      "type": "boolean"
    },
    "platform": {
      "type": "boolean"
    }
  },
  "required": [
    "incident_id",
    "trip_no",
    "incident_type",
    "severity"
  ],
  "additionalProperties": true
}
