{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masslak.com/schemas/events/incident.reported.v1.json",
  "title": "incident.reported",
  "description": "An incident was reported on a trip. The data of the envelope (EVENTS.md); fields are only added within a version.",
  "x-event-type": "incident.reported",
  "x-schema-version": 1,
