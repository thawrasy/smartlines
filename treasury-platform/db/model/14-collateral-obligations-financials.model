# =============================================================================
# 14-collateral-obligations-financials.model -- A5: الضمانات (col) + الالتزامات والتعهدات (obl) + البيانات المالية (fin)
# المصدر: docs/10-detailed-analysis/12-m5-facilities-pricing-collateral-obligations.md  §6.3 COL · §6.4 OBL · §6.5 FIN
#         + FR-COL/OBL/FIN · BR-COL-001..007 · BR-OBL-001..011 · BR-FIN-001..011 · V-COL/OBL/FIN · §8 الحالات · docs/03 (الصيغ والتحقق)
# قرارات ملزمة: SQL Server 2025 · قاعدة واحدة بعزل صفوف (TenantId تلقائي، مفاتيح مركّبة) · BIGINT IDENTITY (INT للكتالوج)
#   جذور API بـ public · لا temporal: التاريخ = صفوف مراجَعة (rev) ومختومة المصدر (src) + aud.AuditLog · لا حذف فعلي لبيانات ائتمانية
#   مبلغ = money (+ عملة) · نسبة = rate بنقاط مئوية · تاريخ ميلادي · ts = UTC · لا أرقام هوية هنا (الكفيل = pty.Party)
# عقد المراجعات (rev) كما في 13-facilities-pricing-terms.model: الجاري = ToRevision IS NULL وعليه تقوم الفرادة المصفّاة؛ قراءة المعتمد
#   FromRevision <= Facility.ApprovedRevisionNo < ToRevision (BR-FAC-003). الخاضع للمراجعة هنا: CollateralLink · Obligation ·
#   ReportingObligation · Covenant. عند اعتماد صف جديد تُنسخ أبناؤه المنمّطة (الجداول الوسيطة ObligationCompany/CovenantAccount
#   وReportingObligation/Covenant) وتُعاد وصلة الصفوف التشغيلية (ReportingInstance · CovenantTest · ObligationBreach) إلى الصف الجديد
#   في معاملة الاعتماد نفسها. PublicId لـ Obligation يعرّف نسخة الصف؛ وتُحلّ الحالية بسلسلة SupersedesId.
# خارج المراجعة وبدورات اعتماد خاصة: Collateral (ApprovalState) · FinancialStatement (Status) · MeasureFormula (Status) — FR-COL-014 · FR-FIN-005 · FR-FIN-011.
# الفصل بين المُعِدّ والمعتمِد يضبطه إعداد wf.sod.allow_same_person (قرار المالك: المنشئ/المدقق/المعتمِد شخص أو أكثر بحسب الصلاحيات) فلا يُفرض بقيد قاعدة.
# العملة: CollateralLink.CoverageAmount بعملة التسهيل (BR-FAC-002)؛ StatementLine بعملة رأس القائمة؛ AccountMonthlyStat بعملة الحساب؛
#   وأُضيف CurrencyId حيث تذكر المواصفة مبلغًا بلا عملة (تأمين، تقييم، معلَمة ثابتة).
# مشتقات لا تُخزَّن (README): PNRatio · NextRenewalDue · Variance · BalanceDifference · الحالة المجمَّعة RED/AMBER/GREEN/GREY · DUE_SOON/OVERDUE.
# فرادة مع أعمدة قابلة للـ NULL: SQL Server يعدّ NULL مساويًا لـ NULL في الفهرس الفريد (فتُفرض فرادة التسهيل بلا حد)؛ PostgreSQL للتحقق البنيوي فقط.
# مراجع خارجية (يعرّفها غيري): org.Company · pty.Party · pty.IdentityDocument · ins.Institution · ins.Contact · acc.BankAccount
#   cat.CollateralType · cat.ObligationType · cat.LookupItem · fac.Facility · fac.Limit · fac.LimitProductLine · fac.ValueConflict (عبر src)
#   doc.Document · sec.AppUser · ref.Currency
# =============================================================================

# ============================== المخطط col: الضمانات ==============================
module COL

table col.Collateral public src  # Collateral record; approved independently of the facility review, and an amendment creates a new revision (FR-COL-001/014, V-COL-01, section 8)
  StructureKind      enum{GUARANTEE,PROMISSORY_NOTE,INSURANCE_ASSIGNMENT,CASH_MARGIN,REAL_ESTATE,SET_OFF,NEGATIVE_PLEDGE,GENERIC} req   # نسخة من بنية النوع: يربط بها كل نوع فرعي نوعَه (DR-40)
  CollateralTypeId   ->cat.CollateralType req via=StructureKind   # بنية النوع وقالب السمات من 11 (FR-CAT-013)؛ بنية نوع مستعمل لا تتغير
  TitleAr            str(300)   req
  Description        str(2000)
  OwnerPartyId       ->pty.Party          # مزوّد استخدام Collateral owner؛ شركة المجموعة بـ Party المرآة (FR-COL-015)
  Attributes         json sens=restricted   # DR-08: سمات القالب (قد تحمل معرّفات) محجوبة عن التقارير؛ الحساب النقدي يُربط بالنوع أدناه
  CashMarginAccountId ->acc.BankAccount     # الحساب النقدي للهامش: مرجع مُعرَّف لا سمة حرّة (DR-08)
  Status             enum{DRAFT,ACTIVE,RELEASED,EXPIRED,SUPERSEDED,DISCARDED} req =DRAFT   # SUPERSEDED: نسخة معتمدة حلّت محلها أحدث؛ DISCARDED: مسودة متروكة (DR-36)
  ApprovalState      enum{DRAFT,APPROVED} req =DRAFT
  ApprovedBy         ->sec.AppUser        # إضافة: لازم لعقد المُعِدّ/المعتمِد (FR-COL-014، §12)
  ApprovedOn         ts                   # إضافة
  SupersedesId       ->col.Collateral via=InheritedRootId>RootId   # النسخة الجديدة DRAFT تشير إلى المعتمدة (FR-COL-014)، ومن الجذر نفسه (DR-36)
  InheritedRootId    bigint               # RootId للنسخة السابقة؛ فارغ للنسخة الأولى (DR-36)
  calc RootId        bigint =CASE WHEN InheritedRootId IS NULL THEN CollateralId ELSE InheritedRootId END   # هوية الضمان الثابتة عبر نسخه: معرّف نسخته الأولى؛ إليها يشير CollateralLink (DR-36)
  GrantedOn          date
  ReleasedOn         date                 # الفك بتاريخ وسبب ووثيقة بلا حذف (FR-COL-010)
  ReleaseReason      str(500)
  ReleaseDocumentId  ->doc.Document
  unique PublicId
  index  CollateralTypeId,Status include OwnerPartyId,ApprovalState   # سجل الضمانات بالنوع والحالة وتنبيه التشابه (R-COL-02)
  index  Status,ApprovalState              # المعتمد الفعّال للتغطية (BR-COL-005)
  check  Status IN ('DRAFT','DISCARDED') OR ApprovalState = 'APPROVED'   # DRAFT→ACTIVE باعتماد السجل (§8)؛ المتروكة مسودة لم تُعتمد
  check  ApprovalState <> 'APPROVED' OR Status NOT IN ('DRAFT','DISCARDED')
  check  ApprovalState <> 'APPROVED' OR (ApprovedBy IS NOT NULL AND ApprovedOn IS NOT NULL)   # FR-COL-014
  check  Status <> 'RELEASED' OR (ReleasedOn IS NOT NULL AND ReleaseReason IS NOT NULL AND ReleaseDocumentId IS NOT NULL)   # FR-COL-010: بتاريخ وسبب ووثيقة (DR-36، جواب السؤال 5)
  check  Status = 'RELEASED' OR (ReleasedOn IS NULL AND ReleaseReason IS NULL AND ReleaseDocumentId IS NULL)
  check  GrantedOn IS NULL OR ReleasedOn IS NULL OR ReleasedOn >= GrantedOn
  check  SupersedesId IS NULL OR SupersedesId <> CollateralId
  check  SourceDocumentId IS NOT NULL AND SourcePage IS NOT NULL OR (SourceDocumentId IS NULL AND Confidence = 'ENTERED_NO_DOCUMENT')   # ختم المصدر (BR-FAC-018)
  check  Confidence <> 'CONFIRMED_AGAINST_ORIGINAL' OR (VerifiedBy IS NOT NULL AND VerifiedOn IS NOT NULL)
  check  (SupersedesId IS NULL AND InheritedRootId IS NULL) OR (SupersedesId IS NOT NULL AND InheritedRootId IS NOT NULL)
  unique RootId where ApprovalState = 'APPROVED' AND Status <> 'SUPERSEDED'   # نسخة معتمدة حالية واحدة لكل ضمان (DR-36)
  unique RootId,Status where Status = 'DRAFT'   # مسودة مفتوحة واحدة لكل ضمان (Status ثابت في المرشّح)

table col.CollateralLink rev  # Link between collateral and a facility or limit; one collateral can serve several facilities (FR-COL-002, BR-COL-005)
  CollateralId    ->col.Collateral req   # النسخة الأولى للضمان، جذره؛ فلا يُعاد الربط عند نسخة جديدة، والنسخة المعتمدة الحالية تُقرأ بـ RootId (DR-36؛ قادح في 044)
  FacilityId      ->fac.Facility req
  LimitId         ->fac.Limit via=FacilityId   # حد من التسهيل نفسه؛ فارغ = على مستوى التسهيل
  CoverageAmount  money                        # بعملة التسهيل (BR-FAC-002)
  LienRank        int                          # رتبة الرهن
  LinkedOn        date       req
  UnlinkedOn      date                         # فك الربط يضع التاريخ ولا يحذف (FR-COL-002)
  unique CollateralId,FacilityId,LimitId where UnlinkedOn IS NULL AND ToRevision IS NULL   # فريد بين الفعّال
  index  FacilityId include CollateralId,LimitId,CoverageAmount where UnlinkedOn IS NULL AND ToRevision IS NULL   # تغطية التسهيل (R-COL-01، BR-COL-006)
  check  CoverageAmount IS NULL OR CoverageAmount > 0     # V-COL-01
  check  LienRank IS NULL OR LienRank >= 1
  check  UnlinkedOn IS NULL OR UnlinkedOn >= LinkedOn
  check  ToRevision IS NULL OR ToRevision >= FromRevision

table col.Guarantee  # Guarantee, 1:1 with Collateral; the guarantor is always a Party, and no identity numbers are stored here (FR-COL-003/004, BR-COL-001)
  StructureKind                enum{GUARANTEE} req =GUARANTEE   # ثابت: الكفالة لضمان بنيته GUARANTEE (DR-40)
  CollateralId                 ->col.Collateral req via=StructureKind
  GuarantorPartyId             ->pty.Party req   # فرد أو جهة؛ نوع الكفيل مشتق من Party.Kind ولا يُخزَّن؛ مزوّد Guarantee (FR-COL-015)
  GuarantorIdentityDocumentId  ->pty.IdentityDocument via=GuarantorPartyId>PartyId   # وثيقة الكفيل نفسه وقت التوقيع (BR-PTY-006، DR-33)؛ دمج الأطراف ينقل الوثائق في معاملة واحدة
  GuaranteeForm                enum{JOINT_SEVERAL_PAYMENT_PERFORMANCE,SIMPLE,OTHER} req
  IsJointSeveral               bool       req
  AmountMode                   enum{SPECIFIED,UNSPECIFIED} req   # UNSPECIFIED تُعدّ ولا تُجمع (BR-COL-001)
  Amount                       money
  CurrencyId                   ->ref.Currency
  SignedOn                     date
  ValidTo                      date
  DeedDocumentId               ->doc.Document
  unique CollateralId
  index  ValidTo include CollateralId where ValidTo IS NOT NULL   # انتهاء الكفالة (R-COL-02)
  check  AmountMode <> 'SPECIFIED' OR (Amount IS NOT NULL AND CurrencyId IS NOT NULL)   # مبلغ محدد بلا رقم يُرفض (FR-COL-003)
  check  AmountMode <> 'UNSPECIFIED' OR (Amount IS NULL AND CurrencyId IS NULL)         # «غير محدد» مع رقم يُرفض
  check  Amount IS NULL OR Amount > 0                     # V-COL-01
  check  SignedOn IS NULL OR ValidTo IS NULL OR ValidTo >= SignedOn
  check  GuaranteeForm <> 'JOINT_SEVERAL_PAYMENT_PERFORMANCE' OR IsJointSeveral = 1   # غرم وأداء تضامنية

table col.PromissoryNote  # Promissory note, 1:1; its own amount may exceed the limit (FR-COL-005, BR-COL-002); NextRenewalDue and PNRatio are derived
  StructureKind   enum{PROMISSORY_NOTE} req =PROMISSORY_NOTE   # ثابت (DR-40)
  CollateralId    ->col.Collateral req via=StructureKind
  NoteAmount      money      req
  CurrencyId      ->ref.Currency req
  IssuedOn        date       req
  DueKind         enum{ON_DEMAND,FIXED_DATE} req
  DueDate         date
  RenewalCycle    enum{NONE,ANNUAL} req
  LastRenewedOn   date
  CustodyKind     enum{BANK,COMPANY,OTHER} req   # موضع الحفظ
  NoteDocumentId  ->doc.Document
  unique CollateralId
  index  LastRenewedOn include IssuedOn,CollateralId where RenewalCycle = 'ANNUAL'   # JOB-COL-DUE وNTF-COL-01: (آخر تجديد أو الإصدار) + 12 شهرًا
  check  NoteAmount > 0                                   # V-COL-01
  check  DueKind <> 'FIXED_DATE' OR (DueDate IS NOT NULL AND DueDate >= IssuedOn)
  check  DueKind <> 'ON_DEMAND' OR DueDate IS NULL
  check  LastRenewedOn IS NULL OR LastRenewedOn >= IssuedOn
  check  RenewalCycle <> 'NONE' OR LastRenewedOn IS NULL

table col.PromissoryNoteSigner pk=PromissoryNoteId,PartyId norv deletable  # Signers of the promissory note (SignerPartyIds) -- جدول وسيط جديد؛ موقّعو PromissoryNote (FR-COL-015)
  PromissoryNoteId  ->col.PromissoryNote req
  PartyId           ->pty.Party req   # الدمج (FR-PTY-016) يعيد التوجيه ويحذف المكرر لذا الحذف مسموح للتطبيق

table col.InsurancePolicyAssignment  # Insurance policy assignment; the uniqueness key (CollateralId, PolicyNo) allows the policy to be renewed (FR-COL-006, BR-COL-003)
  StructureKind            enum{INSURANCE_ASSIGNMENT} req =INSURANCE_ASSIGNMENT   # ثابت: التنازل لنوع INSURANCE_ASSIGNMENT وحده (قرار المالك 2026-10-13، DR-40)
  CollateralId             ->col.Collateral req via=StructureKind
  PolicyNo                 str(60)    req
  InsurerName              str(200)   req
  AssignedToInstitutionId  ->ins.Institution req
  CoverageBasis            enum{PCT_OF_LIMIT,FIXED_AMOUNT,FULL_LIMITS} req
  CoveragePct              rate
  CoverageAmount           money
  SumInsured               money      req
  CurrencyId               ->ref.Currency req   # إضافة: عملة وثيقة التأمين (المواصفة بلا عملة)
  PolicyStart              date
  PolicyExpiry             date       req
  AssignmentDate           date
  PolicyDocumentId         ->doc.Document
  unique CollateralId,PolicyNo
  index  PolicyExpiry include CollateralId        # انتهاء الوثيقة T-60/30/7 (NTF-COL-01)
  check  SumInsured > 0                                   # V-COL-01
  check  PolicyStart IS NULL OR PolicyExpiry >= PolicyStart
  check  CoverageBasis <> 'PCT_OF_LIMIT' OR (CoveragePct IS NOT NULL AND CoveragePct > 0 AND CoverageAmount IS NULL)
  check  CoverageBasis <> 'FIXED_AMOUNT' OR (CoverageAmount IS NOT NULL AND CoverageAmount > 0 AND CoveragePct IS NULL)
  check  CoverageBasis <> 'FULL_LIMITS' OR (CoveragePct IS NULL AND CoverageAmount IS NULL)

table col.ValuationSchedule  # Property valuation schedule (FR-COL-008, BR-COL-004), for example three valuers in the first year, then one valuer per year
  StructureKind        enum{REAL_ESTATE,GENERIC} req   # جدول التقييم للعقار والضمان العام (قرار المالك 2026-10-13، DR-40)
  CollateralId         ->col.Collateral req via=StructureKind
  PhaseNo              int        req
  FromYear             int        req   # سنوات من ReferenceDate
  ToYear               int              # فارغ = مفتوحة إلى النهاية
  RequiredValuerCount  int        req
  FrequencyMonths      int        req   # 0 = مرة واحدة
  ReferenceDate        date       req
  LastValuationOn      date
  LastValuationAmount  money
  CurrencyId           ->ref.Currency   # إضافة: عملة آخر تقييم
  unique CollateralId,PhaseNo
  unique CollateralId where ToYear IS NULL                # مرحلة واحدة مفتوحة فقط وإلا تداخلت المراحل (V-COL-01)
  index  LastValuationOn include ReferenceDate,FrequencyMonths,CollateralId   # موعد التقييم القادم (NTF-COL-01)
  check  PhaseNo >= 1
  check  FromYear >= 1
  check  ToYear IS NULL OR ToYear >= FromYear
  check  RequiredValuerCount >= 1
  check  FrequencyMonths >= 0
  check  LastValuationAmount IS NULL OR (LastValuationAmount > 0 AND LastValuationOn IS NOT NULL AND CurrencyId IS NOT NULL)
  check  LastValuationOn IS NULL OR LastValuationAmount IS NOT NULL

# ============================== المخطط obl: الالتزامات والتعهدات ==============================
module OBL

table obl.Obligation public rev src  # Obligation on a facility (or on a limit, line or set of companies); the family comes from ObligationType and cannot be edited (FR-OBL-001, BR-OBL-001)
  FacilityId          ->fac.Facility req
  Family              enum{REPORTING,COVENANT,TRANSACTION_RESTRICTION,STATIC_CLAUSE} req   # نسخة من عائلة النوع (BR-CAT-010): يربط بها التقرير والتعهد نوعَهما (DR-40)
  ObligationTypeId    ->cat.ObligationType req via=Family   # عائلة نوع مستعمل لا تتغير
  TitleAr             str(300)   req
  TitleEn             str(300)
  Phase               enum{PRECEDENT,ONGOING,SUBSEQUENT} req =ONGOING
  ScopeLimitId        ->fac.Limit via=FacilityId             # حد من التسهيل نفسه
  ScopeProductLineId  ->fac.LimitProductLine via=FacilityId,ScopeLimitId>LimitId   # خط من الحد نفسه في التسهيل نفسه (DR-35)
  ClauseRef           str(100)
  ClauseText          text       sens=confidential redact   # نص البند كما في الاتفاقية (DR-31)؛ بلا IBAN أو رقم حساب صريح (DQ-S06-7)
  ConsequenceText     str(2000)
  GraceDays           int              # مهلة سماح (FR-OBL-010)
  CureDays            int              # مهلة علاج الخرق (FR-OBL-010، BR-OBL-009)
  ParamValue          dec(19,6)        # بند ثابت برقم (FR-OBL-008)
  ParamUnit           enum{DAYS,BUSINESS_DAYS,MONTHS,PCT,AMOUNT}
  ParamCurrencyId     ->ref.Currency   # إضافة: عملة ParamValue حين ParamUnit=AMOUNT
  TriggerField        ascii(100)       # حقل الاعتماد المستندي المقيَّم (FR-OBL-009)
  TriggerValues       json             # قيم المشغّل (مصفوفة)
  CheckMode           enum{OFF,WARN,BLOCK}   # فارغ = افتراضي المشترك (FR-OBL-009)
  Status              enum{ACTIVE,SUSPENDED} req =ACTIVE   # ENDED مشتقة من ValidTo وحالة التسهيل ولا تُخزَّن (DQ-F15-1، المراجعة الذاتية B7c)
  ValidFrom           date       req
  ValidTo             date
  unique PublicId
  index  FacilityId,Status include ObligationTypeId,Phase,FromRevision,ToRevision   # بطاقة الالتزامات ولوحة الامتثال (R-OBL-04)
  index  FacilityId,ObligationTypeId,ScopeLimitId,ScopeProductLineId,ValidFrom where ToRevision IS NULL   # تنبيه تكرار (لا منع) (§6.4)
  index  ValidTo where ValidTo IS NOT NULL AND ToRevision IS NULL   # انتهاء الالتزام
  check  ValidTo IS NULL OR ValidTo >= ValidFrom
  check  GraceDays IS NULL OR GraceDays >= 0
  check  CureDays IS NULL OR CureDays >= 0
  check  (ParamValue IS NULL AND ParamUnit IS NULL) OR (ParamValue IS NOT NULL AND ParamUnit IS NOT NULL)   # ParamValue بوحدة (FR-OBL-008)
  check  ParamValue IS NULL OR ParamValue >= 0
  check  ParamUnit IS NULL OR ParamUnit <> 'AMOUNT' OR ParamCurrencyId IS NOT NULL
  check  ParamCurrencyId IS NULL OR ParamUnit = 'AMOUNT'
  check  TriggerValues IS NULL OR TriggerField IS NOT NULL
  check  ToRevision IS NULL OR ToRevision >= FromRevision
  check  SourceDocumentId IS NOT NULL AND SourcePage IS NOT NULL OR (SourceDocumentId IS NULL AND Confidence = 'ENTERED_NO_DOCUMENT')   # ختم المصدر (BR-FAC-018)
  check  Confidence <> 'CONFIRMED_AGAINST_ORIGINAL' OR (VerifiedBy IS NOT NULL AND VerifiedOn IS NOT NULL)
  check  ScopeProductLineId IS NULL OR ScopeLimitId IS NOT NULL   # بلا حد لا يُفحص الربط المركّب (DR-35)

table obl.ObligationCompany pk=ObligationId,CompanyId norv deletable  # Companies the obligation applies to (AppliesToCompanyIds) -- جدول وسيط جديد؛ الحذف لصفوف مسودة المراجعة فقط (يفرضه التطبيق)
  ObligationId  ->obl.Obligation req
  CompanyId     ->org.Company req

table obl.ReportingObligation rev  # Reporting or notice-due rule, 1:1 with Obligation (FR-OBL-002/003, BR-OBL-002, V-OBL-01)
  Family               enum{REPORTING} req =REPORTING   # ثابت (DR-40)
  ObligationId         ->obl.Obligation req via=Family
  Frequency            enum{ANNUAL,SEMIANNUAL,QUARTERLY,MONTHLY,ONE_TIME,EVENT_BASED,ON_DEMAND} req
  AnchorKind           enum{AFTER_PERIOD_END,AFTER_FISCAL_YEAR_END,BEFORE_EVENT,AFTER_EVENT,ON_DEMAND_REQUEST,FIXED_DATE} req   # مطابقة لـ ObligationType.DefaultDeadlineBasis
  OffsetValue          int              # فارغ مع FIXED_DATE فقط
  OffsetUnit           enum{CALENDAR_DAYS,BUSINESS_DAYS,MONTHS} req =CALENDAR_DAYS   # يُهمل مع FIXED_DATE
  FixedDueDate         date             # إلزامي مع FIXED_DATE ولا يُستعمل Offset
  Direction            enum{WE_SUBMIT,WE_RESPOND} req
  DocumentBasis        enum{AUDITED,INTERNAL,ANY,NOT_APPLICABLE} req
  StatementScope       enum{STANDALONE,CONSOLIDATED,ANY}
  SubmissionChannelId  ->cat.LookupItem  # قائمة قنوات التقديم (منصة تنظيمية...)
  ChannelNote          str(300)
  AlertLeadDays        set{30,14,7,3,1} =30,14,7,3,1   # أيام ما قبل الاستحقاق مفصولة بفواصل (NTF-OBL-01)
  FirstPeriodEnd       date
  HorizonMonths        int =24          # أفق التوليد (FR-OBL-003)
  ExpectsEvidence      bool       req   # الدليل إلزامي عند التقديم (FR-OBL-004)
  unique ObligationId where ToRevision IS NULL            # 1:1 بين الجاري
  check  AnchorKind <> 'FIXED_DATE' OR (FixedDueDate IS NOT NULL AND OffsetValue IS NULL)   # BR-OBL-002
  check  AnchorKind = 'FIXED_DATE' OR (FixedDueDate IS NULL AND OffsetValue IS NOT NULL)    # قاعدة مكتملة (V-OBL-01)
  check  OffsetValue IS NULL OR OffsetValue >= 0
  check  HorizonMonths IS NULL OR HorizonMonths > 0
  check  Frequency <> 'EVENT_BASED' OR AnchorKind IN ('BEFORE_EVENT','AFTER_EVENT')   # الحدث ⇒ مرساة حدث (FR-OBL-005)
  check  AnchorKind NOT IN ('BEFORE_EVENT','AFTER_EVENT') OR Frequency = 'EVENT_BASED'
  check  Frequency <> 'ON_DEMAND' OR AnchorKind = 'ON_DEMAND_REQUEST'
  check  AnchorKind <> 'ON_DEMAND_REQUEST' OR Frequency = 'ON_DEMAND'
  check  AlertLeadDays IS NULL OR AlertLeadDays NOT LIKE '%[^0-9,]%'
  check  ToRevision IS NULL OR ToRevision >= FromRevision

table obl.ReportingInstance public  # Agenda item generated or logged for an event (FR-OBL-003..005, BR-OBL-003, section 8); DUE_SOON and OVERDUE are derived; a final status stays (044, DR-39)
  ReportingObligationRootId bigint    req   # RootId of the rule: the agenda follows the rule across revisions (DR-28, self-review B1)
  ReportingObligationId    ->obl.ReportingObligation req via=ReportingObligationRootId>RootId
  PeriodStart              date
  PeriodEnd                date
  EventDate                date
  DueDate                  date       req
  DueDateOverrideReason    str(500)         # تعديل موعد بسبب (SCR-OBL-02)
  Status                   enum{SCHEDULED,SUBMITTED,WAIVED,NOT_APPLICABLE,CANCELLED} req =SCHEDULED
  StatusReason             str(500)         # إضافة: سبب NOT_APPLICABLE/CANCELLED (§8)
  SubmittedOn              date
  SubmissionChannelUsedId  ->cat.LookupItem
  SubmissionRef            str(100)         # مرجع الاستلام
  EvidenceDocumentId       ->doc.Document   # إلزامي حيث ExpectsEvidence (يتحقق التطبيق)
  ReportedAmount           money            # مثل نتيجة تقييم عقار
  CurrencyId               ->ref.Currency
  GeneratedBy              enum{JOB,MANUAL_EVENT} req =JOB
  unique PublicId
  unique ReportingObligationRootId,PeriodEnd where PeriodEnd IS NOT NULL AND Status <> 'CANCELLED'   # فريد (جذر الالتزام، نهاية الفترة): مراجعة جديدة لا تولّد البند مرة ثانية (B1)
  unique ReportingObligationRootId,EventDate where PeriodEnd IS NULL AND EventDate IS NOT NULL AND Status <> 'CANCELLED'   # فريد (جذر الالتزام، تاريخ الحدث)
  unique ReportingObligationRootId,DueDate where PeriodEnd IS NULL AND EventDate IS NULL AND Status <> 'CANCELLED'   # إضافة: تاريخ ثابت واحد بلا فترة ولا حدث
  index  DueDate include ReportingObligationId where Status = 'SCHEDULED'   # قادمة ومتأخرة وJOB-OBL-CALENDAR (R-OBL-01/03، NTF-OBL-01/02)
  index  SubmittedOn include DueDate,ReportingObligationId where Status = 'SUBMITTED'   # مقدَّمة بتأخير (R-OBL-01)
  check  PeriodStart IS NULL OR (PeriodEnd IS NOT NULL AND PeriodEnd >= PeriodStart)
  check  GeneratedBy <> 'MANUAL_EVENT' OR EventDate IS NOT NULL   # EventDate لـ EVENT_BASED (V-OBL-01)
  check  Status <> 'SUBMITTED' OR SubmittedOn IS NOT NULL
  check  Status = 'SUBMITTED' OR (SubmittedOn IS NULL AND SubmissionChannelUsedId IS NULL AND SubmissionRef IS NULL)
  check  Status NOT IN ('NOT_APPLICABLE','CANCELLED') OR StatusReason IS NOT NULL   # بسبب (§8)
  check  Status <> 'WAIVED' OR (StatusReason IS NOT NULL AND EvidenceDocumentId IS NOT NULL)   # التنازل بسبب ووثيقة (DQ-F15-12، B7a)
  check  ReportedAmount IS NULL OR CurrencyId IS NOT NULL
  check  CurrencyId IS NULL OR ReportedAmount IS NOT NULL

table obl.Covenant rev  # Covenant revision with dates; graduated limits are several revisions (FR-OBL-006, BR-OBL-001/005/006, Q-OBL-01)
  Family             enum{COVENANT} req =COVENANT   # ثابت (DR-40)
  ObligationId       ->obl.Obligation req via=Family
  MeasureKind        enum{RATIO,AMOUNT,PERCENT_OF_REVENUE,AVERAGE_BALANCE,FLOW_VOLUME,NONE} req   # NONE = وصفي بلا صيغة ولا حد
  FormulaId          ->fin.MeasureFormula via=FormulaResultUnit>ResultUnit,FormulaUsesStatements>UsesStatements   # إلزامي للثلاثة الأولى؛ انتماؤها للتسهيل أو قالب يتحقق منه التطبيق
  FormulaResultUnit  enum{RATIO,AMOUNT,PERCENT}   # نسخة من وحدة ناتج الصيغة بربط مركّب: الحد بوحدتها (DR-38)
  FormulaUsesStatements bool             # نسخة: الصيغة تقرأ القوائم المالية، فيلزم أساس القائمة ومستوى تدقيقها (DR-38)
  Operator           enum{GE,LE,GT,LT,EQ}
  ThresholdState     enum{SET,NOT_SPECIFIED_IN_AGREEMENT,TO_BE_DETERMINED} req   # الحكم لا يصدر إلا لـ SET (BR-OBL-006)
  ThresholdValue     dec(19,6)        # نسبة أو مبلغ أو نقاط مئوية بحسب ThresholdUnit
  ThresholdUnit      enum{RATIO,AMOUNT,PERCENT}
  CurrencyId         ->ref.Currency   # لعتبة المبلغ
  TestFrequency      enum{MONTHLY,QUARTERLY,SEMIANNUAL,ANNUAL,ROLLING_12M} req
  AggregationMode    enum{POINT_IN_TIME,PERIOD_AVERAGE,EACH_MONTH_MIN,PERIOD_SUM}   # BR-FIN-005
  AnnualWindowBasis  enum{FISCAL_YEAR,CALENDAR_YEAR,FACILITY_YEAR}   # BR-FIN-007
  StatementBasis     enum{STANDALONE,CONSOLIDATED}   # أساس القائمة المطلوبة؛ لا بديل صامت (BR-FIN-003، Q-FIN-02)
  RequiredAssurance  enum{AUDITED_ONLY,PREFER_AUDITED,ANY}   # FR-FIN-007
  RevenueBasisRule   enum{SAME_PERIOD,PRIOR_YEAR,MANUAL_ESTIMATE}   # الافتراضي التطبيقي SAME_PERIOD (BR-FIN-008)
  AccountScopeKind   enum{ALL_COMPANY_ACCOUNTS_AT_BANK,SELECTED_ACCOUNTS,GROUP_ACCOUNTS}   # BR-FIN-006
  TestedCompanyId    ->org.Company req
  SubmissionLagDays  int              # فارغ = افتراضي المشترك 30 (BR-OBL-005، Q-OBL-04)
  FirstTestPeriodEnd date       req
  EarlyWarningPct    rate             # فارغ = افتراضي المشترك 10 (BR-OBL-007)
  ValidFrom          date       req
  ValidTo            date
  unique ObligationId,ValidFrom where ToRevision IS NULL
  index  TestedCompanyId,MeasureKind include ObligationId   # تعهدات الشركة المختبَرة (R-OBL-05)
  check  MeasureKind NOT IN ('RATIO','AMOUNT','PERCENT_OF_REVENUE') OR FormulaId IS NOT NULL   # V-OBL-01: صيغة للمقاييس الرقمية
  check  MeasureKind <> 'NONE' OR (FormulaId IS NULL AND Operator IS NULL AND ThresholdValue IS NULL AND ThresholdState <> 'SET')   # BR-OBL-001
  check  ThresholdState <> 'SET' OR (Operator IS NOT NULL AND ThresholdValue IS NOT NULL AND ThresholdUnit IS NOT NULL)   # SET يتطلب مشغّلًا وقيمة ووحدة (V-OBL-01، DR-38)
  check  ThresholdState = 'SET' OR ThresholdValue IS NULL   # لا قيمة مع غير المحدد ولا تُقدَّر صفرًا (Q-OBL-02)
  check  ThresholdState <> 'SET' OR ThresholdUnit IS NULL OR ThresholdUnit <> 'AMOUNT' OR CurrencyId IS NOT NULL
  check  CurrencyId IS NULL OR ThresholdUnit = 'AMOUNT'
  check  RevenueBasisRule IS NULL OR MeasureKind = 'PERCENT_OF_REVENUE'
  check  (FormulaId IS NULL AND FormulaResultUnit IS NULL AND FormulaUsesStatements IS NULL) OR (FormulaId IS NOT NULL AND FormulaResultUnit IS NOT NULL AND FormulaUsesStatements IS NOT NULL)
  check  ThresholdUnit IS NULL OR FormulaResultUnit IS NULL OR ThresholdUnit = FormulaResultUnit   # وحدة الحد = وحدة ناتج الصيغة (DR-38)
  check  ThresholdUnit IS NULL OR (MeasureKind = 'RATIO' AND ThresholdUnit = 'RATIO') OR (MeasureKind IN ('AMOUNT','AVERAGE_BALANCE','FLOW_VOLUME') AND ThresholdUnit = 'AMOUNT') OR (MeasureKind = 'PERCENT_OF_REVENUE' AND ThresholdUnit = 'PERCENT')   # الوحدة من نوع القياس (DR-38)
  check  FormulaUsesStatements IS NULL OR FormulaUsesStatements = 0 OR (StatementBasis IS NOT NULL AND RequiredAssurance IS NOT NULL)   # صيغة على القوائم تحدد أساسها ومستوى تدقيقها، بلا بديل صامت (BR-FIN-003، DR-38)
  check  SubmissionLagDays IS NULL OR SubmissionLagDays >= 0
  check  EarlyWarningPct IS NULL OR (EarlyWarningPct >= 0 AND EarlyWarningPct <= 100)
  check  ValidTo IS NULL OR ValidTo >= ValidFrom
  check  ToRevision IS NULL OR ToRevision >= FromRevision

table obl.CovenantAccount pk=CovenantId,BankAccountId norv deletable  # Accounts covered by a covenant when specific accounts are selected (AccountIds) -- جدول وسيط جديد؛ الحذف لصفوف مسودة المراجعة فقط (يفرضه التطبيق)
  CovenantId     ->obl.Covenant req
  BankAccountId  ->acc.BankAccount req

table obl.CovenantTest public  # Covenant test for a period and test version; an evaluated test changes only by its review (044, DR-39) (FR-OBL-011, FR-FIN-012/013, BR-OBL-006/007, section 8)
  CovenantRootId     bigint     req   # RootId of the covenant: tests follow the covenant across revisions (DR-28, self-review B1)
  CovenantId         ->obl.Covenant req via=CovenantRootId>RootId
  PeriodStart        date       req
  PeriodEnd          date       req
  DueDate            date       req   # PeriodEnd + SubmissionLagDays (BR-OBL-005)
  EvaluationNo       int        req =1   # إعادة التقييم تضيف رقمًا ولا تعدّل القديم (BR-OBL-011)
  State              enum{SCHEDULED,PENDING_DATA,EVALUATED,REVIEWED,CANCELLED} req =SCHEDULED   # CANCELLED: اختبار مجدول خرج من الجدول، بسبب، ونهائي (DQ-F15-2، B3)
  CancelReason       str(500)
  Result             enum{COMPLIANT,WARNING,BREACH,MISSING_DATA,NOT_ASSESSED_NO_THRESHOLD,NOT_COMPARABLE,MANUAL_COMPLIANT,MANUAL_NON_COMPLIANT,UNDER_REVIEW}
  Method             enum{AUTO,MANUAL_VALUE,MANUAL_STATUS} req
  ActualValue        dec(19,6)
  ThresholdApplied   dec(19,6)        # العتبة والمشغّل المطبَّقان وقت التقييم (BR-FIN-010)
  OperatorApplied    enum{GE,LE,GT,LT,EQ}
  Headroom           dec(19,6)        # a-t أو t-a (BR-OBL-007)
  HeadroomPct        dec(19,6)        # قد يتجاوز 999.999999 عند عتبة صغيرة جدًا فلا rate
  InputsSnapshot     json             # لقطة المدخلات؛ إلزامية مع EVALUATED/REVIEWED ثابتة بعد الحفظ، وكاملة للتقييم الآلي (BR-FIN-010، DR-39)
  FormulaId          ->fin.MeasureFormula   # نسخة الصيغة المستعملة نفسها، لا رقمها (DR-39)
  EvaluatedAt        ts
  EvaluatedBy        ->sec.AppUser    # فارغ = المحرك الآلي
  EvidenceDocumentId ->doc.Document
  ReviewNote         str(1000)
  ReviewedBy         ->sec.AppUser
  ReviewedOn         ts
  NextReviewOn       date             # المراجعة الفائتة = مراجعة متأخرة (FR-OBL-007، BR-OBL-008)
  unique PublicId
  unique CovenantRootId,PeriodEnd,EvaluationNo   # رقم التقييم لكل جذر وفترة: مراجعة التعهد لا تبدأ العد من جديد (B1)
  index  DueDate include CovenantId,State where State IN ('SCHEDULED','PENDING_DATA')   # JOB-FIN-EVAL وبيانات ناقصة (NTF-OBL-05)
  index  Result,PeriodEnd include CovenantId,State   # نتائج التعهدات والهامش والإنذار (R-OBL-02)
  index  NextReviewOn include CovenantId where NextReviewOn IS NOT NULL   # مراجعة وصفية متأخرة (NTF-OBL-06)
  check  EvaluationNo >= 1
  check  PeriodEnd >= PeriodStart
  check  DueDate >= PeriodEnd              # BR-OBL-005: SubmissionLagDays >= 0
  check  State NOT IN ('SCHEDULED','CANCELLED') OR (Result IS NULL AND EvaluatedAt IS NULL)
  check  State <> 'CANCELLED' OR CancelReason IS NOT NULL   # B3
  check  CancelReason IS NULL OR State = 'CANCELLED'
  check  State NOT IN ('EVALUATED','REVIEWED') OR (Result IS NOT NULL AND EvaluatedAt IS NOT NULL AND InputsSnapshot IS NOT NULL)   # FR-FIN-013
  check  State <> 'REVIEWED' OR (ReviewedBy IS NOT NULL AND ReviewedOn IS NOT NULL)   # §8
  check  Result NOT IN ('COMPLIANT','WARNING','BREACH') OR (ActualValue IS NOT NULL AND ThresholdApplied IS NOT NULL AND OperatorApplied IS NOT NULL)   # الحكم بعتبة (BR-OBL-006)
  check  Result <> 'NOT_ASSESSED_NO_THRESHOLD' OR ThresholdApplied IS NULL   # BR-OBL-006
  check  ThresholdApplied IS NULL OR OperatorApplied IS NOT NULL
  check  Headroom IS NULL OR (ActualValue IS NOT NULL AND ThresholdApplied IS NOT NULL)
  check  HeadroomPct IS NULL OR Headroom IS NOT NULL
  check  Result NOT IN ('MANUAL_COMPLIANT','MANUAL_NON_COMPLIANT','UNDER_REVIEW') OR Method = 'MANUAL_STATUS'   # الوصفي (BR-OBL-008)
  check  Method <> 'MANUAL_STATUS' OR Result IS NULL OR Result IN ('MANUAL_COMPLIANT','MANUAL_NON_COMPLIANT','UNDER_REVIEW')

table obl.CovenantTestStatement pk=CovenantTestId,StatementId norv append  # The statements an automatic evaluation read: written by the database from the test's snapshot, never by the application, so the breach report and a restatement find them by key (FR-FIN-017, BR-FIN-015)
  CovenantTestId      ->obl.CovenantTest req
  StatementId         ->fin.FinancialStatement req
  StatementVersionNo  int        req   # الإصدار كما في اللقطة
  Basis               enum{STANDALONE,CONSOLIDATED} req
  index  StatementId include CovenantTestId   # الاختبارات التي قرأت قائمة: إعادة التقييم بعد إعادة العرض (FR-FIN-014)

table obl.ObligationBreach public  # Breach record, its remedy and any waiver (FR-OBL-012, BR-OBL-009/011, section 8)
  ObligationRootId      bigint     req   # RootId of the obligation: the breach register follows it across revisions (DR-28, self-review B1)
  ObligationId          ->obl.Obligation req via=ObligationRootId>RootId
  Kind                  enum{COVENANT_BREACH,LATE_REPORT,RESTRICTION_VIOLATION,OTHER} req
  CovenantRootId        bigint           # نسخة من الاختبار: جذر التعهد (B1)
  TestPeriodEnd         date             # نسخة من الاختبار: نهاية الفترة (B1)
  CovenantTestId        ->obl.CovenantTest via=CovenantRootId,TestPeriodEnd>PeriodEnd   # اتساق اختبار الخرق مع الالتزام يتحقق منه التطبيق
  ReportingInstanceId   ->obl.ReportingInstance
  DetectedOn            date       req
  Description           str(2000)
  Status                enum{OPEN,IN_CURE,CURED,WAIVED,CLOSED_NO_ACTION} req =OPEN
  CureDeadline          date             # DetectedOn + CureDays (BR-OBL-009)
  BankNotifiedOn        date
  WaiverRef             str(100)
  WaiverDate            date
  WaiverBankContactId   ->ins.Contact
  WaiverConditions      str(2000)
  WaiverValidUntil      date
  WaiverDocumentId      ->doc.Document
  WaiverApprovedBy      ->sec.AppUser    # اعتماد TM للتنازل؛ حقول التنازل تُسجَّل في OPEN وIN_CURE قبله (DQ-F15-9، B2)
  WaiverApprovedOn      ts
  ConsequenceApplied    str(1000)
  ResolvedOn            date
  NeedsReview           bool       req =0   # تعليم إعادة العرض لا يغيّر الحالة (BR-OBL-011)
  unique PublicId
  unique CovenantRootId,TestPeriodEnd where CovenantTestId IS NOT NULL AND Status IN ('OPEN','IN_CURE')   # خرق مفتوح واحد لكل تعهد وفترة، ولو أعيد التقييم: يُعلَّم القائم NeedsReview (DQ-F15-11، B1)
  unique ReportingInstanceId where ReportingInstanceId IS NOT NULL AND Status IN ('OPEN','IN_CURE')   # إضافة: منع تكرار خرق التأخير من المهمة الليلية
  index  ObligationRootId,Status include DetectedOn,Kind,NeedsReview   # سجل الخروقات عبر المراجعات ولوحة الامتثال (R-OBL-02/04)
  index  CureDeadline include ObligationId where Status IN ('OPEN','IN_CURE') AND CureDeadline IS NOT NULL   # إنذار قبل 7 أيام من نهاية العلاج (NTF-OBL-06)
  index  DetectedOn include ObligationId where NeedsReview = 1   # خروقات تحتاج مراجعة (BR-OBL-011)
  check  CovenantTestId IS NULL OR Kind = 'COVENANT_BREACH'
  check  (CovenantTestId IS NULL AND CovenantRootId IS NULL AND TestPeriodEnd IS NULL) OR (CovenantTestId IS NOT NULL AND CovenantRootId IS NOT NULL AND TestPeriodEnd IS NOT NULL)
  check  ReportingInstanceId IS NULL OR Kind = 'LATE_REPORT'
  check  CureDeadline IS NULL OR CureDeadline >= DetectedOn
  check  Status <> 'IN_CURE' OR CureDeadline IS NOT NULL
  check  Status NOT IN ('CURED','WAIVED','CLOSED_NO_ACTION') OR ResolvedOn IS NOT NULL
  check  Status IN ('CURED','WAIVED','CLOSED_NO_ACTION') OR ResolvedOn IS NULL
  check  ResolvedOn IS NULL OR ResolvedOn >= DetectedOn
  check  Status <> 'WAIVED' OR (WaiverRef IS NOT NULL AND WaiverDate IS NOT NULL AND WaiverBankContactId IS NOT NULL AND WaiverApprovedBy IS NOT NULL AND WaiverApprovedOn IS NOT NULL)   # BR-OBL-009، V-OBL-01، DQ-F15-9
  check  Status IN ('WAIVED','OPEN','IN_CURE') OR (WaiverRef IS NULL AND WaiverDate IS NULL AND WaiverBankContactId IS NULL AND WaiverConditions IS NULL AND WaiverValidUntil IS NULL AND WaiverDocumentId IS NULL)   # التنازل المنتظر يُسجَّل قبل اعتماده (DQ-F15-9)
  check  (WaiverApprovedBy IS NULL AND WaiverApprovedOn IS NULL) OR (Status = 'WAIVED' AND WaiverApprovedBy IS NOT NULL AND WaiverApprovedOn IS NOT NULL)   # الاعتماد هو الانتقال إلى WAIVED
  check  WaiverValidUntil IS NULL OR WaiverDate IS NULL OR WaiverValidUntil >= WaiverDate

# ============================== المخطط fin: البيانات المالية ==============================
module FIN

table fin.LineCatalogItem catalog int  # Standard statement line item; 51 items seeded, twelve of them for the credit assessment; system items used in formulas cannot be deleted (FR-FIN-001, FR-FIN-020, CatalogBase)
  Section      enum{BS_ASSET,BS_LIABILITY,BS_EQUITY,IS,CF,MEMO} req   # MEMO: بند إفصاح خارج الميزانية لا يدخل إجمالياتها (الالتزامات المحتملة، FR-FIN-020)
  IsTotal      bool       req =0   # إجمالي محسوب من رموز مكوّناته (BR-FIN-001)
  TotalFormula str(500)            # مثل GROSS_PROFIT - OPEX؛ نحو الإجماليات البسيط
  IsRequired   bool       req =0   # الفارغ منه يمنع التقديم (BR-FIN-002)
  index  Section,SortOrder
  check  IsTotal = 0 OR TotalFormula IS NOT NULL
  check  IsTotal = 1 OR TotalFormula IS NULL
  check  NameEn IS NOT NULL                              # NameEn إلزامي في هذا الكتالوج (§6.5)
  check  Code COLLATE Arabic_100_BIN2 NOT LIKE '%[^A-Z0-9_]%' AND Code NOT LIKE '[0-9_]%'   # BR-CAT-001
  check  IsLocked = 0 OR (IsSystem = 1 AND IsActive = 1)   # BR-CAT-003

table fin.LineCatalogItemAlias int deletable  # Alternative names (aliases) for a line item, used for paste and matching -- جدول جديد للأسماء البديلة (FR-FIN-003)
  LineCatalogItemId  ->fin.LineCatalogItem req
  Alias              str(200)   req
  unique Alias                             # الاسم البديل يطابق بندًا واحدًا
  check  Alias <> ''                       # T-SQL يعدّ الفراغات الطرفية مساوية للفارغ

table fin.FinancialStatement public  # Financial statement header; highly confidential (FR-FIN-002/005/006, BR-FIN-001..004, section 8)
  CompanyId         ->org.Company req
  PeriodType        enum{ANNUAL,SEMIANNUAL,QUARTERLY,MONTHLY} req
  PeriodStart       date
  PeriodEnd         date       req
  FiscalYear        int        req
  Basis             enum{STANDALONE,CONSOLIDATED} req
  Assurance         enum{AUDITED,REVIEWED,MANAGEMENT} req
  Nature            enum{ACTUAL,BUDGET} req =ACTUAL   # BUDGET: قائمة تقديرية (موازنة أو خطة) تُقيَّم تقييمًا تجريبيًا وتبقى مسودة (ADR 0025)
  CurrencyId        ->ref.Currency req
  UnitScale         int        req =1   # المدخل بوحدة 1/1000/1000000 والمخزَّن مضروب فيها (BR-FIN-002)
  AccountingStandard str(100)
  AuditorName       str(200)         # مراجع الحسابات للقائمة المدققة أو المراجَعة (وحدة الميزانية، 2026-10-18)
  AuditOpinion      enum{UNQUALIFIED,QUALIFIED,ADVERSE,DISCLAIMER}   # رأي المراجع للقائمة المدققة
  GoingConcernUncertainty bool req =0   # فقرة شك جوهري في الاستمرارية في تقرير المراجع (التقييم الائتماني، docs/35 §7)
  VersionNo         int        req =1
  VersionReason     enum{ORIGINAL,RESTATED,CORRECTION,RESTRUCTURED} req =ORIGINAL   # سبب الإصدار إلزامي (BR-FIN-004)؛ RESTRUCTURED: نسخة عرض اختارتها الشركة (ADR 0023)
  SupersedesId      ->fin.FinancialStatement via=CompanyId,Basis,Assurance,PeriodType,PeriodEnd,Nature   # الإصدار السابق للشركة والسلسلة نفسها؛ المدققة لا تحل محل الإدارية (قرار المالك 2026-10-13، DR-34)
  Status            enum{DRAFT,SUBMITTED,APPROVED,SUPERSEDED,REJECTED} req =DRAFT
  EntryMethod       enum{MANUAL,PASTE} req
  BalanceReason     str(500)         # سبب عدم التوازن للتقديم؛ BalanceDifference مشتق (FR-FIN-004)
  SourceDocumentId  ->doc.Document
  PreparedBy        ->sec.AppUser
  PreparedOn        ts
  ApprovedBy        ->sec.AppUser
  ApprovedOn        ts
  unique PublicId
  unique CompanyId,PeriodType,PeriodEnd,Basis,Assurance,Nature,VersionNo   # تكرار (شركة، فترة، أساس، تأكيد، طبيعة، إصدار) مرفوض (FR-FIN-002)؛ للموازنة سلسلتها
  unique CompanyId,Basis,Assurance,PeriodType,PeriodEnd where Status = 'APPROVED'   # معتمد واحد: الأحدث يُسقط السابق (BR-FIN-004)
  unique SupersedesId where SupersedesId IS NOT NULL AND Status <> 'REJECTED'   # خلف حي واحد لكل إصدار (DR-34)
  index  CompanyId,Basis,PeriodEnd include Assurance,VersionNo,PeriodType,FiscalYear where Status = 'APPROVED'   # اختيار القائمة لاختبار (BR-FIN-003)
  index  CompanyId,FiscalYear,PeriodType include Status   # قائمة الإصدارات والمقارنة بين الفترات (R-FIN-01)
  index  Status,CompanyId include PeriodEnd where Status = 'SUBMITTED'   # بانتظار الاعتماد (NTF-FIN-02)
  check  UnitScale IN (1,1000,1000000)
  check  PeriodStart IS NULL OR PeriodEnd >= PeriodStart
  check  FiscalYear BETWEEN 1900 AND 2200
  check  VersionNo >= 1
  check  VersionReason <> 'ORIGINAL' OR SupersedesId IS NULL
  check  SupersedesId IS NULL OR (VersionNo > 1 AND VersionReason <> 'ORIGINAL' AND SupersedesId <> FinancialStatementId)
  check  Status NOT IN ('SUBMITTED','APPROVED','SUPERSEDED') OR (PreparedBy IS NOT NULL AND PreparedOn IS NOT NULL)
  check  Status NOT IN ('APPROVED','SUPERSEDED') OR (ApprovedBy IS NOT NULL AND ApprovedOn IS NOT NULL)   # §8
  check  ApprovedBy IS NULL OR PreparedBy IS NULL OR ApprovedBy <> PreparedBy   # المُعِدّ ≠ المعتمِد (FR-FIN-006)
  check  Status = 'DRAFT' OR Assurance <> 'AUDITED' OR (AuditorName IS NOT NULL AND AuditOpinion IS NOT NULL)   # المدققة تُقدَّم بمراجعها ورأيه (BR-FIN-012)
  check  AuditOpinion IS NULL OR Assurance = 'AUDITED'
  check  GoingConcernUncertainty = 0 OR Assurance IN ('AUDITED','REVIEWED')
  check  Nature = 'ACTUAL' OR (Assurance = 'MANAGEMENT' AND Status = 'DRAFT' AND AuditOpinion IS NULL)   # الموازنة إعداد الإدارة، مسودة لا تُقدَّم ولا تُعتمد (BR-FIN-039)

table fin.StatementLine  # Statement line in the header currency; stored value = input x UnitScale; Variance is derived; highly confidential (BR-FIN-001/002)
  StatementId        ->fin.FinancialStatement req
  LineCatalogItemId  ->fin.LineCatalogItem req
  EnteredAmount      money      sens=confidential   # الخانة الفارغة لغير الإلزامي تُحفظ صفرًا صريحًا عند التقديم (BR-FIN-002)
  ComputedAmount     money      sens=confidential   # للإجماليات
  unique StatementId,LineCatalogItemId

table fin.ConsolidationMember  # A unit of a holding's consolidated statement: the parent, each subsidiary, associate and joint venture, with its method and ownership (FR-FIN-015, BR-FIN-013; owner request 2026-10-18)
  StatementBasis    enum{CONSOLIDATED} req =CONSOLIDATED   # ثابت: الوحدات للقائمة الموحدة وحدها
  StatementId       ->fin.FinancialStatement req via=StatementBasis>Basis
  MemberCompanyId   ->org.Company req   # الوحدة شركة من شركات المشترك؛ القابضة نفسها PARENT
  Role              enum{PARENT,SUBSIDIARY,ASSOCIATE,JOINT_VENTURE} req
  Method            enum{FULL,EQUITY,PROPORTIONATE,NOT_CONSOLIDATED} req
  OwnershipPct      rate             # نسبة الملكية الفعلية في نهاية الفترة؛ فارغة للقابضة
  IncludedFrom      date             # دخول الوحدة خلال الفترة (استحواذ)
  IncludedTo        date             # خروجها خلال الفترة (تخارج)
  MemberStatementId ->fin.FinancialStatement via=MemberCompanyId>CompanyId   # القائمة المنفردة للوحدة للفترة نفسها، إن أُدخلت
  Note              str(500)
  unique StatementId,MemberCompanyId
  unique StatementId where Role = 'PARENT'   # قابضة واحدة لكل قائمة موحدة
  index  MemberCompanyId include StatementId,Role,Method   # القوائم الموحدة التي تدخلها الشركة
  check  OwnershipPct IS NULL OR (OwnershipPct > 0 AND OwnershipPct <= 100)
  check  (Role = 'PARENT' AND Method = 'FULL' AND OwnershipPct IS NULL) OR (Role <> 'PARENT' AND OwnershipPct IS NOT NULL)
  check  Role <> 'SUBSIDIARY' OR Method IN ('FULL','NOT_CONSOLIDATED')
  check  Role <> 'ASSOCIATE' OR Method IN ('EQUITY','NOT_CONSOLIDATED')
  check  Role <> 'JOINT_VENTURE' OR Method IN ('EQUITY','PROPORTIONATE','NOT_CONSOLIDATED')
  check  IncludedTo IS NULL OR IncludedFrom IS NULL OR IncludedTo >= IncludedFrom
  check  MemberStatementId IS NULL OR Role <> 'PARENT'   # قائمة القابضة المنفردة لا تحل محل الموحدة

table fin.StatementRatio  # An analysis measure computed on an approved statement, for the study of the balance sheet; written by the engine (FR-FIN-016, BR-FIN-014)
  StatementId     ->fin.FinancialStatement req
  FormulaId       ->fin.MeasureFormula req
  ResultUnit      enum{RATIO,AMOUNT,PERCENT,DAYS} req   # وحدة الصيغة وقت الحساب
  Status          enum{COMPUTED,NOT_COMPUTABLE} req
  Value           dec(19,6)        # فارغ إن لم تُحسب (قسمة على صفر، بند ناقص)
  Reason          str(300)         # سبب NOT_COMPUTABLE
  InputsSnapshot  json       req   # البنود والإصدار المستعمَلان (على غرار BR-FIN-010)
  ComputedAt      ts         req =SYSUTCDATETIME()
  unique StatementId,FormulaId
  index  FormulaId include StatementId,Value,Status   # مقارنة المقياس بين الشركات والفترات (R-FIN-05)
  check  (Status = 'COMPUTED' AND Value IS NOT NULL AND Reason IS NULL) OR (Status = 'NOT_COMPUTABLE' AND Value IS NULL AND Reason IS NOT NULL)

table fin.RevenueEstimate public  # Manual revenue estimate for a fiscal year, used by a revenue-share covenant with RevenueBasisRule MANUAL_ESTIMATE (Q-FIN-05, BR-FIN-008, self-review B4)
  CompanyId     ->org.Company req
  FiscalYear    int        req
  Basis         enum{STANDALONE,CONSOLIDATED} req
  Amount        money      req
  CurrencyId    ->ref.Currency req
  BasisNote     str(500)   req   # مصدر التقدير (موازنة معتمدة، توقع الإدارة...)
  DocumentId    ->doc.Document
  Status        enum{DRAFT,APPROVED,SUPERSEDED} req =DRAFT
  PreparedBy    ->sec.AppUser
  ApprovedBy    ->sec.AppUser
  ApprovedOn    ts
  unique PublicId
  unique CompanyId,FiscalYear,Basis where Status = 'APPROVED'   # تقدير معتمد واحد لكل سنة وأساس
  check  Amount > 0
  check  FiscalYear BETWEEN 1900 AND 2200
  check  Status = 'DRAFT' OR (ApprovedBy IS NOT NULL AND ApprovedOn IS NOT NULL)
  check  ApprovedBy IS NULL OR PreparedBy IS NULL OR ApprovedBy <> PreparedBy
  check  Status = 'DRAFT' OR PreparedBy IS NOT NULL   # المعتمد له مُعِدّ (058، ADR 0037)

table fin.AccountMonthlyStat public  # Monthly balance of an account in the account currency (FR-FIN-008, BR-FIN-005/006, V-FIN-02)
  BankAccountId     ->acc.BankAccount req
  MonthEnd          date       req   # نهاية الشهر؛ الشهر المستقبلي وخارج OpenedOn..ClosedOn يمنعه التطبيق
  AvgDailyBalance   money      req
  MinBalance        money
  EndBalance        money
  SourceKind        enum{BANK_STATEMENT,BANK_NOTICE,INTERNAL_CALC} req
  SourceRef         str(100)
  DocumentId        ->doc.Document
  Note              str(500)
  Status            enum{DRAFT,CONFIRMED} req =DRAFT   # المؤكَّد لا يتغير ولا يُحذف إلا بإعادة فتح (ADR 0030)
  EnteredBy         ->sec.AppUser noidx
  ConfirmedBy       ->sec.AppUser noidx
  ConfirmedOn       ts
  ReopenCount       int        req =0   # مرات إعادة فتح المؤكَّد: يعيده مسودة بسبب، بيد غير المُدخِل (052، ADR 0030)
  LastReopenedBy    ->sec.AppUser noidx
  LastReopenedOn    ts
  LastReopenReason  str(500)
  unique PublicId
  unique BankAccountId,MonthEnd
  check  DAY(DATEADD(DAY, 1, MonthEnd)) = 1   # نهاية الشهر فعلًا (DR-37)
  index  MonthEnd,Status include BankAccountId   # مصفوفة الأرصدة ونقص الشهر السابق (R-FIN-02، NTF-FIN-01)
  check  (Status = 'DRAFT' AND ConfirmedBy IS NULL AND ConfirmedOn IS NULL) OR (Status = 'CONFIRMED' AND ConfirmedBy IS NOT NULL AND ConfirmedOn IS NOT NULL)
  check  ConfirmedBy IS NULL OR EnteredBy IS NULL OR ConfirmedBy <> EnteredBy   # المُدخِل ≠ المؤكِّد
  check  ReopenCount >= 0 AND (ReopenCount = 0 OR (LastReopenedBy IS NOT NULL AND LastReopenedOn IS NOT NULL AND LastReopenReason IS NOT NULL))
  check  LastReopenedBy IS NULL OR EnteredBy IS NULL OR LastReopenedBy <> EnteredBy   # يعيد فتحه غير المُدخِل
  check  ConfirmedBy IS NULL OR LastReopenedBy IS NULL OR ConfirmedBy <> LastReopenedBy   # يؤكده بعد إعادة الفتح غير من أعاد فتحه (ADR 0037)
  check  Status <> 'CONFIRMED' OR EnteredBy IS NOT NULL   # المؤكَّد له مُدخِل يختمه الإدخال بالمستخدم المربوط (058، ADR 0037)

table fin.BankFlowEntry public  # Amount transferred to the bank in a month; annual totals are computed automatically (FR-FIN-009/010, BR-FIN-007/008)
  CompanyId     ->org.Company req
  InstitutionId ->ins.Institution req
  FacilityId    ->fac.Facility
  MonthEnd      date       req
  FlowKindListCode ascii(80) req =FLOW_KIND   # ثابت: البند من قائمة FLOW_KIND وحدها (المراجعة الذاتية B7f)
  FlowKindListId ->cat.LookupList req via=FlowKindListCode>Code noidx
  FlowKindId    ->cat.LookupItem req via=FlowKindListId>LookupListId   # الافتراضي التطبيقي TRANSFERRED_TO_BANK
  Amount        money      req
  CurrencyId    ->ref.Currency req
  BasisNote     str(500)         # أساس الاحتساب بنص حر (03 §3.3)
  DocumentId    ->doc.Document
  Status        enum{DRAFT,CONFIRMED} req =DRAFT   # المؤكَّد وحده يقيس الأداء (FR-FIN-018)
  EnteredBy     ->sec.AppUser
  ConfirmedBy   ->sec.AppUser
  ConfirmedOn   ts
  ReopenCount       int        req =0   # مرات إعادة فتح المؤكَّد: يعيده مسودة بسبب، بيد غير المُدخِل (052، ADR 0030)
  LastReopenedBy    ->sec.AppUser noidx
  LastReopenedOn    ts
  LastReopenReason  str(500)
  unique PublicId
  unique CompanyId,InstitutionId,FacilityId,MonthEnd,FlowKindId   # تكرار (شركة، بنك، تسهيل، شهر) مرفوض (FR-FIN-009)
  check  DAY(DATEADD(DAY, 1, MonthEnd)) = 1   # نهاية الشهر فعلًا (DR-37)
  index  CompanyId,MonthEnd include InstitutionId,FacilityId,Amount,CurrencyId   # التجميع السنوي والإنجاز (R-FIN-03)
  check  Amount >= 0
  check  FlowKindListCode = 'FLOW_KIND'
  check  (Status = 'DRAFT' AND ConfirmedBy IS NULL AND ConfirmedOn IS NULL) OR (Status = 'CONFIRMED' AND ConfirmedBy IS NOT NULL AND ConfirmedOn IS NOT NULL)
  check  ConfirmedBy IS NULL OR EnteredBy IS NULL OR ConfirmedBy <> EnteredBy   # المُدخِل ≠ المؤكِّد
  check  ReopenCount >= 0 AND (ReopenCount = 0 OR (LastReopenedBy IS NOT NULL AND LastReopenedOn IS NOT NULL AND LastReopenReason IS NOT NULL))
  check  LastReopenedBy IS NULL OR EnteredBy IS NULL OR LastReopenedBy <> EnteredBy   # يعيد فتحه غير المُدخِل
  check  ConfirmedBy IS NULL OR LastReopenedBy IS NULL OR ConfirmedBy <> LastReopenedBy   # يؤكده بعد إعادة الفتح غير من أعاد فتحه (ADR 0037)
  check  Status <> 'CONFIRMED' OR EnteredBy IS NOT NULL   # المؤكَّد له مُدخِل يختمه الإدخال بالمستخدم المربوط (058، ADR 0037)

table fin.MeasureFormula src  # Measure formula: a template or a facility-agreement version with revisions; never executed as text (FR-FIN-011, BR-FIN-009, section 12)
  Code            ascii(60)  req
  NameAr          str(200)   req
  NameEn          str(200)
  Scope           enum{TEMPLATE,FACILITY_COPY,ANALYSIS} req   # ANALYSIS: مقياس لدراسة الميزانية لا لتعهد (FR-FIN-016)
  FacilityId      ->fac.Facility          # لنسخة الاتفاقية فقط؛ فارغ للقالب
  BaseTemplateId  ->fin.MeasureFormula    # القالب المنسوخ منه؛ كونه TEMPLATE يتحقق منه التطبيق
  Expression      str(2000)  req          # نحو مقيَّد يُحلَّل إلى شجرة (BR-FIN-009)
  InputKinds      set{STATEMENT,ACCOUNT_STATS,BANK_FLOWS} req
  ResultUnit      enum{RATIO,AMOUNT,PERCENT,DAYS} req   # على غرار Covenant.ThresholdUnit (المواصفة لا تعدّد القيم)؛ وحدة صيغة مستعملة لا تتغير (DR-38)
  calc UsesStatements bool =CAST(CASE WHEN InputKinds LIKE '%STATEMENT%' THEN 1 ELSE 0 END AS BIT)   # تقرأ القوائم المالية (DR-38)
  DefinitionNote  str(1000)               # مثل: هل يشمل الدين التزامات الإيجار
  VersionNo       int        req =1
  Status          enum{DRAFT,APPROVED,SUPERSEDED} req =DRAFT
  ApprovedBy      ->sec.AppUser
  ApprovedOn      ts
  unique Code,FacilityId,VersionNo                         # فريد (Tenant,Code,Facility,VersionNo)
  unique Code,FacilityId where Status = 'APPROVED'         # معتمد واحد لكل (رمز، اتفاقية)؛ التعديل إصدار جديد
  index  FacilityId,Status include Code,VersionNo          # نسخ اتفاقية في مكتبة الصيغ (SCR-FIN-03)
  check  Scope = 'FACILITY_COPY' OR FacilityId IS NULL
  check  ResultUnit <> 'DAYS' OR Scope = 'ANALYSIS'   # أيام الدوران للتحليل وحده
  check  Scope <> 'FACILITY_COPY' OR FacilityId IS NOT NULL
  check  Scope = 'FACILITY_COPY' OR BaseTemplateId IS NULL
  check  BaseTemplateId IS NULL OR BaseTemplateId <> MeasureFormulaId
  check  InputKinds <> ''
  check  VersionNo >= 1
  check  Code COLLATE Arabic_100_BIN2 NOT LIKE '%[^A-Z0-9_]%'
  check  Status NOT IN ('APPROVED','SUPERSEDED') OR (ApprovedBy IS NOT NULL AND ApprovedOn IS NOT NULL)
  check  SourceDocumentId IS NOT NULL AND SourcePage IS NOT NULL OR (SourceDocumentId IS NULL AND Confidence = 'ENTERED_NO_DOCUMENT')   # ختم المصدر (X-DAT-4)
  check  Confidence <> 'CONFIRMED_AGAINST_ORIGINAL' OR (VerifiedBy IS NOT NULL AND VerifiedOn IS NOT NULL)

# ---------- التقييم الائتماني على سلّم موديز (طلب المالك 2026-10-18، docs/35، ADR 0017) ----------
# المنهجية عالمية تملكها المنصة وتبذرها (db/seed/104 من tools/dbgen/credit_scorecard.json)؛ والتقييم مملوك للمشترك.

table fin.RatingGrade int global  # The 21 grades of the Moody's long-term scale, their range on the scorecard continuum and their risk band (docs/35 section 2, BR-FIN-018)
  Code              ascii(4)  req   # Aaa, Aa1 ... Ca, C
  NotchNo           tinyint   req   # 1 = Aaa ... 20 = Ca, 21 = C
  Category          ascii(3)  req   # Aaa, Aa, A, Baa, Ba, B, Caa, Ca, C
  ScoreFrom         dec(5,2)        # المجال على الخط المستمر؛ فارغ لـ C التي لا تبلغها البطاقة بالحساب
  ScoreTo           dec(5,2)
  RiskBand          enum{LOW,MODERATE,SUBSTANTIAL,HIGH,VERY_HIGH} req
  IsInvestmentGrade bool      req =0   # Baa3 فما فوق
  FitchEquivalent   ascii(4)  req      # المقابل في سلّم فيتش طويل الأجل (AAA ... C)
  DescriptionAr     str(300)  req
  DescriptionEn     str(300)  req
  unique Code
  unique NotchNo
  check  NotchNo BETWEEN 1 AND 21
  check  (ScoreFrom IS NULL AND ScoreTo IS NULL AND NotchNo = 21) OR (ScoreFrom IS NOT NULL AND ScoreTo IS NOT NULL AND ScoreTo > ScoreFrom AND NotchNo < 21)
  check  IsInvestmentGrade = 0 OR NotchNo <= 10

table fin.CreditMetric int global  # The metric dictionary of the credit assessment: how each ratio is computed from the statement lines, its unit and direction, and the texts of its strength and weakness (docs/35 section 4)
  Code              ascii(40) req
  NameAr            str(200)  req
  NameEn            str(200)  req
  Kind              enum{QUANTITATIVE,QUALITATIVE} req   # النوعي يدخله المحلل بدرجة ومبرّر
  Unit              enum{RATIO,PERCENT,DAYS,AMOUNT,MONTHS,YEARS,GRADE} req
  Direction         enum{HIGHER_BETTER,LOWER_BETTER,NONE} req
  DefinitionAr      str(1000) req   # الصيغة من رموز البنود والحالات الحدية؛ يحسبها 046 بالكميات المسمّاة، لا نصًا منفَّذًا
  InputsText        str(500)
  Pattern           enum{RATIO,AMOUNT,DIFF,GROWTH,VALUE}   # طريقة الحساب من البسط والمقام (docs/35 §4)؛ VALUE تحسبها خطوة القيم الخاصة؛ فارغ للنوعي
  NumQty            ascii(40)        # الكمية المسمّاة في البسط
  DenQty            ascii(40)        # وفي المقام
  Scale             dec(9,2)         # 100 للنسبة المئوية، 365 للأيام، 12 للأشهر، 1 للمرات
  IfNumZero         enum{NONE,VALUE0,BEST,BEST_IF_DEN_POS,WORST}   # بسط صفري
  IfDenZero         enum{NA,BEST,WORST,BEST_IF_NUM_POS,BEST_IF_NUM_NONNEG} # مقام صفري
  IfDenNeg          enum{COMPUTE,WORST,NA}                    # مقام سالب
  IfNumNeg          enum{COMPUTE,WORST,NA,BEST_IF_DEN_POS} # بسط سالب (وللمبلغ: غير موجب)
  ThemeCode         ascii(30)        # محور التقرير: الحجم والسوق، نوع المبيعات، النقد، السيولة، الذمم، المخزون...
  CashEffectAr      str(500)         # أثره على النقد
  CashEffectEn      str(500)
  SolvencyEffectAr  str(500)         # أثره على الملاءة
  SolvencyEffectEn  str(500)
  StrengthTextAr    str(500)  req   # {v} القيمة و{g} الدرجة
  StrengthTextEn    str(500)  req
  WeaknessTextAr    str(500)  req
  WeaknessTextEn    str(500)  req
  unique Code
  check  (Kind = 'QUALITATIVE' AND Unit = 'GRADE' AND Direction = 'NONE') OR (Kind = 'QUANTITATIVE' AND Unit <> 'GRADE' AND Direction <> 'NONE')
  check  Code COLLATE Arabic_100_BIN2 NOT LIKE '%[^A-Z0-9_]%'
  check  (Kind = 'QUALITATIVE' AND Pattern IS NULL AND NumQty IS NULL) OR (Kind = 'QUANTITATIVE' AND Pattern = 'VALUE' AND NumQty IS NULL AND DenQty IS NULL) OR (Kind = 'QUANTITATIVE' AND Pattern <> 'VALUE' AND NumQty IS NOT NULL AND (Pattern = 'AMOUNT' OR DenQty IS NOT NULL))
  check  Pattern IS NULL OR Pattern <> 'RATIO' OR (Scale IS NOT NULL AND IfNumZero IS NOT NULL AND IfDenZero IS NOT NULL AND IfDenNeg IS NOT NULL AND IfNumNeg IS NOT NULL)

table fin.Scorecard int global  # A sector scorecard of the credit assessment and its version; approved, it never changes and a change is a new version (docs/35 section 5, BR-FIN-023)
  Code              ascii(40) req
  VersionNo         int       req =1
  NameAr            str(200)  req
  NameEn            str(200)  req
  SectorNoteAr      str(500)
  CurrencyId        ->ref.Currency req   # عملة حدود الحجم
  AmountUnit        int       req =1000000   # وحدة حدود الحجم (مليون)
  MinCoveragePct    dec(5,2)  req =85        # أدنى وزن محسوب من المقاييس الكمية لإعطاء درجة (BR-FIN-019)
  QualitativeBoundNotches tinyint req =3   # بُعد الدرجة النوعية الأقصى عن الدرجة المالية بلا مستند (BR-FIN-021)
  SupportMaxAgeMonths tinyint req =12      # أقصى عمر لتقييم الأم في دعم المجموعة (BR-FIN-022)
  Status            enum{DRAFT,APPROVED,RETIRED} req =DRAFT
  EffectiveFrom     date
  DisclaimerAr      str(1000) req
  DisclaimerEn      str(1000) req
  unique Code,VersionNo
  unique Code where Status = 'APPROVED'   # إصدار معتمد واحد لكل بطاقة
  check  VersionNo >= 1
  check  AmountUnit IN (1,1000,1000000)
  check  MinCoveragePct > 0 AND MinCoveragePct <= 100
  check  QualitativeBoundNotches BETWEEN 1 AND 20
  check  SupportMaxAgeMonths BETWEEN 1 AND 36
  check  Status = 'DRAFT' OR EffectiveFrom IS NOT NULL
  check  Code COLLATE Arabic_100_BIN2 NOT LIKE '%[^A-Z0-9_]%'

table fin.ScorecardMetric int global  # A metric of a scorecard: its factor, its weight and the nine boundaries of its grid (best cap, Aaa|Aa, Aa|A, A|Baa, Baa|Ba, Ba|B, B|Caa, Caa|Ca, worst cap); a qualitative metric has no grid (docs/35 section 5)
  ScorecardId       ->fin.Scorecard req
  MetricId          ->fin.CreditMetric req
  FactorCode        enum{SCALE,BUSINESS_PROFILE,PROFITABILITY_EFFICIENCY,LEVERAGE_COVERAGE,CAPITAL_SOLVENCY,LIQUIDITY_FUNDING,BALANCE_SHEET_QUALITY,FINANCIAL_POLICY} req   # عوامل موديز الثمانية (docs/35 §5)
  Weight            dec(5,2)  req
  B0                dec(19,6)   # القيمة التي تساوي 0.5 أو أفضل منها
  B1                dec(19,6)   # 1.5: حد Aaa|Aa
  B2                dec(19,6)   # 4.5: حد Aa|A
  B3                dec(19,6)   # 7.5: حد A|Baa
  B4                dec(19,6)   # 10.5: حد Baa|Ba
  B5                dec(19,6)   # 13.5: حد Ba|B
  B6                dec(19,6)   # 16.5: حد B|Caa
  B7                dec(19,6)   # 19.5: حد Caa|Ca
  B8                dec(19,6)   # القيمة التي تساوي 20.5 أو أسوأ منها
  SortOrder         int       req =0
  unique ScorecardId,MetricId
  check  Weight > 0 AND Weight <= 100
  check  (B0 IS NULL AND B1 IS NULL AND B2 IS NULL AND B3 IS NULL AND B4 IS NULL AND B5 IS NULL AND B6 IS NULL AND B7 IS NULL AND B8 IS NULL) OR (B0 IS NOT NULL AND B1 IS NOT NULL AND B2 IS NOT NULL AND B3 IS NOT NULL AND B4 IS NOT NULL AND B5 IS NOT NULL AND B6 IS NOT NULL AND B7 IS NOT NULL AND B8 IS NOT NULL AND ((B0 < B1 AND B1 < B2 AND B2 < B3 AND B3 < B4 AND B4 < B5 AND B5 < B6 AND B6 < B7 AND B7 < B8) OR (B0 > B1 AND B1 > B2 AND B2 > B3 AND B3 > B4 AND B4 > B5 AND B5 > B6 AND B6 > B7 AND B7 > B8)))   # شبكة كاملة رتيبة أو لا شبكة

table fin.ScorecardItemRule int global  # A balance-sheet item rule of a scorecard: the item, its metric and the thresholds of LOW, MODERATE, ELEVATED, HIGH and CRITICAL; a value on a threshold belongs to the worse level (docs/35 section 6)
  ScorecardId       ->fin.Scorecard req
  MetricId          ->fin.CreditMetric req
  LineCode          ascii(40) req   # بند الميزانية الذي يُنسب إليه الخطر
  T1                dec(19,6) req
  T2                dec(19,6) req
  T3                dec(19,6) req
  T4                dec(19,6) req
  ReportStrength    bool      req =0   # LOW يُذكر نقطة قوة
  SortOrder         int       req =0
  unique ScorecardId,MetricId,LineCode   # مقياس واحد قد يُقرأ على أكثر من بند
  check  (T1 < T2 AND T2 < T3 AND T3 < T4) OR (T1 > T2 AND T2 > T3 AND T3 > T4)

table fin.ScorecardAdjustment int global  # An adjustment of a scorecard: notches down, a standalone cap or an absolute cap on the best grade, applied in that order around group support and the override (docs/35 section 7)
  ScorecardId       ->fin.Scorecard req
  RuleCode          ascii(40) req   # منطق كل قاعدة في 047 برمزها؛ الرمز غير المعروف لا يُطبق (docs/35 §8)
  Stage             enum{NOTCH,STANDALONE,ABSOLUTE} req   # تنزيل، ثم سقف منفرد قبل الدعم، ثم سقف مطلق بعد التجاوز
  Notches           int       req =0   # درجات التنزيل، سالبة؛ صفر للسقف
  CapGradeId        ->fin.RatingGrade noidx   # أفضل درجة مسموحة بعد القاعدة
  ParamValue        dec(19,6)         # المعامل: أشهر القِدم، النسبة، الإيراد بالملايين
  ShowWhen          enum{ALWAYS,WHEN_BINDING} req =ALWAYS   # يُذكر السقف دائمًا أو حين يغيّر الدرجة
  IsActive          bool      req =1
  NameAr            str(200)  req
  TextAr            str(500)  req   # {p} المعامل
  TextEn            str(500)  req
  unique ScorecardId,RuleCode
  check  Notches BETWEEN -3 AND 0
  check  (Stage = 'NOTCH' AND CapGradeId IS NULL AND Notches <= 0) OR (Stage <> 'NOTCH' AND CapGradeId IS NOT NULL AND Notches = 0)   # التنزيل الصفري نقطة مراقبة تُذكر ولا تغيّر الدرجة
  check  RuleCode COLLATE Arabic_100_BIN2 NOT LIKE '%[^A-Z0-9_]%'
  check  RuleCode NOT IN ('STALE_STATEMENT','RESTATEMENT','HALF_CAPITAL_LOST','HALF_CAPITAL_LOST_CURED','RELATED_PARTY_EXPOSURE','FLOW_SHORTFALL','SIZE_CEILING') OR ParamValue IS NOT NULL

# ---------- التقييم الائتماني v2: البنود والتبويب التحليلي والحلول (طلب المالك 2026-10-19، docs/35 v2، ADR 0018) ----------

table fin.IndustryProfile int global  # The credit profile of an activity or a division: its sector family scorecard, industry risk, cyclicality, its ceiling, the extra data it must give and the products it usually sells; the expected grade range comes from the country and industry risk anchor (docs/35 section 13, ADR 0019)
  IndustryId        ->ref.Industry req
  DefaultScorecardCode ascii(40) req   # بطاقة عائلة القطاع (ADR 0019)
  IndustryRisk      tinyint   req      # 1 منخفضة جدًا ... 6 مرتفعة جدًا
  Cyclicality       enum{LOW,MEDIUM,HIGH} req
  CeilingGradeId    ->fin.RatingGrade noidx   # سقف النشاط إن وُجد
  ExtraDisclosures  ascii(400)          # رموز الإفصاحات الإضافية للقطاع مفصولة بفواصل
  ProductCategories ascii(400) req      # فئات المنتجات المعتادة للنشاط مفصولة بفواصل؛ تُقرأ حين لا تُدخل الشركة خطوط منتجاتها
  NoteAr            str(1000)
  NoteEn            str(1000)
  unique IndustryId
  check  IndustryRisk BETWEEN 1 AND 6

table fin.ShockDriver int global  # A driver of stress: private demand, government spending, real estate, conflict, oil, credit, imports and currency; its effect at full intensity on revenue, gross margin and collection days (docs/35 section 14, ADR 0019)
  Code              ascii(20) req
  NameAr            str(200)  req
  NameEn            str(200)  req
  RevenuePct        dec(9,4)  req      # فقد الإيرادات عند الشدة الكاملة والحساسية 5 والتعرض 1
  GrossMarginPp     dec(9,4)  req      # نقاط هامش مجمل الربح
  DsoDays           dec(9,2)  req      # أيام تحصيل إضافية
  SortOrder         int       req
  unique Code
  check  Code COLLATE Arabic_100_BIN2 NOT LIKE '%[^A-Z0-9_]%'
  check  RevenuePct >= 0 AND GrossMarginPp >= 0 AND DsoDays >= 0

table fin.MacroScenario int global  # A macro stress scenario: the stagnant market, the financial crisis, a fiscal squeeze, a real estate correction, a regional conflict, an oil price collapse, the Gulf conflict on the shipping routes; the intensity of each driver and the financial conditions (docs/35 section 14, ADR 0019)
  Code              ascii(30) req
  NameAr            str(200)  req
  NameEn            str(200)  req
  DescriptionAr     str(1000) req
  DescriptionEn     str(1000) req
  InventorySeverity enum{STAGNANT,CRISIS} req   # أي قيمة بيع للمخزون من فئات المنتجات
  StLinesWithdrawnPct dec(9,4) req     # تخفيض الخطوط قصيرة الأجل غير الملتزمة عند تجديدها، قبل عامل البنك
  RateBp            int       req      # ارتفاع سعر الفائدة على الدين المتغير
  PrivateArLossPct  dec(9,4)  req      # خسارة الذمم الخاصة فوق 180 يومًا قبل أثر الطلب
  BaseDsoDays       dec(9,2)  req
  IsResilienceBase  bool      req =0   # السيناريو الذي يقيس الصمود والنظرة (ركود السوق)
  UndrawnAvailablePct dec(9,4) req =100  # ما يبقى متاحًا من الحدود الملتزمة غير المسحوبة (0: توقفها البنوك)، قبل الإيقاف بعامل البنك
  UndrawnCutPct     dec(9,4)  req =0    # ما توقفه البنوك من الحدود غير المسحوبة، مضروبًا في عامل البنك (مخاطر القطاع والبلد)
  LenderMarginBp    int       req =0    # زيادة هامش البنك على التسهيلات قصيرة الأجل والقبولات عند تجديدها، مضروبة في عامل البنك
  LenderFeesBp      int       req =0    # الرسوم الإدارية الإضافية على التسهيلات قصيرة الأجل والقبولات، مضروبة في عامل البنك
  DurationMonths    int       req =12   # مدة الأثر بالأشهر (للعرض)
  OtherCountryMult  dec(5,3)  req =1    # مضاعف الضغط لبلد ليس له صف في fin.MacroScenarioCountry
  SortOrder         int       req
  unique Code
  unique IsResilienceBase where IsResilienceBase = 1
  check  Code COLLATE Arabic_100_BIN2 NOT LIKE '%[^A-Z0-9_]%'
  check  StLinesWithdrawnPct BETWEEN 0 AND 100 AND PrivateArLossPct BETWEEN 0 AND 100 AND RateBp >= 0 AND BaseDsoDays >= 0
  check  UndrawnAvailablePct BETWEEN 0 AND 100 AND DurationMonths BETWEEN 1 AND 60 AND OtherCountryMult BETWEEN 0 AND 2
  check  UndrawnCutPct BETWEEN 0 AND 100 AND LenderMarginBp >= 0 AND LenderFeesBp >= 0

table fin.MacroScenarioCountry int global  # The multiplier of a macro scenario's stress for a country it hits more or less than others; a country without a row takes the scenario's OtherCountryMult (docs/35 section 14, ADR 0020)
  MacroScenarioId   ->fin.MacroScenario req
  CountryId         ->ref.Country req
  Multiplier        dec(5,3)  req
  unique MacroScenarioId,CountryId
  check  Multiplier BETWEEN 0 AND 2

table fin.MacroScenarioIntensity int global  # The intensity 0 to 1 of a driver in a macro scenario (docs/35 section 14)
  MacroScenarioId   ->fin.MacroScenario req
  ShockDriverId     ->fin.ShockDriver req
  Intensity         dec(5,3)  req
  unique MacroScenarioId,ShockDriverId
  check  Intensity BETWEEN 0 AND 1

table fin.IndustrySensitivity int global  # The sensitivity 0 (none) to 5 (extreme) of an activity to a driver of stress (docs/35 section 14)
  IndustryId        ->ref.Industry req
  ShockDriverId     ->fin.ShockDriver req
  Sensitivity       tinyint   req
  unique IndustryId,ShockDriverId
  check  Sensitivity BETWEEN 0 AND 5

table fin.CountryRiskProfile int global  # The credit risk of a country for its companies: country risk 1 to 6, the published sovereign rating and its date, the ceiling of a company's grade, and the country's exposure to each driver of stress; one default row for a country without a profile (docs/35 section 13, ADR 0019)
  CountryId         ->ref.Country         # فارغ للصف الافتراضي
  IsDefault         bool      req =0
  CountryRisk       tinyint   req
  SovereignRatingGradeId ->fin.RatingGrade noidx   # التصنيف السيادي المنشور إن وُجد؛ يتحقق منه مشغّل المنصة
  RatingAsOf        ascii(7)            # الشهر YYYY-MM
  CeilingGradeId    ->fin.RatingGrade req noidx   # سقف درجة الشركة: التصنيف السيادي، أو سقف مخاطر البلد إن لم يُصنَّف
  ExpDemand         dec(5,2)  req
  ExpGovSpending    dec(5,2)  req
  ExpRealEstate     dec(5,2)  req
  ExpConflict       dec(5,2)  req
  ExpOil            dec(5,2)  req
  ExpCredit         dec(5,2)  req
  ExpImportFx       dec(5,2)  req
  NoteAr            str(1000)
  NoteEn            str(1000)
  unique CountryId where CountryId IS NOT NULL
  unique IsDefault where IsDefault = 1
  check  CountryRisk BETWEEN 1 AND 6
  check  (IsDefault = 1 AND CountryId IS NULL) OR (IsDefault = 0 AND CountryId IS NOT NULL)
  check  ExpDemand BETWEEN 0.3 AND 2 AND ExpGovSpending BETWEEN 0.3 AND 2 AND ExpRealEstate BETWEEN 0.3 AND 2 AND ExpConflict BETWEEN 0.3 AND 2 AND ExpOil BETWEEN 0.3 AND 2 AND ExpCredit BETWEEN 0.3 AND 2 AND ExpImportFx BETWEEN 0.3 AND 2
  check  RatingAsOf IS NULL OR RatingAsOf COLLATE Arabic_100_BIN2 LIKE '[12][0-9][0-9][0-9]-[01][0-9]'

table fin.CountryRegion int global  # A city or region of a country and how much more or less its property falls, and how exposed it is to conflict, than its country (docs/35 section 14)
  CountryId         ->ref.Country req
  Code              ascii(10) req
  NameAr            str(200)  req
  NameEn            str(200)  req
  Tier              enum{PRIME,MAJOR,SECONDARY,PERIPHERAL} req
  RealEstateMult    dec(5,2)  req
  ConflictMult      dec(5,2)  req
  unique CountryId,Code
  check  Code COLLATE Arabic_100_BIN2 NOT LIKE '%[^A-Z0-9_]%'
  check  RealEstateMult BETWEEN 0.5 AND 2 AND ConflictMult BETWEEN 0.5 AND 2

table fin.RiskAnchor int global  # The anchor of a company's business risk from its country risk and its industry risk, a notch of the 21-grade scale: the computed sector risk sub-factor and the centre of the expected range (docs/35 section 13)
  CountryRisk       tinyint   req
  IndustryRisk      tinyint   req
  AnchorNotch       tinyint   req
  unique CountryRisk,IndustryRisk
  check  CountryRisk BETWEEN 1 AND 6 AND IndustryRisk BETWEEN 1 AND 6 AND AnchorNotch BETWEEN 1 AND 21

table fin.ProductCategory int global  # A category of products or services and its credit behaviour: cash-flow quality, revenue sensitivity, inventory sale value and time to sell in normal, stagnant and crisis markets (docs/35 section 5)
  Code              ascii(40) req
  NameAr            str(200)  req
  NameEn            str(200)  req
  CashFlowQuality   tinyint   req      # 1 الأفضل ... 5 الأضعف
  DemandSensitivity tinyint   req      # حساسية الطلب على الفئة 0 إلى 5؛ تحل محل حساسية النشاط للطلب حين تُدخل الشركة منتجاتها
  InvValueNormalPct dec(9,4)  req      # قيمة بيع المخزون من الدفترية
  InvValueStagnantPct dec(9,4) req
  InvValueCrisisPct dec(9,4)  req
  DaysToSellNormal  int       req
  DaysToSellStagnant int      req
  DaysToSellCrisis  int       req
  CrisisExtraDso    int       req
  unique Code
  check  CashFlowQuality BETWEEN 1 AND 5
  check  DemandSensitivity BETWEEN 0 AND 5
  check  InvValueNormalPct BETWEEN 0 AND 100 AND InvValueStagnantPct BETWEEN 0 AND 100 AND InvValueCrisisPct BETWEEN 0 AND 100

table fin.StandardLine int global  # The standard statement line catalogue of the platform: every point of the statements the credit assessment reads, its kind and the line it breaks down; installed into a tenant's catalogue by fin.usp_InstallStandardLines (docs/35 section 4, FR-FIN-001)
  Code              ascii(40) req
  Section           enum{BS_ASSET,BS_LIABILITY,BS_EQUITY,IS,CF,MEMO} req
  LineKind          enum{LINE,TOTAL,OF_WHICH,DETAIL,MEMO} req   # LINE يدخل الإجماليات؛ OF_WHICH «منه» لا يزيد على أصله؛ DETAIL تفصيل بلا هذا الحد (الإجمالي قبل المخصص)؛ MEMO إفصاح
  ParentCode        ascii(40)        # البند الذي يفصّله OF_WHICH أو DETAIL
  NameAr            str(300)  req
  NameEn            str(300)  req
  IsRequired        bool      req =0   # من البنود الأساسية؛ غيرها اختياري يُعد صفرًا إن لم يُدخل
  TotalFormula      str(500)         # للإجمالي، مثل GROSS_PROFIT = REVENUE - COGS
  SortOrder         int       req
  unique Code
  check  Code COLLATE Arabic_100_BIN2 NOT LIKE '%[^A-Z0-9_]%' AND Code NOT LIKE '[0-9_]%'
  check  (LineKind IN ('OF_WHICH','DETAIL') AND ParentCode IS NOT NULL) OR (LineKind NOT IN ('OF_WHICH','DETAIL') AND ParentCode IS NULL)
  check  (LineKind = 'TOTAL' AND TotalFormula IS NOT NULL) OR (LineKind <> 'TOTAL' AND TotalFormula IS NULL)
  check  ParentCode IS NULL OR ParentCode <> Code

table fin.StandardLineTotal int global  # The components of a standard total and their sign, so a total is recomputed after a pro-forma change (docs/35 section 12)
  TotalCode         ascii(40) req
  ComponentCode     ascii(40) req
  Sign              smallint  req
  unique TotalCode,ComponentCode
  check  Sign IN (-1,1)
  check  TotalCode <> ComponentCode

table fin.ScorecardParameter int global  # A parameter of a scorecard version: a haircut of the break-up test, a collateral haircut, a band of the loss given default, a liquidity threshold, a cost rule; frozen with its scorecard (docs/35 sections 5, 9 and 10)
  ScorecardId       ->fin.Scorecard req
  GroupCode         enum{CARD,REALISABLE_HAIRCUT,COLLATERAL_HAIRCUT,LGD_BAND,SGL,FIXED_COST,SCENARIO} req
  ParamKey          ascii(40) req
  Value             dec(19,6) req
  Value2            dec(19,6)        # لنطاق الخسارة: الدرجات؛ ولغيره فارغ
  unique ScorecardId,GroupCode,ParamKey

table fin.ScorecardSubfactor int global  # A sub-factor of a qualitative factor of a scorecard, with its grading guide; the factor's grade is the average of the graded sub-factors when the analyst grades them (docs/35 section 5)
  ScorecardId       ->fin.Scorecard req
  MetricId          ->fin.CreditMetric req noidx   # العامل النوعي
  Code              ascii(40) req
  NameAr            str(200)  req
  NameEn            str(200)  req
  GuideAr           str(1500) req
  SortOrder         int       req =0
  unique ScorecardId,MetricId,Code

table fin.CreditRemedy int global  # A remedy the report proposes against a finding: a real action, or a presentation that follows the legal substance and needs its evidence, with the change it makes to the statement for the pro-forma grade (docs/35 section 12)
  Code              ascii(40) req
  Kind              enum{REAL_ACTION,PRESENTATION} req
  MinLevel          enum{MODERATE,ELEVATED,HIGH,CRITICAL} req   # أدنى مستوى خطر يُقترح عنده
  NameAr            str(200)  req
  NameEn            str(200)  req
  TextAr            str(1000) req
  TextEn            str(1000) req
  EvidenceAr        str(500)
  EvidenceEn        str(500)
  Funding           enum{OWNER_CONSENT,OWNER_CASH,RELATED_PARTIES,LENDERS,OPERATIONS,ASSET_SALE,POLICY,DISCLOSURE} req   # ما يحتاجه الحل: توقيع الشركاء، نقدهم، البنوك، التشغيل...
  SetsEvidence      enum{SUBORDINATION,CAPITAL_RESOLUTION,WAIVER_BEFORE_PERIOD_END}   # الدليل الذي يفترضه الحل في حسابه التقديري
  SortOrder         int       req =0
  IsActive          bool      req =1
  unique Code
  check  Kind = 'REAL_ACTION' OR EvidenceAr IS NOT NULL   # الإظهار يحتاج دليله
  check  Code COLLATE Arabic_100_BIN2 NOT LIKE '%[^A-Z0-9_]%'

table fin.CreditRemedyTrigger int global  # A finding a remedy answers: a metric or an adjustment code
  RemedyId          ->fin.CreditRemedy req
  TriggerCode       ascii(40) req
  SortOrder         int       req      # الترتيب الذي يُبحث به عن النتيجة التي تستدعي الحل
  unique RemedyId,TriggerCode
  unique RemedyId,SortOrder
  index  TriggerCode

table fin.CreditRemedyStep int global  # A step of a remedy's pro-forma: an amount, a share of a reference line capped by what the lines decreased hold, taken from up to three lines and added to up to three
  RemedyId          ->fin.CreditRemedy req
  StepNo            tinyint   req
  RefLine           ascii(40) req
  Pct               dec(9,4)  req
  Dec1              ascii(40)
  Dec2              ascii(40)
  Dec3              ascii(40)
  Inc1              ascii(40)
  Inc2              ascii(40)
  Inc3              ascii(40)
  unique RemedyId,StepNo
  check  Pct > 0 AND Pct <= 100
  check  Dec1 IS NOT NULL OR Inc1 IS NOT NULL
  check  (Dec2 IS NULL OR Dec1 IS NOT NULL) AND (Dec3 IS NULL OR Dec2 IS NOT NULL)
  check  (Inc2 IS NULL OR Inc1 IS NOT NULL) AND (Inc3 IS NULL OR Inc2 IS NOT NULL)

table fin.StrengtheningPlan int global  # A ready-made plan to strengthen the statements: a package of remedies applied one after another, or the best plan the engine builds step by step from the remedies the findings call for (docs/35 section 12)
  Code              ascii(40) req
  Kind              enum{PACKAGE,OPTIMAL} req
  NameAr            str(200)  req
  NameEn            str(200)  req
  TextAr            str(1000) req
  TextEn            str(1000) req
  ExcludeFunding    ascii(100)        # للخطة المثلى: أنواع التمويل المستبعدة مفصولة بفواصل
  SortOrder         int       req
  IsActive          bool      req =1
  unique Code
  check  Code COLLATE Arabic_100_BIN2 NOT LIKE '%[^A-Z0-9_]%'
  check  Kind = 'OPTIMAL' OR ExcludeFunding IS NULL

table fin.StrengtheningPlanMember int global  # A remedy of a package plan, in the order the plan applies it
  PlanId            ->fin.StrengtheningPlan req
  RemedyId          ->fin.CreditRemedy req noidx
  SortOrder         int       req
  unique PlanId,RemedyId
  unique PlanId,SortOrder

table fin.CreditText int global  # A text of the credit report: the reconciliation rows, the disclosures and data the report asks for, the outlook rules and views, the liquidity labels, the resilience and the funding kinds (docs/35)
  Domain            enum{RECLASS,DISCLOSURE,REQUEST,OUTLOOK,OUTLOOK_VIEW,LIQUIDITY,RESILIENCE,FUNDING} req
  Code              ascii(40) req
  NameAr            str(200)  req
  NameEn            str(200)  req
  TextAr            str(1000) req
  TextEn            str(1000) req
  unique Domain,Code

table fin.CreditAssessment public  # Credit assessment of an approved statement on a sector scorecard: the study of the balance sheet with a grade on the Moody's scale, its strengths, weaknesses and risks; written as a draft, computed by the database, approved by someone else (FR-FIN-020 to FR-FIN-024, BR-FIN-018 to BR-FIN-024; owner request 2026-10-18)
  CompanyId         ->org.Company req
  StatementId       ->fin.FinancialStatement req via=CompanyId   # القائمة المقيَّمة، معتمدة ومن الشركة نفسها
  PriorStatementId  ->fin.FinancialStatement via=CompanyId noidx   # قائمة المقارنة؛ فارغة = يختارها الإجراء
  ScorecardId       ->fin.Scorecard req   # بطاقة القطاع وإصدارها
  AssessmentDate    date       req
  FxRateToScorecard dec(19,8)            # سعر عملة القائمة بعملة البطاقة؛ إلزامي إن اختلفتا (BR-FIN-019)
  Status            enum{DRAFT,SUBMITTED,APPROVED,REJECTED,SUPERSEDED} req =DRAFT
  ComputedAt        ts                   # من هنا إلى Snapshot: يكتبها fin.usp_ComputeCreditAssessment وحده (DENY على tp_app، 046)
  InputsHash        ascii(64)            # بصمة SHA-256 لما قرأه الحساب؛ التقديم يُرفض إن تغيّر بعده (50063)
  UsedPriorStatementId ->fin.FinancialStatement via=CompanyId noidx
  ResultState       enum{RATED,INDICATIVE,INSUFFICIENT_DATA}   # INDICATIVE: درجة مالية فقط لنقص العوامل النوعية، لا تُقدَّم
  CoveragePct       dec(5,2)            # من أوزان المقاييس الكمية
  FinancialScore    dec(9,4)            # مجموع المقاييس الكمية وحدها
  FinancialGradeId  ->fin.RatingGrade noidx
  WeightedScore     dec(9,4)
  IndicatedGradeId  ->fin.RatingGrade noidx
  AdjustmentNotches int
  CapGradeId        ->fin.RatingGrade noidx   # أشد سقف طُبّق
  StandaloneGradeId ->fin.RatingGrade noidx   # بعد التنزيل والسقوف المنفردة، قبل الدعم
  SupportNotches    int
  OverrideNotches   int
  FinalGradeId      ->fin.RatingGrade noidx
  FacilityGradeId   ->fin.RatingGrade noidx   # درجة التسهيلات: درجة الملتزم بعد نطاق الخسارة عند التعثر من الضمانات (docs/35 §10)
  LgdPct            dec(5,2)            # الخسارة المتوقعة عند التعثر من التعرض
  LgdBand           ascii(4)            # LGD1..LGD6
  LiquidityLabel    ascii(5)            # SGL-1..SGL-4 من مصادر السنة واستخداماتها (docs/35 §9)
  CompletenessPct   dec(5,2)            # الإفصاحات المطلوبة المعطاة (docs/35 §11)
  AdjustedDebt      money               # الدين المعدَّل تحليليًا بعملة القائمة
  AdjustedTnw       money               # صافي الثروة الملموسة المعدَّلة
  RealisableNetWorth money              # الأصول بعد خصومات التسييل ناقص الخصوم المعدَّلة
  SummaryAr         str(1000)
  SummaryEn         str(1000)
  Snapshot          json                 # البنود المقروءة ومعامل التحويل إلى سنة والسعر وإصدار البطاقة
  PreparedBy        ->sec.AppUser
  PreparedOn        ts
  ApprovedBy        ->sec.AppUser
  ApprovedOn        ts
  RejectionReason   str(500)
  EndorsedBy        ->sec.AppUser noidx   # تصديق الاستعمال خارج الشركة: من خارج خط الإعداد والاعتماد (fin.credit.endorse، ADR 0029)
  EndorsedOn        ts
  EndorsementNote   str(1000)            # سبب التصديق ونطاقه: لمن يُعرض ولأي غرض
  EndorsedBias      enum{INSUFFICIENT,OPTIMISTIC,CONSERVATIVE,ALIGNED}   # ميل الشركة مقابل جهاتها يوم التصديق (ADR 0030)
  EndorsedRatings   int                  # عدد التصنيفات المقارنة يومها
  EndorsedLastRatingDate date            # تاريخ آخر تصنيف لجهة تمويل يومها
  IndustryId        ->ref.Industry noidx   # النشاط الذي قرأه التقييم (من الشركة عند الحساب)
  SectorPosition    enum{ABOVE,WITHIN,BELOW}   # الدرجة مقابل المدى المتوقع لقطاعها
  Resilience        enum{RESILIENT,MODERATE,VULNERABLE}   # من سيناريو ركود السوق (docs/35 §13)
  Outlook           enum{POSITIVE,STABLE,NEGATIVE,DEVELOPING}   # اتجاه الدرجة خلال 12-18 شهرًا (docs/35 §15)
  OutlookRules      ascii(200)          # القواعد التي تحققت مفصولة بفواصل
  UpHeadroom        dec(9,4)            # المسافة من المجموع المرجح إلى الدرجة الأعلى
  DownHeadroom      dec(9,4)            # المسافة إلى الدرجة الأدنى
  StrengtheningRequested bool req =0    # طلب العميل خطط تقوية القوائم (docs/35 §12)
  IsTrial           bool      req =0    # تقييم تجريبي: يقرأ قائمة مسودة أو مقدّمة قبل اعتمادها، ويُحسب ويُعاد ولا يُقدَّم (ADR 0022، BR-FIN-036)
  MarketCountryId   ->ref.Country noidx   # بلد السوق الرئيسي؛ فارغ = بلد تأسيس الشركة (ADR 0019)
  MarketRegionCode  ascii(10)           # المدينة أو المنطقة الرئيسية من fin.CountryRegion، للعقار والمقاولات خاصة
  CountryRisk       tinyint             # من هنا: يكتبها الإجراء؛ مخاطر البلد التي قرأها التقييم
  IndustryRisk      tinyint
  AnchorGradeId     ->fin.RatingGrade noidx   # مرتكز مخاطر البلد والنشاط
  CountryCeilingGradeId ->fin.RatingGrade noidx   # سقف البلد الذي طُبّق
  unique PublicId
  unique StatementId where Status = 'APPROVED'   # تقييم معتمد واحد لكل قائمة
  index  CompanyId,AssessmentDate include Status,FinalGradeId   # سجل تقييمات الشركة
  check  FxRateToScorecard IS NULL OR FxRateToScorecard > 0
  check  PriorStatementId IS NULL OR PriorStatementId <> StatementId
  check  (ResultState IS NULL AND FinancialScore IS NULL AND WeightedScore IS NULL AND IndicatedGradeId IS NULL AND FinalGradeId IS NULL) OR (ResultState IS NOT NULL AND ComputedAt IS NOT NULL AND InputsHash IS NOT NULL AND CoveragePct IS NOT NULL AND ((ResultState = 'INSUFFICIENT_DATA' AND FinancialScore IS NULL AND WeightedScore IS NULL AND IndicatedGradeId IS NULL AND FinalGradeId IS NULL) OR (ResultState = 'INDICATIVE' AND FinancialScore IS NOT NULL AND FinancialGradeId IS NOT NULL AND WeightedScore IS NULL AND FinalGradeId IS NULL) OR (ResultState = 'RATED' AND FinancialScore IS NOT NULL AND WeightedScore IS NOT NULL AND IndicatedGradeId IS NOT NULL AND StandaloneGradeId IS NOT NULL AND FinalGradeId IS NOT NULL)))
  check  WeightedScore IS NULL OR (WeightedScore >= 0.5 AND WeightedScore <= 20.5)
  check  FinancialScore IS NULL OR (FinancialScore >= 0.5 AND FinancialScore <= 20.5)
  check  CoveragePct IS NULL OR (CoveragePct >= 0 AND CoveragePct <= 100)
  check  SupportNotches IS NULL OR SupportNotches BETWEEN 0 AND 2
  check  OverrideNotches IS NULL OR OverrideNotches BETWEEN -2 AND 1
  check  Status NOT IN ('SUBMITTED','APPROVED','SUPERSEDED') OR (ResultState IS NOT NULL AND ResultState = 'RATED' AND PreparedBy IS NOT NULL AND PreparedOn IS NOT NULL)   # يُقدَّم المحسوب بدرجة (BR-FIN-024)
  check  Status NOT IN ('APPROVED','SUPERSEDED') OR (ApprovedBy IS NOT NULL AND ApprovedOn IS NOT NULL)
  check  ApprovedBy IS NULL OR PreparedBy IS NULL OR ApprovedBy <> PreparedBy   # المُعِدّ ≠ المعتمِد
  check  Status <> 'REJECTED' OR RejectionReason IS NOT NULL
  check  (EndorsedBy IS NULL AND EndorsedOn IS NULL AND EndorsementNote IS NULL) OR (EndorsedBy IS NOT NULL AND EndorsedOn IS NOT NULL AND EndorsementNote IS NOT NULL AND Status IN ('APPROVED','SUPERSEDED') AND IsTrial = 0)   # يُصدَّق المعتمد بسبب (ADR 0029)
  check  EndorsedBy IS NULL OR (EndorsedBy <> PreparedBy AND EndorsedBy <> ApprovedBy)   # المصدِّق غير المُعِدّ والمعتمِد
  check  (EndorsedBy IS NULL AND EndorsedBias IS NULL AND EndorsedRatings IS NULL AND EndorsedLastRatingDate IS NULL) OR (EndorsedBy IS NOT NULL AND EndorsedBias IS NOT NULL AND EndorsedRatings IS NOT NULL)
  check  MarketRegionCode IS NULL OR MarketRegionCode COLLATE Arabic_100_BIN2 NOT LIKE '%[^A-Z0-9_]%'
  check  CountryRisk IS NULL OR CountryRisk BETWEEN 1 AND 6
  check  IndustryRisk IS NULL OR IndustryRisk BETWEEN 1 AND 6

table fin.CreditAssessmentInput deletable  # The analyst's inputs to an assessment: the grade of a qualitative factor, group support or an override, each with its justification; they change only while the assessment is a draft (BR-FIN-021, BR-FIN-022)
  AssessmentId      ->fin.CreditAssessment req
  Kind              enum{QUALITATIVE,SUBFACTOR,GROUP_SUPPORT,OVERRIDE,MARKET_SIZE,FX_RATE,EVIDENCE} req
  MetricId          ->fin.CreditMetric noidx   # العامل النوعي
  SubfactorId       ->fin.ScorecardSubfactor noidx   # العامل الفرعي (SUBFACTOR)
  Amount            money               # حجم السوق بعملة القائمة (MARKET_SIZE)
  CurrencyId        ->ref.Currency noidx   # عملة السعر (FX_RATE)
  Rate              dec(19,8)           # سعر العملة بعملة القائمة (FX_RATE)
  EvidenceCode      enum{SUBORDINATION,CAPITAL_RESOLUTION,WAIVER_BEFORE_PERIOD_END,REFINANCING_BEFORE_PERIOD_END}   # دليل التبويب (docs/35 §6)
  GradeId           ->fin.RatingGrade noidx    # درجته
  Notches           int                        # الدعم 1..2، والتجاوز −2..+1 بلا صفر: الرفع درجة واحدة لأن الشركة تقيّم نفسها
  ParentAssessmentId ->fin.CreditAssessment     # التقييم المعتمد للأم أو القابضة (GROUP_SUPPORT)
  Justification     str(1000) req
  DocumentId        ->doc.Document   # المستند المؤيد؛ يلزم لدرجة نوعية تبعد أكثر من الحد عن الدرجة المالية (BR-FIN-021)
  EnteredBy         ->sec.AppUser
  unique AssessmentId,Kind,MetricId,SubfactorId,CurrencyId,EvidenceCode   # مدخل واحد لكل عامل وعامل فرعي وعملة ودليل، ودعم واحد وتجاوز واحد
  check  (Kind = 'QUALITATIVE' AND MetricId IS NOT NULL AND GradeId IS NOT NULL AND Notches IS NULL AND ParentAssessmentId IS NULL AND SubfactorId IS NULL AND Amount IS NULL AND CurrencyId IS NULL AND Rate IS NULL AND EvidenceCode IS NULL) OR (Kind = 'SUBFACTOR' AND MetricId IS NOT NULL AND SubfactorId IS NOT NULL AND GradeId IS NOT NULL AND Notches IS NULL AND ParentAssessmentId IS NULL AND Amount IS NULL AND CurrencyId IS NULL AND Rate IS NULL AND EvidenceCode IS NULL) OR (Kind = 'GROUP_SUPPORT' AND MetricId IS NULL AND GradeId IS NULL AND Notches IS NOT NULL AND Notches BETWEEN 1 AND 2 AND ParentAssessmentId IS NOT NULL AND SubfactorId IS NULL AND Amount IS NULL AND CurrencyId IS NULL AND Rate IS NULL AND EvidenceCode IS NULL) OR (Kind = 'OVERRIDE' AND MetricId IS NULL AND GradeId IS NULL AND Notches IS NOT NULL AND Notches IN (-2,-1,1) AND ParentAssessmentId IS NULL AND SubfactorId IS NULL AND Amount IS NULL AND CurrencyId IS NULL AND Rate IS NULL AND EvidenceCode IS NULL) OR (Kind = 'MARKET_SIZE' AND Amount IS NOT NULL AND Amount > 0 AND MetricId IS NULL AND GradeId IS NULL AND Notches IS NULL AND ParentAssessmentId IS NULL AND SubfactorId IS NULL AND CurrencyId IS NULL AND Rate IS NULL AND EvidenceCode IS NULL) OR (Kind = 'FX_RATE' AND CurrencyId IS NOT NULL AND Rate IS NOT NULL AND Rate > 0 AND MetricId IS NULL AND GradeId IS NULL AND Notches IS NULL AND ParentAssessmentId IS NULL AND SubfactorId IS NULL AND Amount IS NULL AND EvidenceCode IS NULL) OR (Kind = 'EVIDENCE' AND EvidenceCode IS NOT NULL AND DocumentId IS NOT NULL AND MetricId IS NULL AND GradeId IS NULL AND Notches IS NULL AND ParentAssessmentId IS NULL AND SubfactorId IS NULL AND Amount IS NULL AND CurrencyId IS NULL AND Rate IS NULL)
  check  ParentAssessmentId IS NULL OR ParentAssessmentId <> AssessmentId
  check  LEN(LTRIM(RTRIM(Justification))) >= 10   # مبرّر مكتوب لا رمز

table fin.CreditAssessmentFactor norv  # A scorecard metric of an assessment: its value, its score on the linear continuum, its grade, weight and contribution; written by fin.usp_ComputeCreditAssessment only (BR-FIN-018, BR-FIN-019)
  AssessmentId      ->fin.CreditAssessment req
  MetricId          ->fin.CreditMetric req noidx
  FactorCode        ascii(30) req
  Weight            dec(5,2)  req
  EffectiveWeight   dec(9,4)        # الوزن بعد إعادة توزيعه على المقاييس ذات الدرجة
  Status            enum{COMPUTED,EXTREME,NOT_COMPUTABLE,ANALYST} req   # EXTREME: لا معنى للنسبة فتُعطى طرف الخط (لا دين، EBITDA سالب...)
  Value             dec(19,6)
  Score             dec(9,4)
  GradeId           ->fin.RatingGrade noidx
  Contribution      dec(9,4)
  Reason            str(300)
  unique AssessmentId,MetricId
  check  (Status = 'COMPUTED' AND Value IS NOT NULL AND Score IS NOT NULL AND Reason IS NULL) OR (Status = 'EXTREME' AND Value IS NULL AND Score IS NOT NULL AND Reason IS NOT NULL) OR (Status = 'NOT_COMPUTABLE' AND Value IS NULL AND Score IS NULL AND Reason IS NOT NULL) OR (Status = 'ANALYST' AND Value IS NULL AND Score IS NOT NULL)
  check  Score IS NULL OR (Score >= 0.5 AND Score <= 20.5)
  check  Weight > 0 AND Weight <= 100

table fin.CreditAssessmentFinding norv  # A finding of an assessment, with its text: a strength, a point to note or watch, a weakness, a critical risk or an adjustment, from the scorecard, an item rule, the covenants or the bank flows; written by fin.usp_ComputeCreditAssessment only (BR-FIN-020)
  AssessmentId      ->fin.CreditAssessment req
  SeqNo             int       req
  Kind              enum{STRENGTH,INFO,WATCH,WEAKNESS,CRITICAL_RISK,ADJUSTMENT} req
  Source            enum{SCORECARD,ITEM_RULE,ADJUSTMENT,COVENANT,BANK_FLOW,ANALYST,DATA,LIQUIDITY,FACILITY} req   # DATA: إفصاح ناقص أو غير متسق
  RuleCode          ascii(40) req   # رمز المقياس أو القاعدة أو التعديل
  LineCode          ascii(40)       # بند الميزانية لقاعدة البند
  RiskLevel         enum{LOW,MODERATE,ELEVATED,HIGH,CRITICAL}
  Value             dec(19,6)
  PriorValue        dec(19,6)
  Notches           int
  RefId             bigint          # اختبار التعهد أو التعهد للنتائج من التعهدات والتحويلات
  TextAr            str(1000) req
  TextEn            str(1000)
  unique AssessmentId,SeqNo
  check  SeqNo >= 1
  check  Source <> 'ITEM_RULE' OR LineCode IS NOT NULL   # بلا مستوى إن لم يُقيَّم البند
  check  RiskLevel IS NULL OR Source = 'ITEM_RULE'

table fin.CreditAssessmentGuarantor deletable  # A guarantor of the company's facilities with the net worth statement the analyst read: partners' solvency for the facility grade (docs/35 section 10); changes only while the assessment is a draft
  AssessmentId      ->fin.CreditAssessment req
  PartyId           ->pty.Party req          # الشريك أو الكفيل
  NetWorth          money      req          # صافي الثروة المصرَّح به بعملة القائمة
  LiquidAssets      money      req          # منه أصول سائلة (نقد وودائع وأسهم مدرجة)
  GuaranteesGiven   money      req =0       # كفالات قدّمها لالتزامات أخرى
  GuaranteedAmount  money      req          # ما يكفله من تسهيلات الشركة
  AsOfDate          date       req
  DocumentId        ->doc.Document req      # إقرار الذمة المالية أو القوائم الشخصية
  unique AssessmentId,PartyId
  check  NetWorth >= 0 AND LiquidAssets >= 0 AND GuaranteesGiven >= 0 AND GuaranteedAmount > 0
  check  LiquidAssets <= NetWorth

table fin.LenderRating src  # A rating of the company that a lender communicated to it: the lender's own grade and its equivalent on the 21-grade scale (given by the lender or mapped by the treasury), with what the lender said; compared with the company's assessment of that date (docs/36 F6, ADR 0026)
  CompanyId           ->org.Company req
  LenderInstitutionId ->ins.Institution req noidx
  RatingDate          date       req
  LenderGradeLabel    str(40)              # درجة البنك بتسميته الداخلية إن كانت له
  GradeId             ->fin.RatingGrade req noidx   # مقابلها على سلّم الإحدى والعشرين درجة
  MappingKind         enum{GIVEN_BY_LENDER,MAPPED_BY_TREASURY} req
  LenderReasons       str(2000)            # ما ذكره البنك من أسباب
  unique CompanyId,LenderInstitutionId,RatingDate
  index  CompanyId,RatingDate
  check  MappingKind = 'GIVEN_BY_LENDER' OR LenderGradeLabel IS NOT NULL   # المقابلة التي تجريها الخزينة تُبقي تسمية البنك
  check  SourceDocumentId IS NOT NULL AND SourcePage IS NOT NULL OR (SourceDocumentId IS NULL AND Confidence = 'ENTERED_NO_DOCUMENT')   # ختم المصدر (BR-FAC-018)
  check  Confidence <> 'CONFIRMED_AGAINST_ORIGINAL' OR (VerifiedBy IS NOT NULL AND VerifiedOn IS NOT NULL)

table fin.EarlyWarningAlert append  # An early warning the job JOB-FIN-READINESS issued: a lender date of the company within the lead time that is not ready, once per stage of the time left and readiness, so a run after a stop or a second run of the day repeats nothing; written by the database only, with the notification request in the outbox, FIN.READINESS_RED or FIN.READINESS_AMBER (docs/36 F4, ADR 0027, ADR 0028)
  CompanyId     ->org.Company req
  AssessmentId  ->fin.CreditAssessment req noidx   # التقييم الذي قرأته المهمة: آخر تقييم محسوب لقائمة فعلية
  EventKind     enum{RENEWAL,COVENANT_TEST,REPORTING} req
  RefId         bigint     req   # التسهيل أو اختبار التعهد أو موعد التقرير
  EventDate     date       req   # موعد جهة التمويل وقت الإنذار: تغيّره يعيد الإنذارات من أولها
  Stage         enum{LEAD,D90,D30,D7} req   # ما بقي من الوقت: داخل مهلة الإعداد، ثم 90 و30 و7 أيام
  Readiness     enum{AMBER,RED} req
  ReasonCode    ascii(30)  req   # أول قاعدة حددت الجاهزية (049)، ونصها في رسالة الإنذار (ADR 0028)
  IssuedOn      date       req   # يوم التشغيل بتوقيت المشترك
  MessageId     guid       req   # صف طلب الإشعار في cfg.OutboxEvent
  unique CompanyId,EventKind,RefId,EventDate,Stage,Readiness
  unique MessageId
  index  CompanyId,IssuedOn

table fin.AssessmentEvidencePack append  # A sealed evidence pack of an endorsed assessment, built for an auditor or a lender: the assessment, its statement versions and lines, findings, reconciliation, calibration and audit rows in one JSON document whose SHA-256 is kept here; the same content gives the same hash (ADR 0030)
  AssessmentId  ->fin.CreditAssessment req
  Purpose       str(500)   req   # لمن ولأي غرض: المدقق الخارجي لسنة 2025، أو البنك لتجديد 2026
  Sha256        bin(32)    req   # بصمة نص JSON بترميز UTF-16LE كما تعيده القاعدة
  ContentChars  int        req
  GeneratedBy   ->sec.AppUser req noidx
  index  AssessmentId,CreatedAt
  check  ContentChars > 0

table fin.ReceivableLossRate int  # The loss rate of a receivables ageing bucket for the provision matrix the company compares its recorded allowance with (IFRS 9 simplified approach; owner decision 35, ADR 0030); the defaults of the pack FIN.PROVISION are for the treasury to approve or change
  BucketCode    enum{AR_AGE_0_90,AR_AGE_91_180,AR_AGE_181_365,AR_AGE_OVER_365,AR_AGE_OVER_365_GOV} req
  LossRatePct   dec(7,4)   req
  EffectiveFrom date       req
  Status        enum{DRAFT,APPROVED} req =DRAFT
  PreparedBy    ->sec.AppUser noidx   # من كتب المسودة أو غيّرها؛ فارغ لافتراضي الحزمة FIN.PROVISION (058، ADR 0037)
  ApprovedBy    ->sec.AppUser noidx
  ApprovedOn    ts
  Note          str(500)
  SeedKey       ascii(80)
  unique BucketCode,EffectiveFrom
  unique SeedKey where SeedKey IS NOT NULL
  check  LossRatePct >= 0 AND LossRatePct <= 100
  check  (Status = 'DRAFT' AND ApprovedBy IS NULL AND ApprovedOn IS NULL) OR (Status = 'APPROVED' AND ApprovedBy IS NOT NULL AND ApprovedOn IS NOT NULL)
  check  ApprovedBy IS NULL OR PreparedBy IS NULL OR ApprovedBy <> PreparedBy   # المُعِدّ ≠ المعتمِد (ADR 0037)
  check  PreparedBy IS NOT NULL OR SeedKey IS NOT NULL   # يُعِدّه مستخدم إلا افتراضي الحزمة (ADR 0037)

table fin.ReportingPeriodLock  # The close of a company's reporting periods: through LockedThrough no actual statement, version, monthly balance or bank flow of the company is added, changed or removed; locked once its figures are approved or confirmed, reopened with a reason by someone other than the one who locked it (optional for each company; docs/38 item 2, ADR 0031)
  CompanyId     ->org.Company req
  LockedThrough date       req   # نهاية آخر فترة مقفلة: كل ما تاريخه حتى هذا اليوم مقفل
  Status        enum{LOCKED,REOPENED} req =LOCKED
  LockReason    str(500)   req   # مثل: إقفال سنة 2025 بعد اعتماد القوائم المدققة
  LockedBy      ->sec.AppUser req noidx
  LockedOn      ts         req
  ReopenedBy    ->sec.AppUser noidx
  ReopenedOn    ts
  ReopenReason  str(500)
  unique CompanyId,LockedThrough where Status = 'LOCKED'
  index  CompanyId,Status include LockedThrough
  check  (Status = 'LOCKED' AND ReopenedBy IS NULL AND ReopenedOn IS NULL AND ReopenReason IS NULL) OR (Status = 'REOPENED' AND ReopenedBy IS NOT NULL AND ReopenedOn IS NOT NULL AND ReopenReason IS NOT NULL)
  check  ReopenedBy IS NULL OR ReopenedBy <> LockedBy   # يعيد الفتح غير من أقفل
  check  ReopenedOn IS NULL OR ReopenedOn >= LockedOn

table fin.PresentationVersion public  # An alternative presentation of a company's statement before its final approval: the remedies the company chose, applied in order to the statement and kept balanced, written as a new draft statement with a trial assessment to compare; chosen by someone other than its preparer, and only when every step rests on a document dated by the period end (docs/36 F2, ADR 0023)
  SourceStatementId ->fin.FinancialStatement req
  SourceAssessmentId ->fin.CreditAssessment noidx   # التقييم الذي يُقارن به ومنه تُنسخ مدخلات التقييم التجريبي
  NameAr            str(200)  req
  Note              str(1000)
  Status            enum{DRAFT,BUILT,CHOSEN,DISCARDED} req =DRAFT
  ResultStatementId ->fin.FinancialStatement noidx   # القائمة المسودة التي يكتبها البناء
  TrialAssessmentId ->fin.CreditAssessment noidx     # التقييم التجريبي للقائمة الناتجة
  IsConvertible     bool                 # كل خطوة بمستند مؤرخ في نهاية الفترة أو قبلها
  BalanceGap        money                # فرق التوازن بعد الخطوات (صفر)
  BuiltAt           ts
  PreparedBy        ->sec.AppUser req
  ChosenBy          ->sec.AppUser
  ChosenOn          ts
  ChoiceReason      str(1000)            # لماذا اختيرت هذه النسخة (إلزامي عند الاختيار، ADR 0029)
  unique PublicId
  unique ResultStatementId where ResultStatementId IS NOT NULL
  index  SourceStatementId,Status
  check  Status IN ('DRAFT','DISCARDED') OR (ResultStatementId IS NOT NULL AND BuiltAt IS NOT NULL AND IsConvertible IS NOT NULL)
  check  Status <> 'CHOSEN' OR (ChosenBy IS NOT NULL AND ChosenOn IS NOT NULL AND IsConvertible = 1 AND ChoiceReason IS NOT NULL)
  check  ChoiceReason IS NULL OR ChosenBy IS NOT NULL
  check  ChosenBy IS NULL OR ChosenBy <> PreparedBy   # المُعِدّ ≠ من يختار (قرار المالك 34)

table fin.PresentationVersionStep  # A remedy of the methodology the company chose for a presentation version, in order, with the document that supports it; the amount it moved is written by the build (docs/36 F2, ADR 0023)
  VersionId         ->fin.PresentationVersion req
  StepNo            int       req
  RemedyId          ->fin.CreditRemedy req noidx
  ScalePct          dec(9,4)  req =100   # نسبة ما يُنفذ من الحل
  DocumentId        ->doc.Document noidx  # القرار أو العقد أو الاتفاق الذي يسند الخطوة
  EvidenceDate      date                  # تاريخ المستند
  Justification     str(1000) req
  MovedAmount       money                 # ما نقلته الخطوة؛ يكتبه البناء
  unique VersionId,StepNo
  unique VersionId,RemedyId
  check  ScalePct > 0 AND ScalePct <= 100
  check  (DocumentId IS NULL AND EvidenceDate IS NULL) OR (DocumentId IS NOT NULL AND EvidenceDate IS NOT NULL)
  check  StepNo >= 1

table fin.CreditAssessmentReclass norv  # A row of the reconciliation of the analytical statement: a standard adjustment that moved an amount of a reported line to an analytical bucket; written by fin.usp_ComputeCreditAssessment only (docs/35 section 6)
  AssessmentId      ->fin.CreditAssessment req
  SeqNo             int       req
  AdjCode           ascii(30) req   # ADJ_LEASE, ADJ_EOSB, ADJ_SHL_SUB ...
  LineCode          ascii(40) req
  Bucket            enum{DEBT,ST_DEBT,EQUITY,NOT_CASH,NOT_TNW,NON_CURRENT,EBITDA,INTEREST} req
  Amount            money     req
  TextAr            str(500)  req
  TextEn            str(500)
  unique AssessmentId,SeqNo
  check  SeqNo >= 1

table fin.CreditAssessmentFacility norv  # A facility of the company read from the platform on the assessment date: its limit, outstanding, lender, commitment, expiry and collateral cover, in the statement currency; written by fin.usp_ComputeCreditAssessment only (docs/35 section 10)
  AssessmentId      ->fin.CreditAssessment req
  FacilityId        ->fac.Facility req noidx
  LenderInstitutionId ->ins.Institution noidx   # المقرض صاحب الحصة الأكبر
  CurrencyId        ->ref.Currency req noidx
  RateToStatement   dec(19,8)
  LimitAmount       money      req      # بعملة التسهيل
  OutstandingAmount money      req
  SecuredCover      money      req =0   # تغطية الضمانات المرتبطة بعملة التسهيل
  RecoverableCover  money      req =0   # بعد خصومات أنواع الضمانات
  IsCommitted       bool       req =0
  ExpiryDate        date       req
  IsIncluded        bool       req      # يُستبعد التسهيل بعملة لا سعر لها
  ExclusionReason   str(300)
  LenderDecisionId  ->fac.FacilityLenderDecision noidx   # قرار البنك الفعلي النافذ في تاريخ التقييم، إن وُجد
  LimitAction       enum{MAINTAINED,UNDRAWN_STOPPED,LIMIT_REDUCED,NOT_RENEWED}
  DecidedLimitAmount money               # الحد بعد قرار البنك، بعملة التسهيل
  LenderCostChangeBp int                 # تغيّر الهامش والرسوم معًا
  unique AssessmentId,FacilityId
  check  IsIncluded = 1 OR ExclusionReason IS NOT NULL

table fin.CreditAssessmentRemedy norv  # A remedy the report proposes, with the finding it answers and the grade the pro-forma statement would get; written by fin.usp_ComputeCreditAssessment only (docs/35 section 12)
  AssessmentId      ->fin.CreditAssessment req
  SeqNo             int       req
  RemedyId          ->fin.CreditRemedy req noidx
  TriggerCode       ascii(40) req
  TriggerLevel      enum{MODERATE,ELEVATED,HIGH,CRITICAL,ADJUSTMENT} req
  MovedAmount       money             # ما نقلته خطوات الحل
  ProFormaScore     dec(9,4)
  ProFormaGradeId   ->fin.RatingGrade noidx
  NotchesGained     int               # درجات الرتبة التي يكسبها الحل
  unique AssessmentId,SeqNo
  unique AssessmentId,RemedyId
  check  SeqNo >= 1
  check  (ProFormaGradeId IS NULL AND NotchesGained IS NULL) OR (ProFormaGradeId IS NOT NULL AND NotchesGained IS NOT NULL)

table fin.CompanyProductLine public  # A product or service line of a company for a fiscal year: its category, share of revenue and of inventory, and its sales channels; read by the credit assessment for the quality of cash flows and the liquidity of the inventory (docs/35 section 5)
  CompanyId         ->org.Company req
  FiscalYear        int       req
  NameAr            str(200)  req
  ProductCategoryId ->fin.ProductCategory req noidx
  RevenueSharePct   dec(9,4)  req
  InventorySharePct dec(9,4)  req =0
  CashSalesPct      dec(9,4)  req =0
  GovernmentSalesPct dec(9,4) req =0
  ExportSalesPct    dec(9,4)  req =0
  TypicalCreditDays int       req =0
  index  CompanyId,FiscalYear
  check  RevenueSharePct BETWEEN 0 AND 100 AND InventorySharePct BETWEEN 0 AND 100
  check  CashSalesPct + GovernmentSalesPct + ExportSalesPct <= 100 AND CashSalesPct >= 0 AND GovernmentSalesPct >= 0 AND ExportSalesPct >= 0
  check  TypicalCreditDays BETWEEN 0 AND 720
  check  FiscalYear BETWEEN 1900 AND 2200

table fin.CreditAssessmentBureau deletable  # The company's SIMAH commercial credit report the analyst read: exposure at all lenders, payment behaviour, defaults, bounced cheques, judgments (docs/35 section 10); changes only while the assessment is a draft
  AssessmentId      ->fin.CreditAssessment req
  ReportDate        date       req
  DocumentId        ->doc.Document req
  TotalLimits       money      req   # بعملة القائمة
  TotalOutstanding  money      req
  LenderCount       int        req
  WorstDpd12m       int        req =0   # أسوأ أيام تأخر في 12 شهرًا
  WorstDpd24m       int        req =0
  CurrentDefault    bool       req =0   # تعثر قائم أو حساب مشطوب غير مسوّى
  Defaults24mCount  int        req =0
  Defaults24mAmount money      req =0
  BouncedCheques12mCount int   req =0
  BouncedCheques12mAmount money req =0
  JudgmentsCount    int        req =0
  JudgmentsAmount   money      req =0
  Inquiries6m       int        req =0
  Restructured      bool       req =0
  unique AssessmentId
  check  TotalLimits >= 0 AND TotalOutstanding >= 0 AND LenderCount >= 0
  check  WorstDpd12m >= 0 AND WorstDpd24m >= WorstDpd12m
  check  Defaults24mCount >= 0 AND Defaults24mAmount >= 0 AND BouncedCheques12mCount >= 0 AND BouncedCheques12mAmount >= 0 AND JudgmentsCount >= 0 AND JudgmentsAmount >= 0 AND Inquiries6m >= 0

table fin.CreditAssessmentScenario norv  # The assessment recomputed on the statement under each macro scenario, with the stress applied: the grade, the liquidity label and the notches lost; written by fin.usp_ComputeCreditAssessment only (docs/35 section 13)
  AssessmentId      ->fin.CreditAssessment req
  MacroScenarioId   ->fin.MacroScenario req noidx
  RevenuePct        dec(9,4)            # الضغط الذي طُبّق: من شدة المحركات وحساسية النشاط وتعرض البلد والمنطقة
  GrossMarginPp     dec(9,4)
  DsoDays           dec(9,2)
  StLinesWithdrawnPct dec(9,4)
  RateBp            int
  PrivateArLossPct  dec(9,4)
  InventoryWritedownPct dec(9,4)
  UndrawnAvailablePct dec(9,4)
  LenderCostBp      dec(9,2)            # هامش البنك ورسومه على التسهيلات قصيرة الأجل بعد عامل البنك
  CountryMult       dec(5,3)
  RevenueAfter      money
  EbitdaAfter       money
  InventoryValueAfter money
  Score             dec(9,4)
  GradeId           ->fin.RatingGrade noidx
  LiquidityLabel    ascii(5)
  NotchesLost       int
  unique AssessmentId,MacroScenarioId

table fin.CreditAssessmentPlan norv  # A strengthening plan computed for the assessment when the customer asked for one: the grade at its end and whether the balance sheet stayed balanced; written by fin.usp_ComputeCreditAssessment only (docs/35 section 12)
  AssessmentId      ->fin.CreditAssessment req
  PlanId            ->fin.StrengtheningPlan req noidx
  StepCount         int       req
  FinalScore        dec(9,4)  req
  FinalGradeId      ->fin.RatingGrade req noidx
  NotchesGained     int       req
  IsBalanced        bool      req      # الأصول = الخصوم + حقوق الملكية بعد كل خطوة
  unique AssessmentId,PlanId
  check  StepCount >= 1

table fin.CreditAssessmentPlanStep norv  # A step of a strengthening plan: the remedy applied, the amount it moved and the grade after it
  AssessmentId      ->fin.CreditAssessment req
  PlanId            ->fin.StrengtheningPlan req noidx
  StepNo            int       req
  RemedyId          ->fin.CreditRemedy req noidx
  MovedAmount       money     req
  Score             dec(9,4)  req
  GradeId           ->fin.RatingGrade req noidx
  unique AssessmentId,PlanId,StepNo
  check  StepNo >= 1

table fin.CreditAssessmentTrigger norv  # What would move the scorecard grade one notch: the value of a metric at which the weighted score crosses to the grade above or below, the other metrics unchanged (docs/35 section 15)
  AssessmentId      ->fin.CreditAssessment req
  MetricId          ->fin.CreditMetric req noidx
  Direction         enum{UP,DOWN} req
  CurrentValue      dec(19,6) req
  TriggerValue      dec(19,6) req
  Score             dec(9,4)  req
  TargetScore       dec(9,4)  req
  unique AssessmentId,MetricId,Direction
