# =============================================================================
# 10-platform.model — م0 المنصة والاشتراكات (PLT): المخططات plat · sec · aud · doc · cfg
# المصدر: docs/10-detailed-analysis/10-m0-m1-platform-organization.md §4.1 §5.1 §6.1 §8 §9 §11 §12
# قرارات ملزمة: SQL Server 2025 · قاعدة واحدة ومخطط مشترك وعزل صفوف · روابط مركّبة (TenantId, ...)
#   مفاتيح BIGINT IDENTITY (INT للكتالوجات الصغيرة) · PublicId لجذور الـAPI · لا تواريخ زمنية (temporal)
#   أرقام الهوية لا تُخزَّن صريحة (Enc/Mask/Hash) · الواجهة إنجليزية أولًا · النطاق bankfas.com بعنوان فرعي لكل مشترك
# لا يُعرَّف هنا: TenantId، المفتاح <Table>Id، أعمدة التدقيق، RowVersion، PublicId (يضيفها المولّد)
# المراجع الخارجية (يعرّفها غيري): ref.Country · org.Company · org.Department · cat.DocumentType
# =============================================================================

# ============================== المخطط plat: المنصة والاشتراكات ==============================
module PLT-PLAT

table plat.Plan int global   # Subscription plan: a bundle of modules and soft limits (FR-PLT-003/004, Q-PLT-11)
  Code          ascii(30)  req
  NameAr        str(200)   req
  NameEn        str(200)   req
  MaxUsers      int            # حد ناعم: ينبّه ولا يمنع (FR-PLT-004)
  MaxCompanies  int
  MaxStorageGb  int
  IsActive      bool       req =1
  unique Code
  check MaxUsers IS NULL OR MaxUsers > 0
  check MaxCompanies IS NULL OR MaxCompanies > 0
  check MaxStorageGb IS NULL OR MaxStorageGb > 0

table plat.PlanModule global pk=PlanId,ModuleCode   # Modules included in a plan (replaces the Plan.IncludedModules JSON column)
  PlanId      ->plat.Plan req
  ModuleCode  enum{CORE,INSTITUTIONS,FACILITIES,COVENANTS,WORKFLOW,LC_PURCHASE,LC_SALES,REQUESTS,REPORTS} req

table plat.Tenant int global public noapp   # No direct access for the tenant application (it reads its row through plat.v_CurrentTenant); isolation root: the tenant (FR-PLT-001/002/046, BR-PLT-001/002)
  Code             ascii(30)  req   # العنوان الفرعي {Code}.bankfas.com؛ لاتيني وأرقام وشرطة؛ مجمَّد بعد التفعيل (FR-PLT-046)
  NameAr           str(200)   req
  NameEn           str(200)   req
  PlanId           ->plat.Plan req
  Status           enum{TRIAL,ACTIVE,SUSPENDED,CLOSED,ARCHIVED_READ_ONLY} req =TRIAL   # دورة الحياة (BR-PLT-002، §8)
  TrialEndsOn      date             # نهاية التجربة: 30 يومًا افتراضيًا ويمدّدها المشغّل
  HomeCountryId    ->ref.Country req   # الدولة الأم (BR-PTY-005)
  DefaultLanguage  enum{ar,en} req =en   # الإنجليزية الأساس والعربية لاحقًا (FR-PLT-032)
  TimeZone         ascii(64)  req   # تُعرض به الأوقات وتُحسب نافذة العمل (FR-PLT-034)
  CalendarDisplay  enum{GREGORIAN,HIJRI,BOTH} req =GREGORIAN   # FR-PLT-033
  DataRegion       ascii(30)        # إقامة البيانات (Q-PLT-03)
  SuspendedReason  text             # سبب التعليق (إلزامي عند SUSPENDED)
  SuspendedAt      ts               # بداية التعليق: منحة دعم أُنشئت قبله تبقى للقراءة (DOC-F04 §7.4)
  ActivatedAt      ts               # أول تفعيل؛ بعده لا يتغير Code (يُفرض في التطبيق/محفّز)
  ClosedAt         ts               # بدء مهلة التصدير 30 يومًا (BR-PLT-002)
  ArchivedAt       ts               # = ClosedAt + 30 يومًا؛ القراءة فقط بلا كتابة ولا حذف
  unique Code
  unique PublicId
  index Status,TrialEndsOn
  index ClosedAt where Status = 'CLOSED'
  check Code COLLATE Arabic_100_BIN2 NOT LIKE '%[^A-Za-z0-9-]%' AND Code NOT LIKE '-%' AND Code NOT LIKE '%-'
  check Status <> 'TRIAL' OR TrialEndsOn IS NOT NULL
  check Status <> 'SUSPENDED' OR SuspendedReason IS NOT NULL
  check Status <> 'SUSPENDED' OR SuspendedAt IS NOT NULL
  check Status NOT IN ('CLOSED','ARCHIVED_READ_ONLY') OR ClosedAt IS NOT NULL
  check Status <> 'ARCHIVED_READ_ONLY' OR ArchivedAt IS NOT NULL
  check ArchivedAt IS NULL OR (ClosedAt IS NOT NULL AND ArchivedAt >= ClosedAt)

table plat.ReservedSubdomain int global noapp   # Subdomains reserved for the system: www, admin, api, app and others (FR-PLT-046)
  Subdomain  ascii(63) req   # تسمية DNS واحدة؛ رفض Tenant.Code المطابق في التطبيق
  Reason     str(200)
  unique Subdomain
  check Subdomain NOT LIKE '%[^a-z0-9-]%' AND Subdomain NOT LIKE '-%' AND Subdomain NOT LIKE '%-'

table plat.PlatformOperator int global public noapp   # Platform operator account: not readable by the tenant application (tp_app); identity store separate from AppUser (FR-PLT-006)
  Email              str(254)  req
  DisplayName        str(200)
  Role               enum{OPERATOR_ADMIN,OPERATOR_SUPPORT} req
  Status             enum{INVITED,ACTIVE,LOCKED,DISABLED,ARCHIVED} req =INVITED
  PasswordHash       ascii(255) sens=restricted   # تجزئة بطيئة مملّحة (FR-PLT-010)
  PasswordChangedAt  ts
  MfaEnabled         bool      req =0   # MFA إلزامي للمشغّل
  MfaSecretEnc       bin(256)  sens=restricted   # سر TOTP مشفَّر بمفتاح المنصة
  MfaKeyRef          ascii(200)      # مرجع مفتاح المنصة في KMS وإصداره (لا مفتاح مشترك للمشغّلين)
  MfaEnrolledAt      ts
  MfaLastUsedStep    bigint            # آخر خطوة TOTP مقبولة (منع إعادة الاستعمال)
  FailedAttempts     int       req =0
  FirstFailedAt      ts                # بداية نافذة الإخفاقات (15 دقيقة)؛ الخامس يقفل حتى يفك مدير مشغّلين آخر (DOC-S04 §12)
  LockedUntil        ts
  LastLoginAt        ts
  unique Email
  unique PublicId
  check Status NOT IN ('ACTIVE','LOCKED') OR PasswordHash IS NOT NULL
  check Status <> 'ACTIVE' OR MfaEnabled = 1
  check MfaEnabled = 0 OR MfaSecretEnc IS NOT NULL
  check MfaSecretEnc IS NULL OR MfaKeyRef IS NOT NULL
  check MfaSecretEnc IS NULL OR DATALENGTH(MfaSecretEnc) >= 29   # الغلاف: إصدار(1) + nonce(12) + وسم(16) على الأقل (06 §6)
  check FailedAttempts >= 0
  check PasswordHash IS NULL OR PasswordHash LIKE '$argon2id$v=19$m=%,t=%,p=%$%$%'   # Argon2id PHC string (O-01)

table plat.TenantModule global noapp   # Modules enabled per tenant; owned by the platform only: written by platform operators, read by the tenant through a restricted view (DR-01)
  TenantId    ->plat.Tenant req   # المشترك المالك (صريح لأن الجدول عالمي)
  ModuleCode  enum{CORE,INSTITUTIONS,FACILITIES,COVENANTS,WORKFLOW,LC_PURCHASE,LC_SALES,REQUESTS,REPORTS} req
  IsEnabled   bool    req =1       # التعطيل يخفي الوحدة دون حذف بياناتها؛ الاعتماديات (00 §9-ب) في التطبيق
  EnabledAt   ts
  EnabledBy   ->plat.PlatformOperator   # فارغ = تفعيل آلي من الباقة
  unique TenantId,ModuleCode
  check ModuleCode <> 'CORE' OR IsEnabled = 1

table plat.SupportAccessGrant   # Temporary support access, activated by the tenant's account administrator (FR-PLT-007, BR-PLT-017)
  OperatorId  ->plat.PlatformOperator req
  GrantedBy   ->sec.AppUser req
  StartsAt    ts       req
  EndsAt      ts       req   # من ساعة إلى 72 ساعة (الافتراضي 4، BR-PLT-017): قيد في الجدول (DR-15)، وsec.usp_SetSupportContext لا يربط بمنحة أطول؛ ينتهي آليًا
  Reason      str(500) req
  RevokedAt   ts
  RevokedBy   ->sec.AppUser
  index OperatorId,StartsAt
  index EndsAt where RevokedAt IS NULL
  check EndsAt > StartsAt
  check EndsAt >= DATEADD(HOUR, 1, StartsAt) AND EndsAt <= DATEADD(HOUR, 72, StartsAt)   # BR-PLT-017 (DR-15)
  check (RevokedAt IS NULL AND RevokedBy IS NULL) OR (RevokedAt IS NOT NULL AND RevokedBy IS NOT NULL)   # الإلغاء نهائي وبفاعل (043، DR-15)

# One-time links for operators (DOC-S04 section 12, DQ-F07-3): the invitation of a new operator, the first one at
# deployment included, and the set-up again after an administrator's reset. Written only by the procedures in 036.
table plat.OperatorToken global noapp noplat norv   # One-time operator set-up links: password and MFA (FR-PLT-006)
  OperatorId   ->plat.PlatformOperator req
  Purpose      enum{INVITATION,RESET} req
  TokenHash    bin(32)  req sens=restricted   # SHA-256 للرابط؛ لا يُخزَّن الأصل
  ExpiresAt    ts       req   # الدعوة 48 ساعة، والإعادة 24 ساعة
  UsedAt       ts
  RevokedAt    ts
  SentTo       str(254)       # البريد الذي أُرسل إليه الرابط
  RequestedBy  ->plat.PlatformOperator   # فارغ للمشغّل الأول عند النشر
  unique TokenHash
  index OperatorId,Purpose where UsedAt IS NULL AND RevokedAt IS NULL

# Operator sessions (DOC-S04 section 12, DQ-S04-10): written only by the operator login procedures (036), like
# sec.UserSession for tenant users. Neither application role reads or writes it.
table plat.OperatorSession global noapp noplat norv deletable   # Platform operator sessions: 15-minute idle and 8-hour absolute timeout (FR-PLT-006)
  OperatorId         ->plat.PlatformOperator req
  TokenHash          bin(32)  req sens=restricted   # SHA-256 لمعرّف الجلسة؛ لا يُخزَّن الأصل
  LastSeenAt         ts       req =SYSUTCDATETIME()
  IdleExpiresAt      ts       req
  AbsoluteExpiresAt  ts       req
  MfaVerifiedAt      ts
  IpAddress          ascii(45)
  UserAgent          str(400)
  EndedAt            ts
  EndReason          enum{LOGOUT,TERMINATED_BY_ADMIN,MFA_FAILED,OPERATOR_DISABLED,OPERATOR_RESET}
  unique TokenHash
  index OperatorId,AbsoluteExpiresAt where EndedAt IS NULL
  check (EndedAt IS NULL AND EndReason IS NULL) OR (EndedAt IS NOT NULL AND EndReason IS NOT NULL)

# ============================== المخطط sec: المستخدمون والأدوار والجلسات والمفاتيح ==============================
module PLT-SEC

table sec.AppUser public   # Tenant portal user (FR-PLT-010..016, BR-PLT-004..006)
  Email                str(254)  req
  DisplayNameAr        str(200)
  DisplayNameEn        str(200)
  DepartmentId         ->org.Department
  LineManagerUserId    ->sec.AppUser   # المدير المباشر: يُستعمل لتحديد «المدير» في الموافقات (13)
  CompanyScopeMode     enum{ALL,SELECTED} req =SELECTED   # SELECTED = الرفض هو الأصل (FR-PLT-021)
  PreferredLanguage    enum{ar,en}      # فارغ = DefaultLanguage للمشترك؛ تقرؤه 13 (FR-NTF-024)
  DigitsPreference     enum{WESTERN,ARABIC_INDIC}   # فارغ = تفضيل المشترك (Q-PLT-07)
  Status               enum{INVITED,ACTIVE,LOCKED,DISABLED,ARCHIVED} req =INVITED   # §8
  IsSystemUser         bool      req =0   # حساب خدمة للمشترك (المهام والتكامل ومحرّك الإشعارات)؛ يُنشأ عند التهيئة؛ بلا كلمة مرور ولا دخول تفاعلي (BR-PLT-004)
  PasswordHash         ascii(255) sens=restricted   # تجزئة بطيئة مملّحة؛ فارغ حتى إكمال الدعوة
  PasswordChangedAt    ts
  MfaEnabled           bool      req =0   # إعادة تعيين MFA تصفّره وتجبر على إعادة التسجيل (BR-PLT-006)
  MfaSecretEnc         bin(256)  sens=restricted   # سر TOTP مشفَّر بمفتاح المشترك
  MfaKeyPurpose        enum{DATA} req =DATA   # غرض المفتاح الذي شُفِّر به السر (ثابت؛ يُطابَق بالمفتاح المركّب)
  MfaKeyId             ->sec.TenantKey via=MfaKeyPurpose>Purpose noidx   # مفتاح DATA الذي شُفِّر به سر MFA (DR-02)
  MfaEnrolledAt        ts
  MfaLastUsedStep      bigint            # آخر خطوة TOTP مقبولة (منع إعادة الاستعمال)
  FailedAttempts       int       req =0   # 5 خلال 15 دقيقة تقفل (BR-PLT-005)
  FirstFailedAt        ts                # بداية نافذة المحاولات الفاشلة
  LockedUntil          ts
  LockoutCount         int       req =0   # عدد القفلات في نافذة 24 ساعة؛ الثالثة تحتاج فك المدير
  LastLockoutAt        ts
  RequiresAdminUnlock  bool      req =0
  LastLoginAt          ts
  ArchivedAt           ts
  unique Email
  unique PublicId
  index Status
  index LockedUntil where Status = 'LOCKED'
  check LineManagerUserId IS NULL OR LineManagerUserId <> AppUserId
  check DisplayNameAr IS NOT NULL OR DisplayNameEn IS NOT NULL
  check IsSystemUser = 1 OR Status NOT IN ('ACTIVE','LOCKED') OR PasswordHash IS NOT NULL   # حساب الخدمة معفى
  check MfaEnabled = 0 OR MfaSecretEnc IS NOT NULL
  check MfaSecretEnc IS NULL OR MfaKeyId IS NOT NULL
  check MfaSecretEnc IS NULL OR DATALENGTH(MfaSecretEnc) >= 29
  check IsSystemUser = 0 OR (PasswordHash IS NULL AND MfaEnabled = 0)   # حساب الخدمة بلا دخول تفاعلي
  check Status <> 'ARCHIVED' OR ArchivedAt IS NOT NULL
  check Status <> 'LOCKED' OR LockedUntil IS NOT NULL OR RequiresAdminUnlock = 1
  check FailedAttempts >= 0 AND LockoutCount >= 0
  check PasswordHash IS NULL OR PasswordHash LIKE '$argon2id$v=19$m=%,t=%,p=%$%$%'   # Argon2id PHC string (O-01)

table sec.Role public   # Role defined by the tenant or seeded (FR-PLT-018)
  Code         ascii(50)  req
  NameAr       str(200)   req
  NameEn       str(200)   req
  Description  text
  IsSystem     bool       req =0   # دور نظام مبذور (TM · FO · TA…)
  IsActive     bool       req =1
  SeedKey      ascii(80)         # للمبذور: يُحدَّث دون إلغاء تعديلات المشترك (FR-PLT-008)
  unique Code
  unique PublicId
  unique SeedKey where SeedKey IS NOT NULL
  check IsSystem = 0 OR SeedKey IS NOT NULL

table sec.Permission int global   # Permission catalogue owned by the platform; a tenant cannot add a permission (FR-PLT-017)
  Code              ascii(100) req   # مثل party.identity.reveal — بنصها الحرفي
  ModuleCode        enum{CORE,INSTITUTIONS,FACILITIES,COVENANTS,WORKFLOW,LC_PURCHASE,LC_SALES,REQUESTS,REPORTS} req
  NameAr            str(200)   req
  NameEn            str(200)   req
  Description       str(500)
  IsSensitive       bool       req =0
  LockedToRoleCodes json              # مثل ["TM","FO"]: الأدوار الوحيدة التي يجوز إسنادها إليها (BR-PLT-019)
  IsActive          bool       req =1
  unique Code
  index ModuleCode
  check LockedToRoleCodes IS NULL OR IsSensitive = 1

table sec.RolePermission pk=RoleId,PermissionId norv deletable   # Role–permission link; a locked permission goes only to the system roles it names, enforced by sec.TR_RolePermission_Locked (043, BR-PLT-019, DR-16)
  RoleId        ->sec.Role req
  PermissionId  ->sec.Permission req
  AssignedBy    ->sec.AppUser
  AssignedAt    ts req =SYSUTCDATETIME()

table sec.UserRole pk=UserId,RoleId norv deletable   # User–role link; permissions are the union of the roles (BR-PLT-007, FR-PLT-018)
  UserId      ->sec.AppUser req
  RoleId      ->sec.Role req
  AssignedBy  ->sec.AppUser
  AssignedAt  ts req =SYSUTCDATETIME()

table sec.UserCompanyScope pk=UserId,CompanyId deletable   # Companies a user can see; ignored when CompanyScopeMode = ALL (FR-PLT-020)
  UserId              ->sec.AppUser req
  CompanyId           ->org.Company req
  IncludeDescendants  bool req =0

table sec.LoginAttempt append deletable   # Login attempts for rate limiting and lockout windows (BR-PLT-005); written by sec.usp_StartSession. A permanent trace in aud.AuditLog is not written yet (O-24)
  UserId     ->sec.AppUser            # فارغ لبريد غير موجود (رسالة موحّدة لا تكشف الوجود)
  LoginName  str(200)                 # البريد المُدخل كما كُتب
  Outcome    enum{LOGIN_SUCCESS,FAILED_PASSWORD,DENIED_LOCKED,DENIED_TENANT,FAILED_MFA,LOCKOUT} req
  IpAddress  ascii(45)                # تقييد المعدل لكل عنوان IP
  UserAgent  str(400)
  index IpAddress,CreatedAt
  index UserId,CreatedAt
  index CreatedAt
  check UserId IS NOT NULL OR LoginName IS NOT NULL

# The journal of the schema changes applied to this database (DOC-B11 section 6, ADR 0034): the deployment of
# db/deploy.sql as the BASELINE, each versioned script of db/migrations once, and each run of the repeatable scripts.
# Written only by tools/deploy/migrate.sh as the deployment login; no role reads or writes it.
table plat.SchemaMigration global noapp noplat norv   # Journal of the schema scripts applied to this database (DOC-B11 section 6)
  Version      ascii(60) req   # BASELINE · V0001 … for a versioned script · R for a run of the repeatable scripts
  Kind         enum{BASELINE,VERSIONED,REPEATABLE} req
  ScriptName   str(260)  req   # the file, or the deployment bundle for the baseline
  Checksum     bin(32)   req   # SHA-256 of the file (of the bundle for the baseline and the repeatable run)
  Fingerprint  bin(32)   req   # plat.fn_SchemaFingerprint() after the step
  AppliedAt    ts        req =SYSUTCDATETIME()
  AppliedBy    str(128)  req
  DurationMs   int
  unique Version where Kind <> 'REPEATABLE'
  index Kind,AppliedAt
  check (Kind = 'BASELINE' AND Version = 'BASELINE') OR (Kind = 'VERSIONED' AND Version LIKE 'V[0-9][0-9][0-9][0-9]') OR (Kind = 'REPEATABLE' AND Version = 'R')
  check DurationMs IS NULL OR DurationMs >= 0

# Binds a database connection (@@SPID) to one tenant and user. Written only by sec.usp_SetSessionContext (O-16);
# read only inside the row filters (rls.fn_Bound). No tenant column, so it is outside the tenant filter rule.
table sec.SessionBinding global noapp noplat noaudit norv pk=SessionId   # Connection binding for the row filters (O-16)
  SessionId      int                   req   # @@SPID of the connection
  BoundTenantId  ->plat.Tenant         req noidx   # tenant named by the context procedure
  BoundUserId    bigint                req   # user named by the context procedure; no foreign key (sec.AppUser is tenant-owned)
  BindingToken   guid                  req   # random per binding; the row filters also require SESSION_CONTEXT(N'BindingToken') to match
  BoundAt        ts                    req =SYSUTCDATETIME()
  BindingKind    enum{USER,JOB,SUPPORT} req =USER   # USER: sec.usp_SetSessionContext; JOB: sec.usp_SetJobContext; SUPPORT: sec.usp_SetSupportContext (DQ-F04-4, DQ-F04-6)
  BoundOperatorId ->plat.PlatformOperator noidx   # the operator of a SUPPORT binding; revoked with the grant or the operator session
  check (BindingKind = 'SUPPORT' AND BoundOperatorId IS NOT NULL) OR (BindingKind <> 'SUPPORT' AND BoundOperatorId IS NULL)

table sec.UserSession norv deletable   # User sessions: 30-minute idle timeout and 12-hour absolute timeout (FR-PLT-014)
  UserId             ->sec.AppUser req
  TokenHash          bin(32)  req sens=restricted   # SHA-256 لمعرّف الجلسة؛ لا يُخزَّن الأصل
  LastSeenAt         ts       req =SYSUTCDATETIME()
  IdleExpiresAt      ts       req
  AbsoluteExpiresAt  ts       req
  MfaVerifiedAt      ts
  IpAddress          ascii(45)
  UserAgent          str(400)
  EndedAt            ts
  EndReason          enum{LOGOUT,IDLE_TIMEOUT,ABSOLUTE_TIMEOUT,TERMINATED_BY_ADMIN,PASSWORD_CHANGED,MFA_RESET,MFA_FAILED,USER_DISABLED,TENANT_SUSPENDED}
  EndedBy            ->sec.AppUser   # المدير الذي أنهى الجلسة
  unique TokenHash
  index UserId,AbsoluteExpiresAt where EndedAt IS NULL
  index AbsoluteExpiresAt
  check (EndedAt IS NULL AND EndReason IS NULL) OR (EndedAt IS NOT NULL AND EndReason IS NOT NULL)

table sec.MfaRecoveryCode norv deletable   # Ten single-use recovery codes, stored hashed (FR-PLT-011, BR-PLT-006); replaces the AppUser.RecoveryCodesHash JSON
  UserId    ->sec.AppUser req
  CodeHash  bin(32) req sens=restricted
  UsedAt    ts               # الاستهلاك يلغيه ويُنبَّه المستخدم بالعدد الباقي
  UsedIp    ascii(45)
  unique UserId,CodeHash
  index UserId where UsedAt IS NULL

table sec.UserToken norv deletable   # Single-use invitation link (48 hours), password-reset token (30 minutes) or MFA re-enrolment link (24 hours) (FR-PLT-013, DQ-F03-8)
  UserId               ->sec.AppUser req
  Purpose              enum{INVITATION,PASSWORD_RESET,MFA_REENROLMENT} req
  TokenHash            bin(32) req sens=restricted   # الرابط مُجزَّأ في القاعدة ولا يحمل بيانات مقيّدة
  ExpiresAt            ts      req
  UsedAt               ts
  RevokedAt            ts
  SentTo               str(254)       # البريد وقت الإصدار
  SendStatus           enum{PENDING,SENT,FAILED} req =PENDING   # فشل الإرسال يُسجَّل في التدقيق
  SendError            str(500)
  RequestedByUserId    ->sec.AppUser   # الداعي؛ فارغ لإعادة تعيين ذاتية
  RequestIp            ascii(45)
  unique TokenHash
  index UserId,Purpose where UsedAt IS NULL AND RevokedAt IS NULL
  index ExpiresAt

table sec.UserPasswordHistory append deletable   # Last five passwords, to prevent reuse (BR-PLT-004)
  UserId        ->sec.AppUser req
  PasswordHash  ascii(255) req sens=restricted
  index UserId,CreatedAt
  check PasswordHash LIKE '$argon2id$v=19$m=%,t=%,p=%$%$%'   # Argon2id PHC string (O-01)

table sec.ExternalIdentity   # Link between an external OIDC or Entra identity and a user; readiness only (FR-PLT-015, section 11)
  UserId    ->sec.AppUser req
  Provider  enum{OIDC,ENTRA_ID} req
  Issuer    ascii(300) req
  Subject   str(200)   req   # مطالبة sub
  IsActive  bool       req =1
  LastLoginAt ts
  unique Issuer,Subject
  unique UserId,Provider,Issuer

table sec.TenantKey   # Tenant key register; each key is wrapped by a master key held outside the database (FR-PLT-037, BR-PLT-015)
  Purpose        enum{DATA,BLIND_INDEX,FILE} req   # DATA أعمدة مشفّرة · BLIND_INDEX فهرس HMAC · FILE ملفات المخزن
  KeyVersion     int       req
  Status         enum{PENDING,ACTIVE,RETIRING,RETIRED,REVOKED} req =PENDING   # ACTIVE للكتابة؛ RETIRING أثناء إعادة التشفير
  Algorithm      ascii(30) req =AES-256-GCM
  WrappedKey     bin(512)  req sens=restricted   # لا مادة مفتاح صريحة أبدًا
  MasterKeyRef   ascii(200) req   # معرّف المفتاح الرئيسي في المخزن المنفصل
  ActivatedAt    ts
  RetiredAt      ts
  unique Purpose,KeyVersion
  unique Purpose where Status = 'ACTIVE'
  check KeyVersion >= 1
  check Status NOT IN ('ACTIVE','RETIRING','RETIRED') OR ActivatedAt IS NOT NULL   # DR-02: دورة الحياة لها تواريخ
  check Status <> 'RETIRED' OR RetiredAt IS NOT NULL

table sec.KeyEvent append   # Key event log: create, rotate and revoke (FR-PLT-037; high severity BR-PLT-009)
  TenantKeyId  ->sec.TenantKey
  EventType    enum{CREATED,ACTIVATED,ROTATION_STARTED,ROTATION_COMPLETED,RETIRED,REVOKED,UNWRAP_FAILED,MASTER_KEY_CHANGED,BACKUP_VERIFIED} req
  ActorType    enum{USER,OPERATOR,SYSTEM,JOB} req =SYSTEM
  ActorId      guid           # PublicId للمستخدم أو المشغّل
  Result       enum{SUCCESS,FAILED} req =SUCCESS
  Detail       text
  CorrelationId guid
  index EventType,CreatedAt

# ============================== المخطط aud: التدقيق ==============================
module PLT-AUD

table aud.AuditLog mixed append   # Append-only audit log; NULL TenantId = platform event, not visible to any tenant; dedicated RLS policy (BR-PLT-001, BR-PLT-009)
  ChainSeq       bigint            # تسلسل السلسلة لكل مشترك أو للمنصة؛ يكتبه aud.TR_AuditLog_Chain عند الإدراج (055، FR-PLT-025)
  OccurredAt     ts        req
  ActorType      enum{USER,OPERATOR,SYSTEM,JOB} req
  ActorId        guid              # PublicId للمستخدم أو المشغّل؛ فارغ لمحاولة ببريد غير موجود
  Action         ascii(60) req     # مثل LOGIN_SUCCESS · IDENTITY_REVEAL · AUDIT_VIEWED
  Category       enum{SECURITY,CONFIG,TREASURY,IDENTITY_ACCESS,PLATFORM,SYSTEM} req =SYSTEM   # يقيّد audit.view.treasury (BR-PLT-008)
  Severity       enum{INFO,HIGH} req =INFO
  EntityType     ascii(60)         # قيمة لا مفتاح أجنبي
  EntityId       bigint
  CompanyId      bigint
  BeforeJson     json              # القيم المقيّدة مقنَّعة أبدًا غير مكشوفة (FR-PLT-023)
  AfterJson      json
  CorrelationId  guid
  IpAddress      ascii(45)
  UserAgent      str(400)
  Result         enum{SUCCESS,DENIED,FAILED} req =SUCCESS
  PrevHash       bin(32)           # بصمة السابق لنفس المشترك (BR-PLT-009)
  RowHash        bin(32)           # SHA-256(PrevHash ‖ ChainSeq ‖ تمثيل قانوني للصف)، aud.fn_AuditRowHash (055)
  unique ChainSeq where ChainSeq IS NOT NULL
  index OccurredAt
  index EntityType,EntityId
  index ActorId,OccurredAt
  index Action,OccurredAt
  index Category,OccurredAt
  index CompanyId,OccurredAt where CompanyId IS NOT NULL
  index CorrelationId where CorrelationId IS NOT NULL

table aud.SensitiveAccessLog append   # Access log for sensitive data: identity reveals, image views, exports and restricted downloads; flags anomalies above 20 per hour (BR-PTY-009)
  OccurredAt         ts        req
  AccessKind         enum{IDENTITY_REVEAL,IDENTITY_IMAGE_VIEW,SENSITIVE_DOCUMENT_DOWNLOAD,PACK_EXPORT,SENSITIVE_EXPORT,DATA_EXPORT,CUSTOM_FIELD_REVEAL} req
  ActorType          enum{USER,OPERATOR,SYSTEM} req =USER
  ActorUserId        ->sec.AppUser
  OperatorId         ->plat.PlatformOperator   # جلسة دعم تحاول الكشف: تُرفض وتُسجَّل (FR-PLT-007)
  SubjectEntityType  ascii(60) req   # IdentityDocument · Document · DataExportJob…
  SubjectEntityId    bigint    req
  SubjectPartyId     bigint            # صاحب الرقم؛ قيمة لا مفتاح أجنبي لتبقى بعد الدمج
  CompanyId          bigint            # قيمة لا مفتاح أجنبي، كما في aud.AuditLog: يبقى السجل بعد حذف الشركة أو دمجها
  Result             enum{GRANTED,DENIED} req
  DenyReason         ascii(40)         # NO_PERMISSION · SUPPORT_SESSION · OUT_OF_SCOPE · TENANT_STATE
  Reason             str(300)          # سبب الكشف إن فعّله المشترك (Q-PTY-05)
  IpAddress          ascii(45)
  UserAgent          str(400)
  CorrelationId      guid
  AuditLogId         ->aud.AuditLog req sametenant   # الحدث المقابل في AuditLog للمشترك نفسه: كل وصول، مسموحًا أو مرفوضًا، له حدثه (BR-PTY-009، DR-12)
  index ActorUserId,OccurredAt
  index SubjectPartyId,OccurredAt where SubjectPartyId IS NOT NULL
  index AccessKind,OccurredAt
  index SubjectEntityType,SubjectEntityId
  check ActorType <> 'USER' OR ActorUserId IS NOT NULL
  check ActorType <> 'OPERATOR' OR OperatorId IS NOT NULL
  check Result = 'GRANTED' OR DenyReason IS NOT NULL

# The hash chain of aud.AuditLog (FR-PLT-025, DOC-S12 section 5.3, ADR 0033): one chain per tenant and one for the
# platform events (ChainKey 0). Written only by the chain trigger and procedures of 055; no role reads or writes them.
table aud.AuditChainHead global noapp noplat noaudit norv pk=ChainKey   # Head of each audit hash chain: its last sequence number and hash (FR-PLT-025)
  ChainKey   int      req   # TenantId of the chain, or 0 for the platform events; a value, not a foreign key
  LastSeq    bigint   req
  LastHash   bin(32)  req
  check ChainKey >= 0
  check LastSeq >= 1

table aud.AuditChainAnchor global noapp noplat append   # Anchor of an audit chain: its head at a moment, also kept outside the database (DOC-S12 section 5.3)
  ChainKey   int      req   # TenantId, or 0 for the platform events
  ChainSeq   bigint   req
  RowHash    bin(32)  req
  TakenAt    ts       req =SYSUTCDATETIME()
  StoreRef   str(400)       # where the copy outside the database is kept (a write-once object or file)
  index ChainKey,ChainSeq
  check ChainSeq >= 1

# ============================== المخطط doc: مخزن المستندات ==============================
module PLT-DOC

table doc.Document public   # Logical document: document data and status; the file itself is in doc.DocumentVersion (FR-PLT-027/028, BR-PLT-011)
  DocumentTypeId        ->cat.DocumentType req   # يحمل RequiresExpiry وIsSensitive وAllowedMime وMaxSizeMb (11)
  Title                 str(200)  req
  DocumentNumber        str(100)
  IssueDate             date
  IssueDateHijriText    str(20)          # النص الهجري كما في الوثيقة (BR-PLT-012)
  ExpiryDate            date
  ExpiryDateHijriText   str(20)
  IssuingAuthority      str(200)
  OwnerCompanyId        ->org.Company    # مالك النطاق للرؤية (BR-PLT-007)؛ الربط بأي كيان عبر DocumentLink
  Sensitivity           enum{PUBLIC,INTERNAL,CONFIDENTIAL,RESTRICTED} req =CONFIDENTIAL   # RESTRICTED إن كان النوع IsSensitive (قادح في 043، DR-18)؛ PUBLIC لمستندات المنصة لا المشترك (DQ-S06-5)
  Status                enum{ACTIVE,SUPERSEDED,SOFT_DELETED} req =ACTIVE
  CurrentVersionId      ->doc.DocumentVersion via=DocumentId   # إصدار من المستند نفسه (DR-18)
  SupersededByDocumentId ->doc.Document
  DeletedAt             ts
  DeletedBy             ->sec.AppUser
  DeleteReason          str(500)         # الحذف منطقي بسبب وصلاحية (BR-PLT-011)
  unique PublicId
  index Status,ExpiryDate
  index DocumentNumber where DocumentNumber IS NOT NULL
  index ExpiryDate where Status = 'ACTIVE' AND ExpiryDate IS NOT NULL
  check IssueDate IS NULL OR ExpiryDate IS NULL OR ExpiryDate > IssueDate
  check Status <> 'SUPERSEDED' OR SupersededByDocumentId IS NOT NULL
  check Status <> 'SOFT_DELETED' OR (DeletedAt IS NOT NULL AND DeleteReason IS NOT NULL)
  check SupersededByDocumentId IS NULL OR SupersededByDocumentId <> DocumentId
  check Sensitivity <> 'PUBLIC'   # DQ-S06-5

table doc.DocumentVersion   # Immutable file version; a change creates a new version: the application may update only the scan and integrity columns (043, FR-PLT-027, BR-PLT-011, DR-11)
  DocumentId         ->doc.Document req
  VersionNo          int       req
  StorageKey         ascii(300) req   # مسار في مخزن الملفات المشترك، يبدأ بـ PublicId للمشترك (DOC-S02)؛ فريد على المنصة كلها
  FileName           str(260)
  ContentType        ascii(150)       # يُفحص بالمحتوى لا بالامتداد (FR-PLT-029)
  SizeBytes          bigint    req
  Sha256             bin(32)   req   # يحسبها الخادم من البايتات المستلمة
  KeyPurpose         enum{FILE} req =FILE
  KeyId              ->sec.TenantKey req via=KeyPurpose>Purpose   # مفتاح FILE لتشفير الملف (6.4، DR-02)
  ScanStatus         enum{PENDING,CLEAN,QUARANTINED} req =PENDING   # لا يُنزَّل إلا CLEAN
  ScannedAt          ts
  ScanDetail         str(300)
  IntegrityStatus    enum{UNVERIFIED,OK,MISMATCH,MISSING} req =UNVERIFIED   # فحص السلامة الدوري (FR-PLT-031)
  LastVerifiedAt     ts
  unique DocumentId,VersionNo
  unique global StorageKey   # مخزن واحد للمنصة: مساران متطابقان لمشتركين مستحيلان (DR-11)
  index Sha256
  index ScanStatus where ScanStatus <> 'CLEAN'
  index LastVerifiedAt
  check VersionNo >= 1
  check SizeBytes > 0
  check ScanStatus = 'PENDING' OR ScannedAt IS NOT NULL

table doc.DocumentLink   # Links a document to any entity with a role and a reference page; unlinking is logical (FR-PLT-028)
  DocumentId   ->doc.Document req
  EntityType   ascii(60) req   # قيمة لا مفتاح أجنبي (متعدد الأنواع)
  EntityId     bigint    req
  LinkRole     enum{SOURCE,ATTACHMENT,IMAGE_FRONT,IMAGE_BACK,IMAGE_OTHER} req =ATTACHMENT
  PageRef      str(30)          # الصفحة المرجعية للمصدر
  UnlinkedAt   ts
  UnlinkedBy   ->sec.AppUser
  UnlinkReason str(300)
  unique DocumentId,EntityType,EntityId,LinkRole where UnlinkedAt IS NULL
  index EntityType,EntityId where UnlinkedAt IS NULL
  check (UnlinkedAt IS NULL AND UnlinkedBy IS NULL) OR (UnlinkedAt IS NOT NULL AND UnlinkedBy IS NOT NULL)

# ============================== المخطط cfg: الإعدادات والترقيم والتنبيهات والمهام ==============================
module PLT-CFG

table cfg.SettingDefinition int global   # Setting-key definition with platform minimum and maximum bounds (BR-PLT-018, FR-PLT-043)
  Key              ascii(100) req   # مفتاح محجوز في T-SQL: يُقتبس دائمًا
  ModuleCode       enum{CORE,INSTITUTIONS,FACILITIES,COVENANTS,WORKFLOW,LC_PURCHASE,LC_SALES,REQUESTS,REPORTS} req =CORE
  ValueType        enum{STRING,INT,DECIMAL,BOOL,TIME,DURATION,JSON} req
  DefaultValueJson json       req
  MinValueJson     json              # الحد الأدنى للمنصة؛ الأضعف مرفوض
  MaxValueJson     json
  IsSecurity       bool       req =0   # تغييره يُدقَّق بالقيمتين القديمة والجديدة
  IsTenantEditable bool       req =1
  Description      str(500)
  unique Key

table cfg.TenantSetting   # Tenant settings: security policies, timeouts, thresholds, and work start and end times (FR-PLT-043)
  Key        ascii(100) req   # مفتاح محجوز في T-SQL: يُقتبس دائمًا؛ مفتاح معرَّف في SettingDefinition فقط، وwork.end−work.start بين 4 و12 ساعة (BR-PLT-018)، يفرضهما القادح في 028 (DR-17)
  ValueJson  json       req
  unique Key

table cfg.NumberSequenceDefinition   # Numbering-type definition with a tag-based format, for example {seq:000}-{erp}-{yy} (FR-PLT-026)
  SequenceKey  ascii(50) req   # مثل PROFORMA · REQUEST (BR-ORG-001 يشترط فعّاله)
  Pattern      str(100)  req
  ScopeLevel   enum{TENANT,COMPANY} req =TENANT
  PeriodBasis  enum{CALENDAR_YEAR,FISCAL_YEAR,NONE} req =CALENDAR_YEAR   # BR-PLT-010
  GapPolicy    enum{GAP_FREE,ALLOW_GAPS} req =GAP_FREE   # بلا فجوات للطلبات والبروفورما (Q-PLT-08)
  MinWidth     int
  IsActive     bool      req =1
  SeedKey      ascii(80)
  unique SequenceKey
  unique SeedKey where SeedKey IS NOT NULL
  check PeriodBasis <> 'FISCAL_YEAR' OR ScopeLevel = 'COMPANY'
  check MinWidth IS NULL OR (MinWidth >= 1 AND MinWidth <= 18)

table cfg.NumberSequence   # Counter per (definition, optional company, period); its row is locked on allocation inside the caller's transaction (BR-PLT-010)
  DefinitionId  ->cfg.NumberSequenceDefinition req
  CompanyId     ->org.Company     # فارغ لنطاق المشترك
  PeriodKey     ascii(10) req     # مثل 2026 أو ALL عند NONE
  NextValue     bigint    req =1
  unique DefinitionId,PeriodKey where CompanyId IS NULL
  unique DefinitionId,CompanyId,PeriodKey where CompanyId IS NOT NULL
  check NextValue >= 1

table cfg.NumberIssue   # Issued document numbers; a cancelled number is never reused (FR-PLT-026, BR-PLT-010)
  SequenceId    ->cfg.NumberSequence req
  SeqValue      bigint    req   # قيمة العدّاد المخصَّصة (كشف الفجوات)
  IssuedNumber  str(60)   req
  Status        enum{ISSUED,VOID} req =ISSUED
  VoidReason    text             # إلزامي عند VOID
  VoidedAt      ts
  VoidedBy      ->sec.AppUser
  EntityType    ascii(60)        # الكيان المستخدِم للرقم (قيمة)
  EntityId      bigint
  unique SequenceId,SeqValue
  unique SequenceId,IssuedNumber
  index EntityType,EntityId where EntityType IS NOT NULL
  check (Status = 'ISSUED' AND VoidReason IS NULL AND VoidedAt IS NULL) OR (Status = 'VOID' AND VoidReason IS NOT NULL AND VoidedAt IS NOT NULL)
  check (EntityType IS NULL AND EntityId IS NULL) OR (EntityType IS NOT NULL AND EntityId IS NOT NULL)

table cfg.ExpiryAlertRule   # Expiry alert rule per item type (FR-PLT-038, BR-PLT-013)
  ItemType                 ascii(60) req   # مثل COMPANY_DOCUMENT · IDENTITY_DOCUMENT · BODY_TERM · AUTHORITY_GRANT
  LeadDays                 json      req   # تنازلي مثل [90,60,30,7]
  ScopeByCompany           bool      req =1
  ReminderAfterExpiryDays  int              # تذكير دوري بعد الانتهاء (7 افتراضيًا)
  IsActive                 bool      req =1
  SeedKey                  ascii(80)
  unique ItemType
  unique SeedKey where SeedKey IS NOT NULL
  check ReminderAfterExpiryDays IS NULL OR ReminderAfterExpiryDays > 0

table cfg.ExpiryAlertRuleRole pk=ExpiryAlertRuleId,RoleId norv deletable   # Roles that receive an alert rule's alerts, within the company scope; replaces the RecipientRoles code list, so a renamed or missing role cannot silently receive nothing (FR-PLT-038, DR-16)
  ExpiryAlertRuleId  ->cfg.ExpiryAlertRule req
  RoleId             ->sec.Role req   # دور من المشترك نفسه (مفتاح مركّب)

table cfg.ExpiryAlertLog append   # Log of sent expiry alerts: one event per (item, threshold), never repeated on the same day (FR-PLT-038)
  ExpiryAlertRuleId  ->cfg.ExpiryAlertRule req
  ItemId             bigint req
  ExpiryDate         date   req   # تاريخ الانتهاء وقت الإرسال: التجديد (تاريخ جديد) يعيد ضبط العتبات بلا حذف
  AlertKind          enum{LEAD,EXPIRED,REMINDER} req
  Threshold          int    req =0   # أيام العتبة لـ LEAD؛ 0 لـ EXPIRED؛ رقم التذكير لـ REMINDER
  unique ExpiryAlertRuleId,ItemId,ExpiryDate,AlertKind,Threshold

table cfg.DataExportJob public   # Tenant data export request (FR-PLT-039, BR-PLT-016)
  RequestedBy         ->sec.AppUser req
  RequestedAt         ts   req =SYSUTCDATETIME()
  Scope               enum{FULL,PARTIAL} req =FULL
  ScopeDetailJson     json            # الوحدات والصيغ (JSON/CSV) وتضمين الملفات عند PARTIAL
  IncludesRestricted  bool req =0     # أرقام الهويات والصور: تحتاج موافقة حامل صلاحية الكشف
  ApprovedBy          ->sec.AppUser
  ApprovedAt          ts
  Status              enum{REQUESTED,APPROVED,RUNNING,READY,EXPIRED,FAILED} req =REQUESTED
  StartedAt           ts
  FinishedAt          ts
  ExpiresAt           ts              # READY تنتهي بعد 7 أيام (§8)
  PackageDocumentId   ->doc.Document  # الحزمة المختومة بكلمة يحددها الطالب (لا تُخزَّن الكلمة)
  PackageSha256       bin(32)
  FailureReason       str(500)
  unique PublicId
  index Status,ExpiresAt
  check IncludesRestricted = 0 OR Status = 'REQUESTED' OR ApprovedBy IS NOT NULL   # المقيّد معتمَد في كل حالة بعد الطلب (DR-13)
  check (ApprovedBy IS NULL AND ApprovedAt IS NULL) OR (ApprovedBy IS NOT NULL AND ApprovedAt IS NOT NULL)
  check Status NOT IN ('READY','EXPIRED') OR ExpiresAt IS NOT NULL   # READY تنتهي بعد 7 أيام (§8)
  check Status <> 'READY' OR (PackageDocumentId IS NOT NULL AND PackageSha256 IS NOT NULL)
  check FinishedAt IS NULL OR StartedAt IS NULL OR FinishedAt >= StartedAt

table cfg.NonWorkingDay mixed deletable   # Non-working day; NULL TenantId = platform holiday, read-only (FR-PLT-035, BR-PLT-014)
  CountryId  ->ref.Country req
  OnDate     date      req
  NameAr     str(200)
  NameEn     str(200)
  Kind       enum{HOLIDAY,BRIDGE,OTHER} req =HOLIDAY
  unique CountryId,OnDate
  index OnDate

table cfg.OutboxEvent deletable   # Outbound queue with at-least-once delivery; the payload carries identifiers without restricted data; only DELIVERED events may be deleted (043, FR-PLT-042, DR-14)
  MessageId       guid      req =NEWID()   # مفتاح إزالة التكرار عند المستهلك
  EventName       ascii(100) req   # domain.event_name بحروف صغيرة (00 §5)
  AggregateType   ascii(60)
  AggregateId     bigint
  PayloadJson     json      req
  OccurredAt      ts        req =SYSUTCDATETIME()
  Status          enum{PENDING,PROCESSING,DELIVERED,FAILED,DEAD} req =PENDING
  AttemptCount    int       req =0
  NextAttemptAt   ts
  LockedBy        ascii(60)         # العامل الحاجز
  LockedUntil     ts
  DeliveredAt     ts
  LastError       str(1000)
  CorrelationId   guid
  unique MessageId
  index Status,NextAttemptAt where Status IN ('PENDING','FAILED')
  index EventName,OccurredAt
  index AggregateType,AggregateId
  index LockedUntil where Status = 'PROCESSING'   # استعادة الحجز من عامل متوقف (DR-14)
  check AttemptCount >= 0
  check EventName LIKE '%.%'
  check Status <> 'PROCESSING' OR (LockedBy IS NOT NULL AND LockedUntil IS NOT NULL)
  check Status <> 'DELIVERED' OR DeliveredAt IS NOT NULL
  check Status <> 'DEAD' OR LastError IS NOT NULL

# The closed list of background jobs (DOC-F17 section 5.2, DQ-F17-2) and the tenant statuses each may run in
# (DOC-F04 section 7.4). sec.usp_SetJobContext binds a job connection only for an active TENANT job listed here.
table cfg.JobDefinition int global noapp   # Background job catalogue: the only JobKey values a job connection may bind with (FR-PLT-044)
  JobKey          ascii(80) req
  Scope           enum{TENANT,PLATFORM} req   # PLATFORM: runs without a tenant binding (status transitions, DOC-F05 §6.3)
  RunsInStatuses  set{TRIAL,ACTIVE,SUSPENDED,CLOSED,ARCHIVED_READ_ONLY}   # CLOSED means within 30 days of ClosedAt; empty for PLATFORM
  Description     str(500)
  IsActive        bool      req =1
  unique JobKey
  check Scope = 'PLATFORM' OR RunsInStatuses IS NOT NULL

table cfg.JobRun deletable   # Background job run log: last run, duration and result, visible to the account administrator (FR-PLT-044)
  JobKey        ascii(80) req   # مثل EXPIRY_ALERTS · FILE_INTEGRITY · AUDIT_CHAIN_VERIFY
  TriggerKind   enum{SCHEDULED,MANUAL,RETRY} req =SCHEDULED
  Status        enum{RUNNING,SUCCEEDED,FAILED,CANCELLED} req =RUNNING
  AttemptNo     int       req =1
  StartedAt     ts        req =SYSUTCDATETIME()
  FinishedAt    ts
  DurationMs    int
  NextRetryAt   ts              # إعادة المحاولة خلال ساعة عند الفشل
  ResultSummary str(1000)
  ErrorMessage  str(2000)
  DetailJson    json
  index JobKey,StartedAt
  index NextRetryAt where Status = 'FAILED'
  check AttemptNo >= 1
  check FinishedAt IS NULL OR FinishedAt >= StartedAt
  check (Status = 'RUNNING' AND FinishedAt IS NULL) OR (Status <> 'RUNNING' AND FinishedAt IS NOT NULL)

table cfg.SeedRun append   # Numbered seed-run log per package; re-running a seed adds nothing (FR-PLT-008)
  PackKey              ascii(80) req   # حزمة كل وحدة (ITenantSeeder)
  SeedVersion          int       req
  RunKind              enum{INITIAL,UPGRADE,RERUN} req
  Status               enum{SUCCEEDED,PARTIAL,FAILED} req
  CreatedCount         int       req =0
  UpdatedCount         int       req =0
  SkippedModifiedCount int       req =0   # صفوف عدّلها المشترك فلا تُستبدل ويُعرض الفرق للمراجعة
  DiffJson             json
  StartedAt            ts        req =SYSUTCDATETIME()
  FinishedAt           ts
  index PackKey,SeedVersion
  check SeedVersion >= 1
