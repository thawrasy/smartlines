   "type": "TEXT",
   "seq": 5,
   "validation": {
    "maxLength": 1000
   }
  },
  {
   "key": "customerName",
   "labelAr": "العميل",
   "labelEn": "Customer",
   "type": "TEXT",
   "indexRole": "COUNTERPARTY_NAME",
   "seq": 6
  },
  {
   "key": "notes",
   "labelAr": "ملاحظات",
   "labelEn": "Notes",
   "type": "LONGTEXT",
   "seq": 7,
   "validation": {
    "maxLength": 4000
   }
  }
 ],
 "attachments": [
  {
   "slot": "SALES_DOCUMENTS",
   "labelAr": "مستندات من المبيعات",
   "labelEn": "Documents from the sales",
   "documentType": "OTHER",
   "min": 0,
   "max": 10,
   "visibleToRequester": true
  },
  {
   "slot": "COLLECTION_DOCS_PACKAGE",
   "labelAr": "حزمة مستندات التحصيل",
   "labelEn": "Collection documents package",
   "documentType": "COLLECTION_DOCS_PACKAGE",
   "min": 1,
   "max": 5,
   "requiredBeforeStage": "DOCS_ISSUED",
   "visibleToRequester": true
  }
 ]
}
