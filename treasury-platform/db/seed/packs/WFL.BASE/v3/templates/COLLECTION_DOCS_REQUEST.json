   "seq": 6,
   "assignee": {
    "rule": "REQUESTER"
   },
   "allowRequesterCancel": true
  },
  {
   "key": "COMPLETED",
   "kind": "TERMINAL",
   "nameAr": "مكتمل",
   "nameEn": "Completed",
   "phase": "COMPLETED",
   "seq": 7,
   "outcome": "COMPLETED"
  },
  {
   "key": "REJECTED",
   "kind": "TERMINAL",
   "nameAr": "مرفوض",
   "nameEn": "Rejected",
   "phase": "REJECTED",
   "seq": 8,
   "outcome": "REJECTED"
  },
  {
   "key": "CANCELLED",
   "kind": "TERMINAL",
   "nameAr": "ملغى",
   "nameEn": "Cancelled",
   "phase": "CANCELLED",
   "seq": 9,
   "outcome": "CANCELLED"
  }
 ],
