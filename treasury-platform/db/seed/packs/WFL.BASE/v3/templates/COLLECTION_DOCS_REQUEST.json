   "priority": 1,
   "requiresComment": true
  },
  {
   "from": "TREASURY_QUEUE",
   "action": "COMPLETE",
   "to": "EXECUTION",
   "priority": 1
  },
  {
   "from": "EXECUTION",
   "action": "COMPLETE",
   "to": "DOCS_ISSUED",
   "priority": 1
  },
  {
