   "required": true,
   "seq": 2,
   "config": {
    "component": "lc.collection_docs"
   },
   "editableStages": [
    "DRAFT",
    "RETURNED"
   ]
  },
  {
   "key": "amount",
   "labelAr": "مبلغ المستندات",
   "labelEn": "Documents amount",
   "type": "AMOUNT",
   "required": true,
   "indexRole": "AMOUNT",
   "seq": 3
  },
  {
   "key": "shipmentDate",
   "labelAr": "تاريخ الشحن",
   "labelEn": "Shipment date",
   "type": "DATE",
   "indexRole": "REQUIRED_BY_DATE",
   "seq": 4
  },
  {
   "key": "invoiceRefs",
   "labelAr": "مراجع الفواتير وسندات التسليم",
