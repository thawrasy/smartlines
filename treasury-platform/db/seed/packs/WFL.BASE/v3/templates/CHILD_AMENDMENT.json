    "RETURNED"
   ]
  },
  {
   "key": "amendmentResult",
   "labelAr": "نتيجة التعديل",
   "labelEn": "Amendment result",
   "type": "MODULE_FORM",
   "seq": 10,
   "config": {
    "component": "lc.amendment_result"
   },
   "visibleStages": [
    "AMENDMENT_RESULT"
   ],
   "editableStages": [
    "AMENDMENT_RESULT"
   ]
