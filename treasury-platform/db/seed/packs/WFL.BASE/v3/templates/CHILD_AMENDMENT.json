     "trigger": "ON_ENTER",
     "key": "fac.release_reservation",
     "params": {
      "reason": "CANCELLED"
     }
    }
   ]
  }
 ],
 "transitions": [
  {
   "from": "DRAFT",
   "action": "SUBMIT",
   "to": "APPROVAL",
   "priority": 1
  },
  {
   "from": "APPROVAL",
   "action": "APPROVE",
   "to": "TM_APPROVAL",
   "priority": 1,
   "condition": {
    "any": [
     {
      "field": "amountDelta",
      "op": "gt",
      "value": 0
     },
     {
      "field": "kind",
      "op": "eq",
      "value": "CANCEL"
     }
    ]
   }
  },
  {
   "from": "APPROVAL",
   "action": "APPROVE",
   "to": "TREASURY_QUEUE",
   "priority": 2
  },
  {
   "from": "APPROVAL",
   "action": "RETURN",
   "to": "RETURNED",
   "priority": 1,
   "resume": "APPROVAL",
   "requiresComment": true
  },
  {
   "from": "APPROVAL",
   "action": "REJECT",
   "to": "REJECTED",
   "priority": 1,
   "requiresComment": true
  },
  {
   "from": "TM_APPROVAL",
   "action": "APPROVE",
   "to": "TREASURY_QUEUE",
   "priority": 1
  },
  {
   "from": "TM_APPROVAL",
   "action": "RETURN",
   "to": "RETURNED",
   "priority": 1,
   "resume": "APPROVAL",
   "requiresComment": true
  },
  {
   "from": "TM_APPROVAL",
   "action": "REJECT",
   "to": "REJECTED",
   "priority": 1,
   "requiresComment": true
  },
  {
   "from": "TREASURY_QUEUE",
   "action": "COMPLETE",
   "to": "EXECUTION",
   "priority": 1
  },
  {
   "from": "EXECUTION",
   "action": "COMPLETE",
   "to": "AMENDMENT_RESULT",
   "priority": 1
  },
  {
   "from": "AMENDMENT_RESULT",
   "action": "COMPLETE",
   "to": "COMPLETED",
   "priority": 1
  },
  {
   "from": "RETURNED",
   "action": "RESUBMIT",
   "to": "APPROVAL",
   "priority": 1
  }
 ],
