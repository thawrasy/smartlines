# /opt/bankfas/worker.env (docs/54 step H-05): root-only (chmod 600), never in the repository. The worker connects with
# the jobs login only, and sends the outbox mail.
DOTNET_ENVIRONMENT=Production
Database__Server=<DB_HOST>,1433
Database__Logins__Jobs__User=bankfas_jobs_a
Database__Logins__Jobs__SecretFile=/run/secrets/db/bankfas_jobs_a.secret
Portal__Domain=<DOMAIN>
Keys__File__Current=file:<KEY_NAME>
Files__Root=/srv/bankfas/files
Mail__Smtp__Host=<SMTP_HOST>
Mail__Smtp__Port=587
Mail__Smtp__From=<FROM_ADDRESS>
Mail__Smtp__Username=<SMTP_USER>
Mail__Smtp__PasswordFile=/run/secrets/smtp.secret
