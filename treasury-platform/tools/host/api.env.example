# /opt/bankfas/api.env (docs/54 step H-05): root-only (chmod 600), never in the repository. Values between <...> are
# the host's. Secrets are files under /opt/bankfas/secrets, mounted read-only at /run/secrets; none is written here.
ASPNETCORE_ENVIRONMENT=Production
# The database server (docs/54 part B): its name must match its TLS certificate, which the container trusts.
Database__Server=<DB_HOST>,1433
Database__Logins__App__User=bankfas_app_a
Database__Logins__App__SecretFile=/run/secrets/db/bankfas_app_a.secret
Database__Logins__Platform__User=bankfas_platform_a
Database__Logins__Platform__SecretFile=/run/secrets/db/bankfas_platform_a.secret
Database__Logins__Support__User=bankfas_support_a
Database__Logins__Support__SecretFile=/run/secrets/db/bankfas_support_a.secret
# The portals are <code>.<DOMAIN>; the operator panel is admin.<DOMAIN>.
Portal__Domain=<DOMAIN>
Hosts__Operator=admin.<DOMAIN>
# The current master key file /opt/bankfas/secrets/master-keys/<KEY_NAME>.key (docs/54 step H-03).
Keys__File__Current=file:<KEY_NAME>
Files__Root=/srv/bankfas/files
Passwords__BreachedList__Directory=/srv/bankfas/breached
Scanning__Provider=clamav
Scanning__Host=clamav
Scanning__Port=3310
Mail__Smtp__Host=<SMTP_HOST>
Mail__Smtp__Port=587
Mail__Smtp__From=<FROM_ADDRESS>
Mail__Smtp__Username=<SMTP_USER>
Mail__Smtp__PasswordFile=/run/secrets/smtp.secret
