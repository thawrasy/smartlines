{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Security": {
    "TrustedProxies": [
      "127.0.0.1",
      "::1"
    ],
    "GuardEnabled": true,
    "ApiPerMinute": 600,
    "RefusalLimit": 40,
    "RefusalWindowSeconds": 300,
    "BlockMinutes": 30,
    "AlertEmails": []
  }
}
