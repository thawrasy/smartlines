<Project>
  <PropertyGroup>
    <!-- a vulnerable transitive package is lifted here rather than left to the graph (NU1903) -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <!-- One version of each package for the whole application; the latest stable release when it was chosen
       (docs/01 section 13, "the latest GA always"). The lock files pin the resolved graph (DOC-B11 section 4.3). -->
  <ItemGroup>
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <!-- transitive, from Microsoft.Data.SqlClient: 9.0.18 and 10.0.12 have GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7 -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
</Project>
