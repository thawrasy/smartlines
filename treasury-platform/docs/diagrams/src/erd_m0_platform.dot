  "cfg.ExpiryAlertLog" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#DCEBFA" ALIGN="LEFT" COLSPAN="2"><B>cfg.ExpiryAlertLog</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">ExpiryAlertLogId</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">ExpiryAlertRuleId → cfg.ExpiryAlertRule</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 6 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "cfg.ExpiryAlertRule" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#DCEBFA" ALIGN="LEFT" COLSPAN="2"><B>cfg.ExpiryAlertRule</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">ExpiryAlertRuleId</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 11 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "cfg.JobRun" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#DCEBFA" ALIGN="LEFT" COLSPAN="2"><B>cfg.JobRun</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">JobRunId</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 15 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "cfg.NonWorkingDay" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#EADCF8" ALIGN="LEFT" COLSPAN="2"><B>cfg.NonWorkingDay</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">NonWorkingDayId</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">CountryId → ref.Country</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 8 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "cfg.NumberIssue" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#DCEBFA" ALIGN="LEFT" COLSPAN="2"><B>cfg.NumberIssue</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">NumberIssueId</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">SequenceId → cfg.NumberSequence</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">VoidedBy → sec.AppUser</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 11 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "cfg.NumberSequence" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#DCEBFA" ALIGN="LEFT" COLSPAN="2"><B>cfg.NumberSequence</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">NumberSequenceId</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">DefinitionId → cfg.NumberSequenceDefinition</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">CompanyId → org.Company</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 6 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "cfg.NumberSequenceDefinition" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#DCEBFA" ALIGN="LEFT" COLSPAN="2"><B>cfg.NumberSequenceDefinition</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">NumberSequenceDefinitionId</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 12 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "cfg.OutboxEvent" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#DCEBFA" ALIGN="LEFT" COLSPAN="2"><B>cfg.OutboxEvent</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">OutboxEventId</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 18 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "cfg.SeedRun" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#DCEBFA" ALIGN="LEFT" COLSPAN="2"><B>cfg.SeedRun</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">SeedRunId</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 12 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "cfg.SettingDefinition" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#FDE9D9" ALIGN="LEFT" COLSPAN="2"><B>cfg.SettingDefinition</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">SettingDefinitionId</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 13 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "cfg.TenantSetting" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#DCEBFA" ALIGN="LEFT" COLSPAN="2"><B>cfg.TenantSetting</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">TenantSettingId</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 6 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "doc.Document" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#DCEBFA" ALIGN="LEFT" COLSPAN="2"><B>doc.Document</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">DocumentId</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">DocumentTypeId → cat.DocumentType</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">OwnerCompanyId → org.Company</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">CurrentVersionId → doc.DocumentVersion</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">SupersededByDocumentId → doc.Document</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">DeletedBy → sec.AppUser</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 16 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "doc.DocumentLink" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#DCEBFA" ALIGN="LEFT" COLSPAN="2"><B>doc.DocumentLink</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">DocumentLinkId</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">DocumentId → doc.Document</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">UnlinkedBy → sec.AppUser</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 10 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "doc.DocumentVersion" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#DCEBFA" ALIGN="LEFT" COLSPAN="2"><B>doc.DocumentVersion</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">DocumentVersionId</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">DocumentId → doc.Document</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">KeyId → sec.TenantKey</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 15 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "cat.DocumentType" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9AA3AD"><TR><TD BGCOLOR="#EEEEEE"><FONT COLOR="#444444">cat.DocumentType</FONT></TD></TR></TABLE>>];
  "org.Company" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9AA3AD"><TR><TD BGCOLOR="#EEEEEE"><FONT COLOR="#444444">org.Company</FONT></TD></TR></TABLE>>];
