digraph G {
  graph [fontname="DejaVu Sans", fontsize=18, label=<<B>م0 · التدقيق والمستندات والإعدادات</B><BR/><FONT POINT-SIZE="11">17 جدولًا · كل جدول مملوك للمشترك يحمل TenantId · الرمادي = خارج الصورة</FONT>>, labelloc=t, rankdir=LR, nodesep=0.4, ranksep=1.2, pad=0.3, bgcolor="white", splines=true];
  node [shape=plaintext, fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=9, color="#5B6B7A", arrowsize=0.7];
  "aud.AuditLog" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#EADCF8" ALIGN="LEFT" COLSPAN="2"><B>aud.AuditLog</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">AuditLogId</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 20 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "aud.SensitiveAccessLog" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#DCEBFA" ALIGN="LEFT" COLSPAN="2"><B>aud.SensitiveAccessLog</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">SensitiveAccessLogId</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">ActorUserId → sec.AppUser</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">OperatorId → plat.PlatformOperator</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 16 عمودًا آخر</FONT></TD></TR></TABLE>>];
