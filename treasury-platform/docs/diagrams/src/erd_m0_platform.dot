  "doc.Document" -> "doc.DocumentVersion" [label="CurrentVersionId", style=solid];
  "doc.Document" -> "org.Company" [label="OwnerCompanyId", style=solid];
  "doc.Document" -> "sec.AppUser" [label="DeletedBy", style=solid];
  "doc.DocumentLink" -> "doc.Document" [label="DocumentId", style=solid];
  "doc.DocumentLink" -> "sec.AppUser" [label="UnlinkedBy", style=solid];
