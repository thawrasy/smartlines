digraph G {
  graph [fontname="DejaVu Sans", fontsize=18, label=<<B>م5 · الضمانات</B><BR/><FONT POINT-SIZE="11">7 جدولًا · كل جدول مملوك للمشترك يحمل TenantId · الرمادي = خارج الصورة</FONT>>, labelloc=t, rankdir=LR, nodesep=0.4, ranksep=1.2, pad=0.3, bgcolor="white", splines=true];
  node [shape=plaintext, fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=9, color="#5B6B7A", arrowsize=0.7];
  "col.Collateral" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#DCEBFA" ALIGN="LEFT" COLSPAN="2"><B>col.Collateral</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">CollateralId</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">CollateralTypeId → cat.CollateralType</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">OwnerPartyId → pty.Party</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">ApprovedBy → sec.AppUser</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">SupersedesId → col.Collateral</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">ReleaseDocumentId → doc.Document</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">SourceDocumentId → doc.Document</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">VerifiedBy → sec.AppUser</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">ConflictId → fac.ValueConflict</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 20 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "col.CollateralLink" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#DCEBFA" ALIGN="LEFT" COLSPAN="2"><B>col.CollateralLink</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">CollateralLinkId</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">CollateralId → col.Collateral</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">FacilityId → fac.Facility</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">LimitId → fac.Limit</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">SupersedesId → col.CollateralLink</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 10 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "col.Guarantee" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#DCEBFA" ALIGN="LEFT" COLSPAN="2"><B>col.Guarantee</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">GuaranteeId</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">CollateralId → col.Collateral</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">GuarantorPartyId → pty.Party</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">GuarantorIdentityDocumentId → pty.IdentityDocument</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">CurrencyId → ref.Currency</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">DeedDocumentId → doc.Document</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 10 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "col.InsurancePolicyAssignment" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#DCEBFA" ALIGN="LEFT" COLSPAN="2"><B>col.InsurancePolicyAssignment</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">InsurancePolicyAssignmentId</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">CollateralId → col.Collateral</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">AssignedToInstitutionId → ins.Institution</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">CurrencyId → ref.Currency</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">PolicyDocumentId → doc.Document</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 13 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "col.PromissoryNote" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#DCEBFA" ALIGN="LEFT" COLSPAN="2"><B>col.PromissoryNote</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">PromissoryNoteId</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">CollateralId → col.Collateral</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">CurrencyId → ref.Currency</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">NoteDocumentId → doc.Document</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 11 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "col.PromissoryNoteSigner" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#DCEBFA" ALIGN="LEFT" COLSPAN="2"><B>col.PromissoryNoteSigner</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">PromissoryNoteId</TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">PartyId</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 4 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "col.ValuationSchedule" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#DCEBFA" ALIGN="LEFT" COLSPAN="2"><B>col.ValuationSchedule</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">ValuationScheduleId</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">CollateralId → col.Collateral</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">CurrencyId → ref.Currency</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 12 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "cat.CollateralType" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9AA3AD"><TR><TD BGCOLOR="#EEEEEE"><FONT COLOR="#444444">cat.CollateralType</FONT></TD></TR></TABLE>>];
  "doc.Document" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9AA3AD"><TR><TD BGCOLOR="#EEEEEE"><FONT COLOR="#444444">doc.Document</FONT></TD></TR></TABLE>>];
  "fac.Facility" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9AA3AD"><TR><TD BGCOLOR="#EEEEEE"><FONT COLOR="#444444">fac.Facility</FONT></TD></TR></TABLE>>];
  "fac.Limit" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9AA3AD"><TR><TD BGCOLOR="#EEEEEE"><FONT COLOR="#444444">fac.Limit</FONT></TD></TR></TABLE>>];
