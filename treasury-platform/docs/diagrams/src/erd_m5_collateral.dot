  "ins.Institution" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9AA3AD"><TR><TD BGCOLOR="#EEEEEE"><FONT COLOR="#444444">ins.Institution</FONT></TD></TR></TABLE>>];
  "pty.IdentityDocument" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9AA3AD"><TR><TD BGCOLOR="#EEEEEE"><FONT COLOR="#444444">pty.IdentityDocument</FONT></TD></TR></TABLE>>];
  "pty.Party" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9AA3AD"><TR><TD BGCOLOR="#EEEEEE"><FONT COLOR="#444444">pty.Party</FONT></TD></TR></TABLE>>];
  "ref.Currency" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9AA3AD"><TR><TD BGCOLOR="#EEEEEE"><FONT COLOR="#444444">ref.Currency</FONT></TD></TR></TABLE>>];
  "sec.AppUser" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9AA3AD"><TR><TD BGCOLOR="#EEEEEE"><FONT COLOR="#444444">sec.AppUser</FONT></TD></TR></TABLE>>];
  "col.Collateral" -> "cat.CollateralType" [label="CollateralTypeId", style=solid];
  "col.Collateral" -> "col.Collateral" [label="SupersedesId", style=solid];
  "col.Collateral" -> "doc.Document" [label="ReleaseDocumentId", style=solid];
  "col.Collateral" -> "doc.Document" [label="SourceDocumentId", style=solid];
  "col.Collateral" -> "fac.ValueConflict" [label="ConflictId", style=solid];
