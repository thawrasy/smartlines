  "col.Collateral" -> "sec.AppUser" [label="ApprovedBy", style=solid];
  "col.Collateral" -> "sec.AppUser" [label="VerifiedBy", style=solid];
  "col.CollateralLink" -> "col.Collateral" [label="CollateralId", style=solid];
  "col.CollateralLink" -> "col.CollateralLink" [label="SupersedesId", style=solid];
  "col.CollateralLink" -> "fac.Facility" [label="FacilityId", style=solid];
  "col.CollateralLink" -> "fac.Limit" [label="LimitId", style=solid];
