digraph G {
  compound=true;
  graph [fontname="DejaVu Sans", fontsize=18, label=<<B>العلاقات الأساسية: المشترك والمستخدمون والصلاحيات والمفاتيح</B><BR/><FONT POINT-SIZE="11">الأسهم المتصلة = مفاتيح أجنبية فعلية · العنقود الأزرق = الجداول المملوكة للمشترك، كلها تحمل TenantId وتشير إلى plat.Tenant</FONT>>, labelloc=t, rankdir=LR, nodesep=0.4, ranksep=1.2, pad=0.3, bgcolor="white", splines=true];
  node [shape=plaintext, fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=9, color="#5B6B7A", arrowsize=0.7];
  subgraph cluster_owned {
    label=<<B>الجداول المملوكة للمشترك</B><BR/><FONT POINT-SIZE="10">كل جدول فيها: TenantId → plat.Tenant</FONT>>; style="rounded,filled"; fillcolor="#F4F8FD"; color="#2B5C8A"; fontname="DejaVu Sans";
    "plat.SupportAccessGrant" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#DCEBFA" ALIGN="LEFT" COLSPAN="2"><B>plat.SupportAccessGrant</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">SupportAccessGrantId</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">OperatorId → plat.PlatformOperator</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">GrantedBy → sec.AppUser</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">RevokedBy → sec.AppUser</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 8 عمودًا آخر</FONT></TD></TR></TABLE>>];
    "sec.TenantKey" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#DCEBFA" ALIGN="LEFT" COLSPAN="2"><B>sec.TenantKey</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">TenantKeyId</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 12 عمودًا آخر</FONT></TD></TR></TABLE>>];
    "sec.AppUser" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#DCEBFA" ALIGN="LEFT" COLSPAN="2"><B>sec.AppUser</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">AppUserId</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">DepartmentId → org.Department</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">LineManagerUserId → sec.AppUser</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">MfaKeyId → sec.TenantKey</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 28 عمودًا آخر</FONT></TD></TR></TABLE>>];
    "sec.Role" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#DCEBFA" ALIGN="LEFT" COLSPAN="2"><B>sec.Role</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">RoleId</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 12 عمودًا آخر</FONT></TD></TR></TABLE>>];
    "sec.RolePermission" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#DCEBFA" ALIGN="LEFT" COLSPAN="2"><B>sec.RolePermission</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">RoleId</TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">PermissionId</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">AssignedBy → sec.AppUser</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 5 عمودًا آخر</FONT></TD></TR></TABLE>>];
    "sec.UserRole" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#DCEBFA" ALIGN="LEFT" COLSPAN="2"><B>sec.UserRole</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">UserId</TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">RoleId</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">AssignedBy → sec.AppUser</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 5 عمودًا آخر</FONT></TD></TR></TABLE>>];
    "sec.UserCompanyScope" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#DCEBFA" ALIGN="LEFT" COLSPAN="2"><B>sec.UserCompanyScope</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">UserId</TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">CompanyId</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 5 عمودًا آخر</FONT></TD></TR></TABLE>>];
    "sec.UserSession" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#DCEBFA" ALIGN="LEFT" COLSPAN="2"><B>sec.UserSession</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">UserSessionId</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">UserId → sec.AppUser</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">EndedBy → sec.AppUser</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 13 عمودًا آخر</FONT></TD></TR></TABLE>>];
    "org.Company" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#DCEBFA" ALIGN="LEFT" COLSPAN="2"><B>org.Company</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">CompanyId</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">PartyId → pty.Party</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">LegalEntityTypeId → cat.LegalEntityType</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">ParentCompanyId → org.Company</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">CountryId → ref.Country</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">BaseCurrencyId → ref.Currency</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 20 عمودًا آخر</FONT></TD></TR></TABLE>>];
    "org.Department" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#DCEBFA" ALIGN="LEFT" COLSPAN="2"><B>org.Department</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">DepartmentId</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">CompanyId → org.Company</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">ParentDepartmentId → org.Department</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">HeadUserId → sec.AppUser</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 11 عمودًا آخر</FONT></TD></TR></TABLE>>];
    "aud.AuditLog" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#EADCF8" ALIGN="LEFT" COLSPAN="2"><B>aud.AuditLog</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">AuditLogId</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 20 عمودًا آخر</FONT></TD></TR></TABLE>>];
  }
  "plat.Tenant" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#FFF3B0" ALIGN="LEFT" COLSPAN="2"><B>plat.Tenant</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">TenantId</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">PlanId → plat.Plan</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">HomeCountryId → ref.Country</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 18 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "plat.Plan" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#FDE9D9" ALIGN="LEFT" COLSPAN="2"><B>plat.Plan</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">PlanId</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 11 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "plat.TenantModule" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#F8D7DA" ALIGN="LEFT" COLSPAN="2"><B>plat.TenantModule</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">TenantModuleId</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">TenantId → plat.Tenant</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">EnabledBy → plat.PlatformOperator</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 7 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "plat.PlatformOperator" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#F8D7DA" ALIGN="LEFT" COLSPAN="2"><B>plat.PlatformOperator</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">PlatformOperatorId</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 19 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "sec.Permission" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#FDE9D9" ALIGN="LEFT" COLSPAN="2"><B>sec.Permission</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">PermissionId</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 12 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "ref.Country" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#FDE9D9" ALIGN="LEFT" COLSPAN="2"><B>ref.Country</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">CountryId</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 12 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "cat.LegalEntityType" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9AA3AD"><TR><TD BGCOLOR="#EEEEEE"><FONT COLOR="#444444">cat.LegalEntityType</FONT></TD></TR></TABLE>>];
  "pty.Party" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9AA3AD"><TR><TD BGCOLOR="#EEEEEE"><FONT COLOR="#444444">pty.Party</FONT></TD></TR></TABLE>>];
  "ref.Currency" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9AA3AD"><TR><TD BGCOLOR="#EEEEEE"><FONT COLOR="#444444">ref.Currency</FONT></TD></TR></TABLE>>];
  "org.Company" -> "cat.LegalEntityType" [label="LegalEntityTypeId", style=solid];
  "org.Company" -> "org.Company" [label="ParentCompanyId", style=solid];
  "org.Company" -> "pty.Party" [label="PartyId", style=solid];
  "org.Company" -> "ref.Country" [label="CountryId", style=solid];
  "org.Company" -> "ref.Currency" [label="BaseCurrencyId", style=dashed];
  "org.Department" -> "org.Company" [label="CompanyId", style=solid];
  "org.Department" -> "org.Department" [label="ParentDepartmentId", style=solid];
  "org.Department" -> "sec.AppUser" [label="HeadUserId", style=solid];
  "plat.SupportAccessGrant" -> "plat.PlatformOperator" [label="OperatorId", style=solid];
  "plat.SupportAccessGrant" -> "sec.AppUser" [label="GrantedBy", style=solid];
  "plat.SupportAccessGrant" -> "sec.AppUser" [label="RevokedBy", style=solid];
  "plat.Tenant" -> "plat.Plan" [label="PlanId", style=solid];
  "plat.Tenant" -> "ref.Country" [label="HomeCountryId", style=solid];
  "plat.TenantModule" -> "plat.PlatformOperator" [label="EnabledBy", style=solid];
  "plat.TenantModule" -> "plat.Tenant" [label="TenantId", style=solid];
  "sec.AppUser" -> "org.Department" [label="DepartmentId", style=solid];
  "sec.AppUser" -> "sec.AppUser" [label="LineManagerUserId", style=solid];
  "sec.AppUser" -> "sec.TenantKey" [label="MfaKeyId", style=solid];
  "sec.RolePermission" -> "sec.AppUser" [label="AssignedBy", style=solid];
  "sec.RolePermission" -> "sec.Permission" [label="PermissionId", style=solid];
  "sec.RolePermission" -> "sec.Role" [label="RoleId", style=solid];
  "sec.UserCompanyScope" -> "org.Company" [label="CompanyId", style=solid];
  "sec.UserCompanyScope" -> "sec.AppUser" [label="UserId", style=solid];
  "sec.UserRole" -> "sec.AppUser" [label="AssignedBy", style=solid];
  "sec.UserRole" -> "sec.AppUser" [label="UserId", style=solid];
  "sec.UserRole" -> "sec.Role" [label="RoleId", style=solid];
  "sec.UserSession" -> "sec.AppUser" [label="EndedBy", style=solid];
  "sec.UserSession" -> "sec.AppUser" [label="UserId", style=solid];
  "plat.SupportAccessGrant" -> "plat.Tenant" [ltail=cluster_owned, label="TenantId\n(كل جدول في العنقود)", style=bold, color="#B8860B", fontcolor="#8A6D00", penwidth=2];
}
