digraph G {
  graph [fontname="DejaVu Sans", fontsize=18, label=<<B>العلاقات الأساسية: المشترك والمستخدمون والصلاحيات والمفاتيح</B><BR/><FONT POINT-SIZE="11">كل جدول مملوك للمشترك يشير إلى plat.Tenant عبر TenantId (غير مرسوم)</FONT>>, labelloc=t, rankdir=LR, nodesep=0.35, ranksep=1.1, pad=0.3, bgcolor="white"];
  node [shape=plaintext, fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=9, color="#5B6B7A", arrowsize=0.7];
  "plat.Tenant" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#F8D7DA" ALIGN="LEFT" COLSPAN="2"><B>plat.Tenant</B></TD></TR><TR><TD ALIGN="LEFT" PORT="TenantId">PK</TD><TD ALIGN="LEFT">TenantId</TD></TR><TR><TD ALIGN="LEFT" PORT="PlanId">FK</TD><TD ALIGN="LEFT">PlanId → Plan</TD></TR><TR><TD ALIGN="LEFT" PORT="HomeCountryId">FK</TD><TD ALIGN="LEFT">HomeCountryId → ref.Country</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 18 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "plat.Plan" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#FDE9D9" ALIGN="LEFT" COLSPAN="2"><B>plat.Plan</B></TD></TR><TR><TD ALIGN="LEFT" PORT="PlanId">PK</TD><TD ALIGN="LEFT">PlanId</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 11 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "plat.TenantModule" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#DCEBFA" ALIGN="LEFT" COLSPAN="2"><B>plat.TenantModule</B></TD></TR><TR><TD ALIGN="LEFT" PORT="TenantModuleId">PK</TD><TD ALIGN="LEFT">TenantModuleId</TD></TR><TR><TD ALIGN="LEFT" PORT="EnabledBy">FK</TD><TD ALIGN="LEFT">EnabledBy → PlatformOperator</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 7 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "plat.SupportAccessGrant" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#DCEBFA" ALIGN="LEFT" COLSPAN="2"><B>plat.SupportAccessGrant</B></TD></TR><TR><TD ALIGN="LEFT" PORT="SupportAccessGrantId">PK</TD><TD ALIGN="LEFT">SupportAccessGrantId</TD></TR><TR><TD ALIGN="LEFT" PORT="OperatorId">FK</TD><TD ALIGN="LEFT">OperatorId → PlatformOperator</TD></TR><TR><TD ALIGN="LEFT" PORT="GrantedBy">FK</TD><TD ALIGN="LEFT">GrantedBy → sec.AppUser</TD></TR><TR><TD ALIGN="LEFT" PORT="RevokedBy">FK</TD><TD ALIGN="LEFT">RevokedBy → sec.AppUser</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 8 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "plat.PlatformOperator" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#F8D7DA" ALIGN="LEFT" COLSPAN="2"><B>plat.PlatformOperator</B></TD></TR><TR><TD ALIGN="LEFT" PORT="PlatformOperatorId">PK</TD><TD ALIGN="LEFT">PlatformOperatorId</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 19 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "sec.TenantKey" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#DCEBFA" ALIGN="LEFT" COLSPAN="2"><B>sec.TenantKey</B></TD></TR><TR><TD ALIGN="LEFT" PORT="TenantKeyId">PK</TD><TD ALIGN="LEFT">TenantKeyId</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 12 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "sec.AppUser" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#DCEBFA" ALIGN="LEFT" COLSPAN="2"><B>sec.AppUser</B></TD></TR><TR><TD ALIGN="LEFT" PORT="AppUserId">PK</TD><TD ALIGN="LEFT">AppUserId</TD></TR><TR><TD ALIGN="LEFT" PORT="DepartmentId">FK</TD><TD ALIGN="LEFT">DepartmentId → org.Department</TD></TR><TR><TD ALIGN="LEFT" PORT="LineManagerUserId">FK</TD><TD ALIGN="LEFT">LineManagerUserId → AppUser</TD></TR><TR><TD ALIGN="LEFT" PORT="MfaKeyId">FK</TD><TD ALIGN="LEFT">MfaKeyId → TenantKey</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 27 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "sec.Role" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#DCEBFA" ALIGN="LEFT" COLSPAN="2"><B>sec.Role</B></TD></TR><TR><TD ALIGN="LEFT" PORT="RoleId">PK</TD><TD ALIGN="LEFT">RoleId</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 12 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "sec.Permission" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#FDE9D9" ALIGN="LEFT" COLSPAN="2"><B>sec.Permission</B></TD></TR><TR><TD ALIGN="LEFT" PORT="PermissionId">PK</TD><TD ALIGN="LEFT">PermissionId</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 12 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "sec.RolePermission" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#DCEBFA" ALIGN="LEFT" COLSPAN="2"><B>sec.RolePermission</B></TD></TR><TR><TD ALIGN="LEFT" PORT="RoleId">PK</TD><TD ALIGN="LEFT">RoleId</TD></TR><TR><TD ALIGN="LEFT" PORT="PermissionId">PK</TD><TD ALIGN="LEFT">PermissionId</TD></TR><TR><TD ALIGN="LEFT" PORT="AssignedBy">FK</TD><TD ALIGN="LEFT">AssignedBy → AppUser</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 5 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "sec.UserRole" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#DCEBFA" ALIGN="LEFT" COLSPAN="2"><B>sec.UserRole</B></TD></TR><TR><TD ALIGN="LEFT" PORT="UserId">PK</TD><TD ALIGN="LEFT">UserId</TD></TR><TR><TD ALIGN="LEFT" PORT="RoleId">PK</TD><TD ALIGN="LEFT">RoleId</TD></TR><TR><TD ALIGN="LEFT" PORT="AssignedBy">FK</TD><TD ALIGN="LEFT">AssignedBy → AppUser</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 5 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "sec.UserCompanyScope" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#DCEBFA" ALIGN="LEFT" COLSPAN="2"><B>sec.UserCompanyScope</B></TD></TR><TR><TD ALIGN="LEFT" PORT="UserId">PK</TD><TD ALIGN="LEFT">UserId</TD></TR><TR><TD ALIGN="LEFT" PORT="CompanyId">PK</TD><TD ALIGN="LEFT">CompanyId</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 5 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "sec.UserSession" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#DCEBFA" ALIGN="LEFT" COLSPAN="2"><B>sec.UserSession</B></TD></TR><TR><TD ALIGN="LEFT" PORT="UserSessionId">PK</TD><TD ALIGN="LEFT">UserSessionId</TD></TR><TR><TD ALIGN="LEFT" PORT="UserId">FK</TD><TD ALIGN="LEFT">UserId → AppUser</TD></TR><TR><TD ALIGN="LEFT" PORT="EndedBy">FK</TD><TD ALIGN="LEFT">EndedBy → AppUser</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 13 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "org.Company" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#DCEBFA" ALIGN="LEFT" COLSPAN="2"><B>org.Company</B></TD></TR><TR><TD ALIGN="LEFT" PORT="CompanyId">PK</TD><TD ALIGN="LEFT">CompanyId</TD></TR><TR><TD ALIGN="LEFT" PORT="PartyId">FK</TD><TD ALIGN="LEFT">PartyId → pty.Party</TD></TR><TR><TD ALIGN="LEFT" PORT="LegalEntityTypeId">FK</TD><TD ALIGN="LEFT">LegalEntityTypeId → cat.LegalEntityType</TD></TR><TR><TD ALIGN="LEFT" PORT="ParentCompanyId">FK</TD><TD ALIGN="LEFT">ParentCompanyId → Company</TD></TR><TR><TD ALIGN="LEFT" PORT="CountryId">FK</TD><TD ALIGN="LEFT">CountryId → ref.Country</TD></TR><TR><TD ALIGN="LEFT" PORT="BaseCurrencyId">FK</TD><TD ALIGN="LEFT">BaseCurrencyId → ref.Currency</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 20 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "org.Department" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#DCEBFA" ALIGN="LEFT" COLSPAN="2"><B>org.Department</B></TD></TR><TR><TD ALIGN="LEFT" PORT="DepartmentId">PK</TD><TD ALIGN="LEFT">DepartmentId</TD></TR><TR><TD ALIGN="LEFT" PORT="CompanyId">FK</TD><TD ALIGN="LEFT">CompanyId → Company</TD></TR><TR><TD ALIGN="LEFT" PORT="ParentDepartmentId">FK</TD><TD ALIGN="LEFT">ParentDepartmentId → Department</TD></TR><TR><TD ALIGN="LEFT" PORT="HeadUserId">FK</TD><TD ALIGN="LEFT">HeadUserId → sec.AppUser</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 11 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "aud.AuditLog" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#EADCF8" ALIGN="LEFT" COLSPAN="2"><B>aud.AuditLog</B></TD></TR><TR><TD ALIGN="LEFT" PORT="AuditLogId">PK</TD><TD ALIGN="LEFT">AuditLogId</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 20 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "ref.Country" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7A8794"><TR><TD BGCOLOR="#FDE9D9" ALIGN="LEFT" COLSPAN="2"><B>ref.Country</B></TD></TR><TR><TD ALIGN="LEFT" PORT="CountryId">PK</TD><TD ALIGN="LEFT">CountryId</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#666666">+ 12 عمودًا آخر</FONT></TD></TR></TABLE>>];
  "cat.LegalEntityType" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9AA3AD"><TR><TD BGCOLOR="#EEEEEE"><FONT COLOR="#444444">cat.LegalEntityType</FONT></TD></TR></TABLE>>];
  "pty.Party" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9AA3AD"><TR><TD BGCOLOR="#EEEEEE"><FONT COLOR="#444444">pty.Party</FONT></TD></TR></TABLE>>];
  "ref.Currency" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9AA3AD"><TR><TD BGCOLOR="#EEEEEE"><FONT COLOR="#444444">ref.Currency</FONT></TD></TR></TABLE>>];
  "plat.Tenant":"PlanId":e -> "plat.Plan" [style=dashed];
  "plat.Tenant":"HomeCountryId":e -> "ref.Country" [style=dashed];
  "plat.TenantModule":"EnabledBy":e -> "plat.PlatformOperator" [style=dashed];
  "plat.SupportAccessGrant":"OperatorId":e -> "plat.PlatformOperator" [style=dashed];
  "plat.SupportAccessGrant":"GrantedBy":e -> "sec.AppUser" [style=solid];
  "plat.SupportAccessGrant":"RevokedBy":e -> "sec.AppUser" [style=solid];
