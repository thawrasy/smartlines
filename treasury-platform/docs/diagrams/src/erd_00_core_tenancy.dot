  "sec.AppUser":"MfaKeyId":e -> "sec.TenantKey" [style=solid];
  "sec.RolePermission":"RoleId":e -> "sec.Role" [style=solid];
  "sec.RolePermission":"PermissionId":e -> "sec.Permission" [style=solid];
  "sec.RolePermission":"AssignedBy":e -> "sec.AppUser" [style=solid];
  "sec.UserRole":"UserId":e -> "sec.AppUser" [style=solid];
  "sec.UserRole":"RoleId":e -> "sec.Role" [style=solid];
  "sec.UserRole":"AssignedBy":e -> "sec.AppUser" [style=solid];
  "sec.UserCompanyScope":"UserId":e -> "sec.AppUser" [style=solid];
  "sec.UserCompanyScope":"CompanyId":e -> "org.Company" [style=solid];
  "sec.UserSession":"UserId":e -> "sec.AppUser" [style=solid];
  "sec.UserSession":"EndedBy":e -> "sec.AppUser" [style=solid];
  "org.Company":"PartyId":e -> "pty.Party" [style=solid];
  "org.Company":"LegalEntityTypeId":e -> "cat.LegalEntityType" [style=solid];
  "org.Company":"ParentCompanyId":e -> "org.Company" [style=solid];
  "org.Company":"CountryId":e -> "ref.Country" [style=dashed];
  "org.Company":"BaseCurrencyId":e -> "ref.Currency" [style=dashed];
  "org.Department":"CompanyId":e -> "org.Company" [style=solid];
