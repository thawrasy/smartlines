digraph G {
  graph [fontname="DejaVu Sans", label=<<B><FONT POINT-SIZE="16">م0 · الهوية والصلاحيات</FONT></B><BR/><FONT POINT-SIZE="10" COLOR="#4B5563">Identity &amp; authorisation</FONT>>, labelloc=t, rankdir=LR, splines=ortho, nodesep=0.45, ranksep=1.7, pad=0.35, bgcolor="white", dpi=110];
  node [fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=8, color="#374151", arrowsize=0.75];
  "sec.AppUser" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">sec</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>AppUser</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="AppUserId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="AppUserId"><B>AppUserId</B></TD><TD ALIGN="RIGHT" PORT="AppUserId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="DepartmentId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="DepartmentId"><B>DepartmentId</B></TD><TD ALIGN="RIGHT" PORT="DepartmentId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="LineManagerUserId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="LineManagerUserId"><B>LineManagerUserId</B></TD><TD ALIGN="RIGHT" PORT="LineManagerUserId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="MfaKeyId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="MfaKeyId"><B>MfaKeyId</B></TD><TD ALIGN="RIGHT" PORT="MfaKeyId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Email</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(254)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">CompanyScopeMode</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Status</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">DisplayNameAr</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(200)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 22 more columns</I></FONT></TD></TR></TABLE>>];
  "sec.Role" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">sec</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>Role</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="RoleId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="RoleId"><B>RoleId</B></TD><TD ALIGN="RIGHT" PORT="RoleId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Code</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">NameAr</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">NameEn</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Description</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">text</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 7 more columns</I></FONT></TD></TR></TABLE>>];
  "sec.Permission" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">sec</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>Permission</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="PermissionId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="PermissionId"><B>PermissionId</B></TD><TD ALIGN="RIGHT" PORT="PermissionId"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Code</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">ModuleCode</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(12)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">NameAr</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Description</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(500)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 7 more columns</I></FONT></TD></TR></TABLE>>];
  "sec.RolePermission" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">sec</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>RolePermission</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="RoleId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="RoleId"><B>RoleId</B></TD><TD ALIGN="RIGHT" PORT="RoleId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="PermissionId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="PermissionId"><B>PermissionId</B></TD><TD ALIGN="RIGHT" PORT="PermissionId"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="AssignedBy"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="AssignedBy"><B>AssignedBy</B></TD><TD ALIGN="RIGHT" PORT="AssignedBy"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">AssignedAt</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">timestamp(3)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 4 more columns</I></FONT></TD></TR></TABLE>>];
  "sec.UserRole" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">sec</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>UserRole</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="UserId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="UserId"><B>UserId</B></TD><TD ALIGN="RIGHT" PORT="UserId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="RoleId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="RoleId"><B>RoleId</B></TD><TD ALIGN="RIGHT" PORT="RoleId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="AssignedBy"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="AssignedBy"><B>AssignedBy</B></TD><TD ALIGN="RIGHT" PORT="AssignedBy"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">AssignedAt</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">timestamp(3)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 4 more columns</I></FONT></TD></TR></TABLE>>];
  "sec.UserCompanyScope" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">sec</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>UserCompanyScope</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="UserId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="UserId"><B>UserId</B></TD><TD ALIGN="RIGHT" PORT="UserId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="CompanyId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="CompanyId"><B>CompanyId</B></TD><TD ALIGN="RIGHT" PORT="CompanyId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">IncludeDescendants</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">smallint</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 4 more columns</I></FONT></TD></TR></TABLE>>];
  "sec.ExternalIdentity" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">sec</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>ExternalIdentity</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ExternalIdentityId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="ExternalIdentityId"><B>ExternalIdentityId</B></TD><TD ALIGN="RIGHT" PORT="ExternalIdentityId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="UserId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="UserId"><B>UserId</B></TD><TD ALIGN="RIGHT" PORT="UserId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Provider</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Issuer</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(300)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Subject</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">LastLoginAt</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">timestamp(3)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 4 more columns</I></FONT></TD></TR></TABLE>>];
  "org.Company" [shape=box, style="rounded,dashed", color="#6B7280", fontcolor="#374151", margin="0.12,0.05", label="org.Company"];
  "org.Department" [shape=box, style="rounded,dashed", color="#6B7280", fontcolor="#374151", margin="0.12,0.05", label="org.Department"];
  "sec.TenantKey" [shape=box, style="rounded,dashed", color="#6B7280", fontcolor="#374151", margin="0.12,0.05", label="sec.TenantKey"];
  "org.Department" -> "sec.AppUser":"DepartmentId":w [dir=both, arrowtail=tee, arrowhead=crowodot, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "sec.TenantKey" -> "sec.AppUser":"MfaKeyId":w [dir=both, arrowtail=tee, arrowhead=crowodot, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "sec.Role":"RoleId":e -> "sec.RolePermission":"RoleId":w [dir=both, arrowtail=tee, arrowhead=crow, style=solid, color="#374151", arrowsize=0.7];
  "sec.Permission":"PermissionId":e -> "sec.RolePermission":"PermissionId":w [dir=both, arrowtail=tee, arrowhead=crow, style=solid, color="#374151", arrowsize=0.7];
  "sec.AppUser":"AppUserId":e -> "sec.RolePermission":"AssignedBy":w [dir=both, arrowtail=tee, arrowhead=crowodot, style=solid, color="#374151", arrowsize=0.7];
  "sec.AppUser":"AppUserId":e -> "sec.UserRole":"UserId":w [dir=both, arrowtail=tee, arrowhead=crow, style=solid, color="#374151", arrowsize=0.7];
  "sec.Role":"RoleId":e -> "sec.UserRole":"RoleId":w [dir=both, arrowtail=tee, arrowhead=crow, style=solid, color="#374151", arrowsize=0.7];
  "sec.AppUser":"AppUserId":e -> "sec.UserRole":"AssignedBy":w [dir=both, arrowtail=tee, arrowhead=crowodot, style=solid, color="#374151", arrowsize=0.7];
