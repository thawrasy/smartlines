  "org.Company" -> "sec.UserCompanyScope":"CompanyId":w [dir=both, arrowtail=tee, arrowhead=crow, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "sec.AppUser":"AppUserId":e -> "sec.ExternalIdentity":"UserId":w [dir=both, arrowtail=tee, arrowhead=crow, style=solid, color="#374151", arrowsize=0.7];
