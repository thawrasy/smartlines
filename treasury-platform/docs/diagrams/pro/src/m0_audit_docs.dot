digraph G {
  graph [fontname="DejaVu Sans", label=<<B><FONT POINT-SIZE="16">م0 · التدقيق والمستندات</FONT></B><BR/><FONT POINT-SIZE="10" COLOR="#4B5563">Audit &amp; documents</FONT>>, labelloc=t, rankdir=LR, splines=ortho, nodesep=0.45, ranksep=1.7, pad=0.35, bgcolor="white", dpi=110];
  node [fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=8, color="#374151", arrowsize=0.75];
  "aud.AuditLog" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">aud</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>AuditLog</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="AuditLogId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="AuditLogId"><B>AuditLogId</B></TD><TD ALIGN="RIGHT" PORT="AuditLogId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">OccurredAt</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">timestamp(3)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">ActorType</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Action</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(60)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">ChainSeq</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">bigint</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 15 more columns</I></FONT></TD></TR></TABLE>>];
  "aud.SensitiveAccessLog" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">aud</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>SensitiveAccessLog</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="SensitiveAccessLogId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="SensitiveAccessLogId"><B>SensitiveAccessLogId</B></TD><TD ALIGN="RIGHT" PORT="SensitiveAccessLogId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ActorUserId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="ActorUserId"><B>ActorUserId</B></TD><TD ALIGN="RIGHT" PORT="ActorUserId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="OperatorId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="OperatorId"><B>OperatorId</B></TD><TD ALIGN="RIGHT" PORT="OperatorId"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">OccurredAt</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">timestamp(3)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">AccessKind</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(27)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">ActorType</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">SubjectPartyId</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">bigint</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 11 more columns</I></FONT></TD></TR></TABLE>>];
  "doc.Document" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">doc</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>Document</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="DocumentId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="DocumentId"><B>DocumentId</B></TD><TD ALIGN="RIGHT" PORT="DocumentId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="DocumentTypeId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="DocumentTypeId"><B>DocumentTypeId</B></TD><TD ALIGN="RIGHT" PORT="DocumentTypeId"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="OwnerCompanyId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="OwnerCompanyId"><B>OwnerCompanyId</B></TD><TD ALIGN="RIGHT" PORT="OwnerCompanyId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="CurrentVersionId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="CurrentVersionId"><B>CurrentVersionId</B></TD><TD ALIGN="RIGHT" PORT="CurrentVersionId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="SupersededByDocumentId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="SupersededByDocumentId"><B>SupersededByDocumentId</B></TD><TD ALIGN="RIGHT" PORT="SupersededByDocumentId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="DeletedBy"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="DeletedBy"><B>DeletedBy</B></TD><TD ALIGN="RIGHT" PORT="DeletedBy"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Title</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Sensitivity</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(12)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Status</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(12)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">DocumentNumber</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(100)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 11 more columns</I></FONT></TD></TR></TABLE>>];
  "doc.DocumentLink" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">doc</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>DocumentLink</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="DocumentLinkId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="DocumentLinkId"><B>DocumentLinkId</B></TD><TD ALIGN="RIGHT" PORT="DocumentLinkId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="DocumentId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="DocumentId"><B>DocumentId</B></TD><TD ALIGN="RIGHT" PORT="DocumentId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="UnlinkedBy"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="UnlinkedBy"><B>UnlinkedBy</B></TD><TD ALIGN="RIGHT" PORT="UnlinkedBy"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">EntityType</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(60)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">EntityId</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">LinkRole</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(11)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">PageRef</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(30)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 5 more columns</I></FONT></TD></TR></TABLE>>];
  "doc.DocumentVersion" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">doc</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>DocumentVersion</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="DocumentVersionId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="DocumentVersionId"><B>DocumentVersionId</B></TD><TD ALIGN="RIGHT" PORT="DocumentVersionId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="DocumentId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="DocumentId"><B>DocumentId</B></TD><TD ALIGN="RIGHT" PORT="DocumentId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="KeyId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="KeyId"><B>KeyId</B></TD><TD ALIGN="RIGHT" PORT="KeyId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">VersionNo</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">StorageKey</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(300)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">SizeBytes</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">FileName</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(260)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 10 more columns</I></FONT></TD></TR></TABLE>>];
  "cat.DocumentType" [shape=box, style="rounded,dashed", color="#6B7280", fontcolor="#374151", margin="0.12,0.05", label="cat.DocumentType"];
  "org.Company" [shape=box, style="rounded,dashed", color="#6B7280", fontcolor="#374151", margin="0.12,0.05", label="org.Company"];
  "plat.PlatformOperator" [shape=box, style="rounded,dashed", color="#6B7280", fontcolor="#374151", margin="0.12,0.05", label="plat.PlatformOperator"];
  "sec.AppUser" [shape=box, style="rounded,dashed", color="#6B7280", fontcolor="#374151", margin="0.12,0.05", label="sec.AppUser"];
  "sec.TenantKey" [shape=box, style="rounded,dashed", color="#6B7280", fontcolor="#374151", margin="0.12,0.05", label="sec.TenantKey"];
  "sec.AppUser" -> "aud.SensitiveAccessLog":"ActorUserId":w [dir=both, arrowtail=tee, arrowhead=crowodot, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "plat.PlatformOperator" -> "aud.SensitiveAccessLog":"OperatorId":w [dir=both, arrowtail=tee, arrowhead=crowodot, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "cat.DocumentType" -> "doc.Document":"DocumentTypeId":w [dir=both, arrowtail=tee, arrowhead=crow, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "org.Company" -> "doc.Document":"OwnerCompanyId":w [dir=both, arrowtail=tee, arrowhead=crowodot, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "doc.DocumentVersion":"DocumentVersionId":e -> "doc.Document":"CurrentVersionId":w [dir=both, arrowtail=tee, arrowhead=crowodot, style=solid, color="#374151", arrowsize=0.7];
  "sec.AppUser" -> "doc.Document":"DeletedBy":w [dir=both, arrowtail=tee, arrowhead=crowodot, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "doc.Document":"DocumentId":e -> "doc.DocumentLink":"DocumentId":w [dir=both, arrowtail=tee, arrowhead=crow, style=solid, color="#374151", arrowsize=0.7];
  "sec.AppUser" -> "doc.DocumentLink":"UnlinkedBy":w [dir=both, arrowtail=tee, arrowhead=crowodot, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "doc.Document":"DocumentId":e -> "doc.DocumentVersion":"DocumentId":w [dir=both, arrowtail=tee, arrowhead=crow, style=solid, color="#374151", arrowsize=0.7];
  "sec.TenantKey" -> "doc.DocumentVersion":"KeyId":w [dir=both, arrowtail=tee, arrowhead=crowodot, style=dashed, color="#9CA3AF", arrowsize=0.7];
}
