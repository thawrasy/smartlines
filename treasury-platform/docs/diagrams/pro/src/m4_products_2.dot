digraph G {
  graph [fontname="DejaVu Sans", label=<<B><FONT POINT-SIZE="16">م4 · المنتجات والرسوم والتمويل والضمانات (2/2)</FONT></B><BR/><FONT POINT-SIZE="10" COLOR="#4B5563">Products, fees, financing &amp; collateral types</FONT>>, labelloc=t, rankdir=LR, splines=ortho, nodesep=0.45, ranksep=1.7, pad=0.35, bgcolor="white", dpi=110];
