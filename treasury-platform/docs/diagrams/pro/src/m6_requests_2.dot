digraph G {
  graph [fontname="DejaVu Sans", label=<<B><FONT POINT-SIZE="16">م6 · الطلبات وإجراءاتها (2/2)</FONT></B><BR/><FONT POINT-SIZE="10" COLOR="#4B5563">Requests, approvals &amp; actions</FONT>>, labelloc=t, rankdir=LR, splines=ortho, nodesep=0.45, ranksep=1.7, pad=0.35, bgcolor="white", dpi=110];
  node [fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=8, color="#374151", arrowsize=0.75];
  "wfl.HookExecution" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">wfl</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>HookExecution</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="HookExecutionId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="HookExecutionId"><B>HookExecutionId</B></TD><TD ALIGN="RIGHT" PORT="HookExecutionId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="RequestId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="RequestId"><B>RequestId</B></TD><TD ALIGN="RIGHT" PORT="RequestId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="StageInstanceId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="StageInstanceId"><B>StageInstanceId</B></TD><TD ALIGN="RIGHT" PORT="StageInstanceId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">HookKey</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(60)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">TriggerKind</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">ExecMode</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(12)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">ActionFilter</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(10)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 13 more columns</I></FONT></TD></TR></TABLE>>];
  "wfl.UserDelegation" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">wfl</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>UserDelegation</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="UserDelegationId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="UserDelegationId"><B>UserDelegationId</B></TD><TD ALIGN="RIGHT" PORT="UserDelegationId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="FromUserId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="FromUserId"><B>FromUserId</B></TD><TD ALIGN="RIGHT" PORT="FromUserId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ToUserId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="ToUserId"><B>ToUserId</B></TD><TD ALIGN="RIGHT" PORT="ToUserId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="RequestTypeId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="RequestTypeId"><B>RequestTypeId</B></TD><TD ALIGN="RIGHT" PORT="RequestTypeId"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="RevokedBy"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="RevokedBy"><B>RevokedBy</B></TD><TD ALIGN="RIGHT" PORT="RevokedBy"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">StartsOn</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">date</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">EndsOn</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">date</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Scope</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(14)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Reason</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(500)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 6 more columns</I></FONT></TD></TR></TABLE>>];
  "sec.AppUser" [shape=box, style="rounded,dashed", color="#6B7280", fontcolor="#374151", margin="0.12,0.05", label="sec.AppUser"];
  "wfl.Request" [shape=box, style="rounded,dashed", color="#6B7280", fontcolor="#374151", margin="0.12,0.05", label="wfl.Request"];
  "wfl.RequestStageInstance" [shape=box, style="rounded,dashed", color="#6B7280", fontcolor="#374151", margin="0.12,0.05", label="wfl.RequestStageInstance"];
  "wfl.RequestType" [shape=box, style="rounded,dashed", color="#6B7280", fontcolor="#374151", margin="0.12,0.05", label="wfl.RequestType"];
  "wfl.Request" -> "wfl.HookExecution":"RequestId":w [dir=both, arrowtail=tee, arrowhead=crow, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "wfl.RequestStageInstance" -> "wfl.HookExecution":"StageInstanceId":w [dir=both, arrowtail=tee, arrowhead=crow, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "sec.AppUser" -> "wfl.UserDelegation":"FromUserId":w [dir=both, arrowtail=tee, arrowhead=crow, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "sec.AppUser" -> "wfl.UserDelegation":"ToUserId":w [dir=both, arrowtail=tee, arrowhead=crow, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "wfl.RequestType" -> "wfl.UserDelegation":"RequestTypeId":w [dir=both, arrowtail=tee, arrowhead=crowodot, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "sec.AppUser" -> "wfl.UserDelegation":"RevokedBy":w [dir=both, arrowtail=tee, arrowhead=crowodot, style=dashed, color="#9CA3AF", arrowsize=0.7];
}
