  "sec.TenantKey" -> "lc.LcTerms" [dir=both, arrowtail=tee, arrowhead=crowodot, style=dashed, color="#9CA3AF", fontcolor="#9CA3AF", label="EncKeyId\nHashKeyId"];
}
