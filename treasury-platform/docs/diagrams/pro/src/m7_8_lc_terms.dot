digraph G {
  graph [fontname="DejaVu Sans", label=<<B><FONT POINT-SIZE="16">م7/م8 · شروط الاعتماد والنماذج</FONT></B><BR/><FONT POINT-SIZE="10" COLOR="#4B5563">LC terms, fields &amp; form maps</FONT>>, labelloc=t, rankdir=LR, splines=true, nodesep=0.35, ranksep=1.25, pad=0.35, bgcolor="white", dpi=110];
