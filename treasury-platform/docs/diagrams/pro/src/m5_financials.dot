  "fin.LineCatalogItem" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">fin</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>LineCatalogItem</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="LineCatalogItemId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="LineCatalogItemId"><B>LineCatalogItemId</B></TD><TD ALIGN="RIGHT" PORT="LineCatalogItemId"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Section</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(12)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">IsTotal</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">IsRequired</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">TotalFormula</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(500)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 13 more columns</I></FONT></TD></TR></TABLE>>];
