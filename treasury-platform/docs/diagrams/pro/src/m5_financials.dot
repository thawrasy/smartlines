digraph G {
  graph [fontname="DejaVu Sans", label=<<B><FONT POINT-SIZE="16">م5 · البيانات المالية والأرصدة</FONT></B><BR/><FONT POINT-SIZE="10" COLOR="#4B5563">Financial statements &amp; balances</FONT>>, labelloc=t, rankdir=LR, splines=ortho, nodesep=0.45, ranksep=1.7, pad=0.35, bgcolor="white", dpi=110];
