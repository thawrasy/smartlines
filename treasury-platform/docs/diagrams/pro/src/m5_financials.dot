  edge [fontname="DejaVu Sans", fontsize=8, color="#374151", arrowsize=0.75];
  "fin.AccountMonthlyStat" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">fin</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>AccountMonthlyStat</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="AccountMonthlyStatId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="AccountMonthlyStatId"><B>AccountMonthlyStatId</B></TD><TD ALIGN="RIGHT" PORT="AccountMonthlyStatId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="BankAccountId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="BankAccountId"><B>BankAccountId</B></TD><TD ALIGN="RIGHT" PORT="BankAccountId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="DocumentId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="DocumentId"><B>DocumentId</B></TD><TD ALIGN="RIGHT" PORT="DocumentId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">MonthEnd</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">date</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">AvgDailyBalance</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">numeric(19,4)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">SourceKind</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(14)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">MinBalance</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">numeric(19,4)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 8 more columns</I></FONT></TD></TR></TABLE>>];
  "fin.BankFlowEntry" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">fin</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>BankFlowEntry</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="BankFlowEntryId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="BankFlowEntryId"><B>BankFlowEntryId</B></TD><TD ALIGN="RIGHT" PORT="BankFlowEntryId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="CompanyId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="CompanyId"><B>CompanyId</B></TD><TD ALIGN="RIGHT" PORT="CompanyId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="InstitutionId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="InstitutionId"><B>InstitutionId</B></TD><TD ALIGN="RIGHT" PORT="InstitutionId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="FacilityId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="FacilityId"><B>FacilityId</B></TD><TD ALIGN="RIGHT" PORT="FacilityId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="FlowKindId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="FlowKindId"><B>FlowKindId</B></TD><TD ALIGN="RIGHT" PORT="FlowKindId"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="CurrencyId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="CurrencyId"><B>CurrencyId</B></TD><TD ALIGN="RIGHT" PORT="CurrencyId"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="DocumentId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="DocumentId"><B>DocumentId</B></TD><TD ALIGN="RIGHT" PORT="DocumentId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">MonthEnd</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">date</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Amount</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">numeric(19,4)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">BasisNote</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(500)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 4 more columns</I></FONT></TD></TR></TABLE>>];
  "fin.FinancialStatement" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">fin</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>FinancialStatement</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="FinancialStatementId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="FinancialStatementId"><B>FinancialStatementId</B></TD><TD ALIGN="RIGHT" PORT="FinancialStatementId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="CompanyId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="CompanyId"><B>CompanyId</B></TD><TD ALIGN="RIGHT" PORT="CompanyId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="CurrencyId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="CurrencyId"><B>CurrencyId</B></TD><TD ALIGN="RIGHT" PORT="CurrencyId"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="SupersedesId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="SupersedesId"><B>SupersedesId</B></TD><TD ALIGN="RIGHT" PORT="SupersedesId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="SourceDocumentId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="SourceDocumentId"><B>SourceDocumentId</B></TD><TD ALIGN="RIGHT" PORT="SourceDocumentId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="PreparedBy"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="PreparedBy"><B>PreparedBy</B></TD><TD ALIGN="RIGHT" PORT="PreparedBy"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ApprovedBy"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="ApprovedBy"><B>ApprovedBy</B></TD><TD ALIGN="RIGHT" PORT="ApprovedBy"><FONT COL