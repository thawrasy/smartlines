digraph G {
  graph [fontname="DejaVu Sans", label=<<B><FONT POINT-SIZE="16">م4 · المنتجات والرسوم والتمويل والضمانات</FONT></B><BR/><FONT POINT-SIZE="10" COLOR="#4B5563">Products, fees, financing &amp; collateral types</FONT>>, labelloc=t, rankdir=LR, splines=true, nodesep=0.35, ranksep=1.25, pad=0.35, bgcolor="white", dpi=110];
  node [fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=8, color="#374151", arrowsize=0.75];
  "cat.ProductCategory" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">cat</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>ProductCategory</B></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 14 more columns</I></FONT></TD></TR></TABLE>>];
  "cat.Product" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">cat</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>Product</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><B>ProductCategoryId</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">ProductFamily</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(15)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">ConsumesCreditLimit</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">IsTradeFinance</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">VariantGroupCode</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(40)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 15 more columns</I></FONT></TD></TR></TABLE>>];
  "cat.FeeType" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">cat</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>FeeType</B></FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Nature</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(18)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">CalcHint</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(11)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 14 more columns</I></FONT></TD></TR></TABLE>>];
  "cat.FinancingType" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">cat</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>FinancingType</B></FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">IsIslamic</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">ReturnLabel</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(10)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 14 more columns</I></FONT></TD></TR></TABLE>>];
  "cat.ProductFeeType" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">cat</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>ProductFeeType</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><B>ProductId</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><B>FeeTypeId</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">IsExpected</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">smallint</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 4 more columns</I></FONT></TD></TR></TABLE>>];
  "cat.ProductFinancingType" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">cat</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>ProductFinancingType</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><B>ProductId</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><B>FinancingTypeId</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">IsDefault</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">smallint</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 4 more columns</I></FONT></TD></TR></TABLE>>];
  "cat.FacilityType" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">cat</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>FacilityType</B></FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Compliance</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(12)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 14 more columns</I></FONT></TD></TR></TABLE>>];
  "cat.LimitType" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">cat</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>LimitType</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><B>ParentLimitTypeId</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Kind</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">DefaultDistributionMode</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(13)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 15 more columns</I></FONT></TD></TR></TABLE>>];
  "cat.LimitTypeProduct" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">cat</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>LimitTypeProduct</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>LimitTypeId</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>ProductId</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 4 more columns</I></FONT></TD></TR></TABLE>>];
  "cat.CollateralType" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">cat</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>CollateralType</B></FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">StructureKind</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(20)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 14 more columns</I></FONT></TD></TR></TABLE>>];
  "cat.CollateralTypeAttribute" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">cat</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>CollateralTypeAttribute</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><B>CollateralTypeId</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">AttrKey</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(60)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">LabelAr</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">LabelEn</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">ListOptions</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">text</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 8 more columns</I></FONT></TD></TR></TABLE>>];
  "cat.ObligationType" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">cat</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>ObligationType</B></FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Family</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(23)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">IsQualitative</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">MeasureKind</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(18)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 16 more columns</I></FONT></TD></TR></TABLE>>];
  "cat.CollateralType" -> "cat.CollateralTypeAttribute" [dir=both, arrowtail=tee, arrowhead=crow, style=solid, color="#374151", fontcolor="#374151", label="CollateralTypeId"];
  "cat.FeeType" -> "cat.ProductFeeType" [dir=both, arrowtail=tee, arrowhead=crow, style=solid, color="#374151", fontcolor="#374151", label="FeeTypeId"];
  "cat.FinancingType" -> "cat.ProductFinancingType" [dir=both, arrowtail=tee, arrowhead=crow, style=solid, color="#374151", fontcolor="#374151", label="FinancingTypeId"];
  "cat.LimitType" -> "cat.LimitType" [dir=both, arrowtail=tee, arrowhead=crowodot, style=solid, color="#374151", fontcolor="#374151", label="ParentLimitTypeId"];
  "cat.LimitType" -> "cat.LimitTypeProduct" [dir=both, arrowtail=tee, arrowhead=crow, style=solid, color="#374151", fontcolor="#374151", label="LimitTypeId"];
  "cat.Product" -> "cat.LimitTypeProduct" [dir=both, arrowtail=tee, arrowhead=crow, style=solid, color="#374151", fontcolor="#374151", label="ProductId"];
  "cat.Product" -> "cat.ProductFeeType" [dir=both, arrowtail=tee, arrowhead=crow, style=solid, color="#374151", fontcolor="#374151", label="ProductId"];
  "cat.Product" -> "cat.ProductFinancingType" [dir=both, arrowtail=tee, arrowhead=crow, style=solid, color="#374151", fontcolor="#374151", label="ProductId"];
  "cat.ProductCategory" -> "cat.Product" [dir=both, arrowtail=tee, arrowhead=crow, style=solid, color="#374151", fontcolor="#374151", label="ProductCategoryId"];
}
