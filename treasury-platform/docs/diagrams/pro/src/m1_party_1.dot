digraph G {
  graph [fontname="DejaVu Sans", label=<<B><FONT POINT-SIZE="16">م1 · الأشخاص والهوية والاكتمال (1/2)</FONT></B><BR/><FONT POINT-SIZE="10" COLOR="#4B5563">Parties, identity documents &amp; KYC</FONT>>, labelloc=t, rankdir=LR, splines=ortho, nodesep=0.45, ranksep=1.7, pad=0.35, bgcolor="white", dpi=110];
  node [fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=8, color="#374151", arrowsize=0.75];
  "pty.Address" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">pty</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>Address</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="AddressId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="AddressId"><B>AddressId</B></TD><TD ALIGN="RIGHT" PORT="AddressId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="CountryId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="CountryId"><B>CountryId</B></TD><TD ALIGN="RIGHT" PORT="CountryId"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">OwnerType</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(11)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">OwnerId</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">AddressType</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(11)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Region</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(100)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 15 more columns</I></FONT></TD></TR></TABLE>>];
  "pty.ContactMethod" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">pty</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>ContactMethod</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ContactMethodId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="ContactMethodId"><B>ContactMethodId</B></TD><TD ALIGN="RIGHT" PORT="ContactMethodId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">OwnerType</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(11)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">OwnerId</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Kind</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Label</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(100)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 6 more columns</I></FONT></TD></TR></TABLE>>];
  "pty.CustomFieldDefinition" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">pty</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>CustomFieldDefinition</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="CustomFieldDefinitionId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="CustomFieldDefinitionId"><B>CustomFieldDefinitionId</B></TD><TD ALIGN="RIGHT" PORT="CustomFieldDefinitionId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="InstitutionId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="InstitutionId"><B>InstitutionId</B></TD><TD ALIGN="RIGHT" PORT="InstitutionId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">FieldKey</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(60)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">LabelAr</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">LabelEn</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">ListValues</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">text</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 8 more columns</I></FONT></TD></TR></TABLE>>];
  "pty.IdentityDocument" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">pty</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>IdentityDocument</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="IdentityDocumentId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="IdentityDocumentId"><B>IdentityDocumentId</B></TD><TD ALIGN="RIGHT" PORT="IdentityDocumentId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="PartyId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="PartyId"><B>PartyId</B></TD><TD ALIGN="RIGHT" PORT="PartyId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="IssuingCountryId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="IssuingCountryId"><B>IssuingCountryId</B></TD><TD ALIGN="RIGHT" PORT="IssuingCountryId"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="EncKeyId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="EncKeyId"><B>EncKeyId</B></TD><TD ALIGN="RIGHT" PORT="EncKeyId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="HashKeyId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="HashKeyId"><B>HashKeyId</B></TD><TD ALIGN="RIGHT" PORT="HashKeyId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="SupersededById"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="SupersededById"><B>SupersededById</B></TD><TD ALIGN="RIGHT" PORT="SupersededById"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="VerifiedBy"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="VerifiedBy"><B>VerifiedBy</B></TD><TD ALIGN="RIGHT" PORT="VerifiedBy"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">DocKind</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(14)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">NumberEnc</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">bytea</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">NumberMask</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(32)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">IssuingAuthority</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(200)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 12 more columns</I></FONT></TD></TR></TABLE>>];
  "pty.KycProfile" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">pty</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>KycProfile</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="KycProfileId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="KycProfileId"><B>KycProfileId</B></TD><TD ALIGN="RIGHT" PORT="KycProfileId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="InstitutionId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="InstitutionId"><B>InstitutionId</B></TD><TD ALIGN="RIGHT" PORT="InstitutionId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="SourceDocumentId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="SourceDocumentId"><B>SourceDocumentId</B></TD><TD ALIGN="RIGHT" PORT="SourceDocumentId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">NameAr</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">NameEn</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">AppliesToRole</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(11)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">AppliesToKind</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(12)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 9 more columns</I></FONT></TD></TR></TABLE>>];
  "pty.KycProfileItem" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">pty</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>KycProfileItem</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="KycProfileItemId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="KycProfileItemId"><B>KycProfileItemId</B></TD><TD ALIGN="RIGHT" PORT="KycProfileItemId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ProfileId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="ProfileId"><B>ProfileId</B></TD><TD ALIGN="RIGHT" PORT="ProfileId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">ItemKind</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(17)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">RefCode</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(60)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">IsMandatory</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">ConditionJson</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">text</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 10 more columns</I></FONT></TD></TR></TABLE>>];
  "pty.KycProfileItemLegalForm" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">pty</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>KycProfileItemLegalForm</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="KycProfileItemId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="KycProfileItemId"><B>KycProfileItemId</B></TD><TD ALIGN="RIGHT" PORT="KycProfileItemId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="LegalEntityTypeId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="LegalEntityTypeId"><B>LegalEntityTypeId</B></TD><TD ALIGN="RIGHT" PORT="LegalEntityTypeId"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 4 more columns</I></FONT></TD></TR></TABLE>>];
  "cat.LegalEntityType" [shape=box, style="rounded,dashed", color="#6B7280", fontcolor="#374151", margin="0.12,0.05", label="cat.LegalEntityType"];
  "doc.Document" [shape=box, style="rounded,dashed", color="#6B7280", fontcolor="#374151", margin="0.12,0.05", label="doc.Document"];
  "ins.Institution" [shape=box, style="rounded,dashed", color="#6B7280", fontcolor="#374151", margin="0.12,0.05", label="ins.Institution"];
  "pty.Party" [shape=box, style="rounded,dashed", color="#6B7280", fontcolor="#374151", margin="0.12,0.05", label="pty.Party"];
  "ref.Country" [shape=box, style="rounded,dashed", color="#6B7280", fontcolor="#374151", margin="0.12,0.05", label="ref.Country"];
