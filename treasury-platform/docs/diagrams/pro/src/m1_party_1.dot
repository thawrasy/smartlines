  "sec.TenantKey" [shape=box, style="rounded,dashed", color="#6B7280", fontcolor="#374151", margin="0.12,0.05", label="sec.TenantKey"];
  "ref.Country" -> "pty.Address":"CountryId":w [dir=both, arrowtail=tee, arrowhead=crow, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "ins.Institution" -> "pty.CustomFieldDefinition":"InstitutionId":w [dir=both, arrowtail=tee, arrowhead=crowodot, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "pty.Party" -> "pty.IdentityDocument":"PartyId":w [dir=both, arrowtail=tee, arrowhead=crow, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "ref.Country" -> "pty.IdentityDocument":"IssuingCountryId":w [dir=both, arrowtail=tee, arrowhead=crow, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "sec.TenantKey" -> "pty.IdentityDocument":"EncKeyId":w [dir=both, arrowtail=tee, arrowhead=crow, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "sec.TenantKey" -> "pty.IdentityDocument":"HashKeyId":w [dir=both, arrowtail=tee, arrowhead=crow, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "sec.AppUser" -> "pty.IdentityDocument":"VerifiedBy":w [dir=both, arrowtail=tee, arrowhead=crowodot, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "ins.Institution" -> "pty.KycProfile":"InstitutionId":w [dir=both, arrowtail=tee, arrowhead=crowodot, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "doc.Document" -> "pty.KycProfile":"SourceDocumentId":w [dir=both, arrowtail=tee, arrowhead=crowodot, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "pty.KycProfile":"KycProfileId":e -> "pty.KycProfileItem":"ProfileId":w [dir=both, arrowtail=tee, arrowhead=crow, style=solid, color="#374151", arrowsize=0.7];
  "pty.KycProfileItem":"KycProfileItemId":e -> "pty.KycProfileItemLegalForm":"KycProfileItemId":w [dir=both, arrowtail=tee, arrowhead=crow, style=solid, color="#374151", arrowsize=0.7];
  "cat.LegalEntityType" -> "pty.KycProfileItemLegalForm":"LegalEntityTypeId":w [dir=both, arrowtail=tee, arrowhead=crow, style=dashed, color="#9CA3AF", arrowsize=0.7];
