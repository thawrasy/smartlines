digraph G {
  graph [fontname="DejaVu Sans", label=<<B><FONT POINT-SIZE="16">م5 · الالتزامات والتعهدات (2/2)</FONT></B><BR/><FONT POINT-SIZE="10" COLOR="#4B5563">Obligations, covenants &amp; reporting</FONT>>, labelloc=t, rankdir=LR, splines=ortho, nodesep=0.45, ranksep=1.7, pad=0.35, bgcolor="white", dpi=110];
