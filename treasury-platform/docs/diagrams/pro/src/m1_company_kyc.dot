digraph G {
  graph [fontname="DejaVu Sans", label=<<B><FONT POINT-SIZE="16">م1 · ملف الشركة والاكتمال</FONT></B><BR/><FONT POINT-SIZE="10" COLOR="#4B5563">Company profile &amp; KYC</FONT>>, labelloc=t, rankdir=LR, splines=ortho, nodesep=0.45, ranksep=1.7, pad=0.35, bgcolor="white", dpi=110];
  node [fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=8, color="#374151", arrowsize=0.75];
  "org.CompanyProfile" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">org</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>CompanyProfile</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="CompanyProfileId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="CompanyProfileId"><B>CompanyProfileId</B></TD><TD ALIGN="RIGHT" PORT="CompanyProfileId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="CompanyId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="CompanyId"><B>CompanyId</B></TD><TD ALIGN="RIGHT" PORT="CompanyId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="HeadquartersCountryId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="HeadquartersCountryId"><B>HeadquartersCountryId</B></TD><TD ALIGN="RIGHT" PORT="HeadquartersCountryId"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="SectorId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="SectorId"><B>SectorId</B></TD><TD ALIGN="RIGHT" PORT="SectorId"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="EmployeeBandId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="EmployeeBandId"><B>EmployeeBandId</B></TD><TD ALIGN="RIGHT" PORT="EmployeeBandId"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">UnifiedNationalNo</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(20)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 14 more columns</I></FONT></TD></TR></TABLE>>];
  "org.CompanyBranch" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">org</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>CompanyBranch</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="CompanyBranchId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="CompanyBranchId"><B>CompanyBranchId</B></TD><TD ALIGN="RIGHT" PORT="CompanyBranchId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="CompanyId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="CompanyId"><B>CompanyId</B></TD><TD ALIGN="RIGHT" PORT="CompanyId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="CountryId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="CountryId"><B>CountryId</B></TD><TD ALIGN="RIGHT" PORT="CountryId"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">BranchKind</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(19)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Status</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">NameAr</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(200)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 10 more columns</I></FONT></TD></TR></TABLE>>];
  "org.CompanyKycFinancialProfile" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">org</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>CompanyKycFinancialProfile</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="CompanyKycFinancialProfileId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="CompanyKycFinancialProfileId"><B>CompanyKycFinancialProfileId</B></TD><TD ALIGN="RIGHT" PORT="CompanyKycFinancialProfileId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="CompanyId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="CompanyId"><B>CompanyId</B></TD><TD ALIGN="RIGHT" PORT="CompanyId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="RevenueBandId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="RevenueBandId"><B>RevenueBandId</B></TD><TD ALIGN="RIGHT" PORT="RevenueBandId"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="AccountCurrencyId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="AccountCurrencyId"><B>AccountCurrencyId</B></TD><TD ALIGN="RIGHT" PORT="AccountCurrencyId"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">EffectiveFrom</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">date</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">EffectiveTo</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">date</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 7 more columns</I></FONT></TD></TR></TABLE>>];
