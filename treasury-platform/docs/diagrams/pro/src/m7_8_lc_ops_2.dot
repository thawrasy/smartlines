  "org.Company" -> "lc.ProformaInvoice":"CompanyId":w [dir=both, arrowtail=tee, arrowhead=crow, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "wfl.Request" -> "lc.ProformaInvoice":"RequestId":w [dir=both, arrowtail=tee, arrowhead=crow, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "lc.Counterparty" -> "lc.ProformaInvoice":"CustomerId":w [dir=both, arrowtail=tee, arrowhead=crow, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "ref.Currency" -> "lc.ProformaInvoice":"CurrencyId":w [dir=both, arrowtail=tee, arrowhead=crow, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "lc.LcTerms" -> "lc.ProformaInvoice":"TermsId":w [dir=both, arrowtail=tee, arrowhead=crow, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "acc.BankAccount" -> "lc.ProformaInvoice":"ProceedsAccountId":w [dir=both, arrowtail=tee, arrowhead=crow, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "doc.Document" -> "lc.ProformaInvoice":"DocumentId":w [dir=both, arrowtail=tee, arrowhead=crow, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "lc.ProformaInvoice":"ProformaInvoiceId":e -> "lc.ProformaLine":"ProformaId":w [dir=both, arrowtail=tee, arrowhead=crow, style=solid, color="#374151", arrowsize=0.7];
  "ref.Currency" -> "lc.ProformaLine":"CurrencyId":w [dir=both, arrowtail=tee, arrowhead=crow, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "lc.LcTerms" -> "lc.LcTermsComparison":"BaselineTermsId":w [dir=both, arrowtail=tee, arrowhead=crow, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "lc.LcTerms" -> "lc.LcTermsComparison":"ReceivedTermsId":w [dir=both, arrowtail=tee, arrowhead=crow, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "sec.AppUser" -> "lc.LcTermsComparison":"RunBy":w [dir=both, arrowtail=tee, arrowhead=crowodot, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "lc.LcTermsComparison":"LcTermsComparisonId":e -> "lc.LcTermsComparisonLine":"ComparisonId":w [dir=both, arrowtail=tee, arrowhead=crow, style=solid, color="#374151", arrowsize=0.7];
