  "acc.BankAccount" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">acc</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>BankAccount</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="BankAccountId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="BankAccountId"><B>BankAccountId</B></TD><TD ALIGN="RIGHT" PORT="BankAccountId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="CompanyId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="CompanyId"><B>CompanyId</B></TD><TD ALIGN="RIGHT" PORT="CompanyId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="InstitutionId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="InstitutionId"><B>InstitutionId</B></TD><TD ALIGN="RIGHT" PORT="InstitutionId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="RelationshipId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="RelationshipId"><B>RelationshipId</B></TD><TD ALIGN="RIGHT" PORT="RelationshipId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="AccountTypeId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="AccountTypeId"><B>AccountTypeId</B></TD><TD ALIGN="RIGHT" PORT="AccountTypeId"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="MasterAccountId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="MasterAccountId"><B>MasterAccountId</B></TD><TD ALIGN="RIGHT" PORT="MasterAccountId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="CurrencyId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="CurrencyId"><B>CurrencyId</B></TD><TD ALIGN="RIGHT" PORT="CurrencyId"><FONT COLOR="#6B7280" P