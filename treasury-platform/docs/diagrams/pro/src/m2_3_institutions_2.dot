digraph G {
  graph [fontname="DejaVu Sans", label=<<B><FONT POINT-SIZE="16">م2–م3 · الجهات المالية والحسابات والمفوّضون (2/2)</FONT></B><BR/><FONT POINT-SIZE="10" COLOR="#4B5563">Institutions, bank accounts &amp; signatories</FONT>>, labelloc=t, rankdir=LR, splines=ortho, nodesep=0.45, ranksep=1.7, pad=0.35, bgcolor="white", dpi=110];
