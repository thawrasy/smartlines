  "cat.ProductFeeType" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">cat</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>ProductFeeType</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ProductFeeTypeId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="ProductFeeTypeId"><B>ProductFeeTypeId</B></TD><TD ALIGN="RIGHT" PORT="ProductFeeTypeId"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ProductId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="ProductId"><B>ProductId</B></TD><TD ALIGN="RIGHT" PORT="ProductId"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="FeeTypeId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="FeeTypeId"><B>FeeTypeId</B></TD><TD ALIGN="RIGHT" PORT="FeeTypeId"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">IsExpected</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">smallint</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 3 more columns</I></FONT></TD></TR></TABLE>>];
  "cat.ProductFinancingType" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">cat</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>ProductFinancingType</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ProductFinancingTypeId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="ProductFinancingTypeId"><B>ProductFinancingTypeId</B></TD><TD ALIGN="RIGHT" PORT="ProductFinancingTypeId"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ProductId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="ProductId"><B>ProductId</B></TD><TD ALIGN="RIGHT" PORT="ProductId"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="FinancingTypeId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="FinancingTypeId"><B>FinancingTypeId</B></TD><TD ALIGN="RIGHT" PORT="FinancingTypeId"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">IsDefault</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">smallint</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 3 more columns</I></FONT></TD></TR></TABLE>>];
  "cat.FacilityType" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">cat</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>FacilityType</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="FacilityTypeId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="FacilityTypeId"><B>FacilityTypeId</B></TD><TD ALIGN="RIGHT" PORT="FacilityTypeId"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Compliance</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(12)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 13 more columns</I></FONT></TD></TR></TABLE>>];
  "cat.ProductCategory":"ProductCategoryId":e -> "cat.Product":"ProductCategoryId":w [dir=both, arrowtail=tee, arrowhead=crow, style=solid, color="#374151", arrowsize=0.7];
  "cat.Product":"ProductId":e -> "cat.ProductFeeType":"ProductId":w [dir=both, arrowtail=tee, arrowhead=crow, style=solid, color="#374151", arrowsize=0.7];
