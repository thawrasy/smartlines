digraph G {
  graph [fontname="DejaVu Sans", label=<<B><FONT POINT-SIZE="16">م0 · المشترك والاشتراكات والمشغّلون</FONT></B><BR/><FONT POINT-SIZE="10" COLOR="#4B5563">Tenancy &amp; platform operators</FONT>>, labelloc=t, rankdir=LR, splines=ortho, nodesep=0.45, ranksep=1.7, pad=0.35, bgcolor="white", dpi=110];
  node [fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=8, color="#374151", arrowsize=0.75];
  "plat.Plan" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">plat</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>Plan</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="PlanId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="PlanId"><B>PlanId</B></TD><TD ALIGN="RIGHT" PORT="PlanId"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Code</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(30)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">NameAr</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">NameEn</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">MaxUsers</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">integer</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 6 more columns</I></FONT></TD></TR></TABLE>>];
  "plat.PlanModule" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">plat</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>PlanModule</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="PlanId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="PlanId"><B>PlanId</B></TD><TD ALIGN="RIGHT" PORT="PlanId"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ModuleCode"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="ModuleCode"><B>ModuleCode</B></TD><TD ALIGN="RIGHT" PORT="ModuleCode"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(12)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 4 more columns</I></FONT></TD></TR></TABLE>>];
  "plat.PlatformOperator" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">plat</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>PlatformOperator</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="PlatformOperatorId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="PlatformOperatorId"><B>PlatformOperatorId</B></TD><TD ALIGN="RIGHT" PORT="PlatformOperatorId"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Email</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(254)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Role</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(16)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Status</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">DisplayName</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(200)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 14 more columns</I></FONT></TD></TR></TABLE>>];
  "plat.ReservedSubdomain" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">plat</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>ReservedSubdomain</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ReservedSubdomainId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="ReservedSubdomainId"><B>ReservedSubdomainId</B></TD><TD ALIGN="RIGHT" PORT="ReservedSubdomainId"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Subdomain</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(63)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Reason</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(200)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 3 more columns</I></FONT></TD></TR></TABLE>>];
  "plat.SupportAccessGrant" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">plat</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>SupportAccessGrant</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="SupportAccessGrantId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="SupportAccessGrantId"><B>SupportAccessGrantId</B></TD><TD ALIGN="RIGHT" PORT="SupportAccessGrantId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="OperatorId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="OperatorId"><B>OperatorId</B></TD><TD ALIGN="RIGHT" PORT="OperatorId"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="GrantedBy"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="GrantedBy"><B>GrantedBy</B></TD><TD ALIGN="RIGHT" PORT="GrantedBy"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="RevokedBy"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="RevokedBy"><B>RevokedBy</B></TD><TD ALIGN="RIGHT" PORT="RevokedBy"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">StartsAt</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">timestamp(3)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">EndsAt</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">timestamp(3)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Reason</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(500)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">RevokedAt</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">timestamp(3)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 3 more columns</I></FONT></TD></TR></TABLE>>];
  "plat.Tenant" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">plat</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>Tenant</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="TenantId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="TenantId"><B>TenantId</B></TD><TD ALIGN="RIGHT" PORT="TenantId"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="PlanId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="PlanId"><B>PlanId</B></TD><TD ALIGN="RIGHT" PORT="PlanId"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="HomeCountryId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="HomeCountryId"><B>HomeCountryId</B></TD><TD ALIGN="RIGHT" PORT="HomeCountryId"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Code</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(30)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">NameAr</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">NameEn</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">TrialEndsOn</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">date</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 13 more columns</I></FONT></TD></TR></TABLE>>];
  "plat.TenantModule" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">plat</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>TenantModule</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="TenantModuleId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="TenantModuleId"><B>TenantModuleId</B></TD><TD ALIGN="RIGHT" PORT="TenantModuleId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="EnabledBy"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="EnabledBy"><B>EnabledBy</B></TD><TD ALIGN="RIGHT" PORT="EnabledBy"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">ModuleCode</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(12)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">IsEnabled</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">EnabledAt</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">timestamp(3)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 3 more columns</I></FONT></TD></TR></TABLE>>];
  "ref.Country" [shape=box, style="rounded,dashed", color="#6B7280", fontcolor="#374151", margin="0.12,0.05", label="ref.Country"];
  "sec.AppUser" [shape=box, style="rounded,dashed", color="#6B7280", fontcolor="#374151", margin="0.12,0.05", label="sec.AppUser"];
  "plat.Plan":"PlanId":e -> "plat.PlanModule":"PlanId":w [dir=both, arrowtail=tee, arrowhead=crow, style=solid, color="#374151", arrowsize=0.7];
  "plat.PlatformOperator":"PlatformOperatorId":e -> "plat.SupportAccessGrant":"OperatorId":w [dir=both, arrowtail=tee, arrowhead=crow, style=solid, color="#374151", arrowsize=0.7];
  "sec.AppUser" -> "plat.SupportAccessGrant":"GrantedBy":w [dir=both, arrowtail=tee, arrowhead=crow, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "sec.AppUser" -> "plat.SupportAccessGrant":"RevokedBy":w [dir=both, arrowtail=tee, arrowhead=crowodot, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "plat.Plan":"PlanId":e -> "plat.Tenant":"PlanId":w [dir=both, arrowtail=tee, arrowhead=crow, style=solid, color="#374151", arrowsize=0.7];
  "ref.Country" -> "plat.Tenant":"HomeCountryId":w [dir=both, arrowtail=tee, arrowhead=crow, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "plat.PlatformOperator":"PlatformOperatorId":e -> "plat.TenantModule":"EnabledBy":w [dir=both, arrowtail=tee, arrowhead=crowodot, style=solid, color="#374151", arrowsize=0.7];
}
