digraph G {
  graph [fontname="DejaVu Sans", label=<<B><FONT POINT-SIZE="16">م1 · الأشخاص والهوية والاكتمال (2/2)</FONT></B><BR/><FONT POINT-SIZE="10" COLOR="#4B5563">Parties, identity documents &amp; KYC</FONT>>, labelloc=t, rankdir=LR, splines=true, nodesep=0.35, ranksep=1.25, pad=0.35, bgcolor="white", dpi=110];
  node [fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=8, color="#374151", arrowsize=0.75];
  "pty.Party" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">pty</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>Party</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><B>CountryId</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><B>BirthCountryId</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><B>EducationLevelId</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><B>LinkedCompanyId</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><B>MergedIntoPartyId</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">PartyCode</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Kind</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(12)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">IsActive</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">NameAr</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(200)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 13 more columns</I></FONT></TD></TR></TABLE>>];
  "pty.PartyCompliance" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">pty</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>PartyCompliance</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><B>PartyId</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><B>CompanyId</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><B>SourceDocumentId</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Capacity</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(16)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">DeclaredOn</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">date</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">IsCurrent</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Details</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">text</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 9 more columns</I></FONT></TD></TR></TABLE>>];
  "pty.PartyCustomField" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">pty</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>PartyCustomField</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><B>PartyId</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><B>DefinitionId</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><B>EncKeyId</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><B>CurrencyId</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">ValueText</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(1000)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 6 more columns</I></FONT></TD></TR></TABLE>>];
  "pty.TaxIdentity" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">pty</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>TaxIdentity</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><B>PartyId</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><B>CountryId</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><B>FatcaClassificationId</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><B>CrsClassificationId</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><B>SourceDocumentId</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">DeclarationDate</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">date</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">IsCurrent</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">TaxNumber</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(40)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 5 more columns</I></FONT></TD></TR></TABLE>>];
  "cat.LookupItem" [shape=box, style="rounded,dashed", color="#6B7280", fontcolor="#374151", margin="0.12,0.05", label="cat.LookupItem"];
  "doc.Document" [shape=box, style="rounded,dashed", color="#6B7280", fontcolor="#374151", margin="0.12,0.05", label="doc.Document"];
  "org.Company" [shape=box, style="rounded,dashed", color="#6B7280", fontcolor="#374151", margin="0.12,0.05", label="org.Company"];
  "pty.CustomFieldDefinition" [shape=box, style="rounded,dashed", color="#6B7280", fontcolor="#374151", margin="0.12,0.05", label="pty.CustomFieldDefinition"];
  "ref.Country" [shape=box, style="rounded,dashed", color="#6B7280", fontcolor="#374151", margin="0.12,0.05", label="ref.Country"];
  "ref.Currency" [shape=box, style="rounded,dashed", color="#6B7280", fontcolor="#374151", margin="0.12,0.05", label="ref.Currency"];
  "sec.TenantKey" [shape=box, style="rounded,dashed", color="#6B7280", fontcolor="#374151", margin="0.12,0.05", label="sec.TenantKey"];
  "cat.LookupItem" -> "pty.Party" [dir=both, arrowtail=tee, arrowhead=crowodot, style=dashed, color="#9CA3AF", fontcolor="#9CA3AF", label="EducationLevelId"];
  "cat.LookupItem" -> "pty.TaxIdentity" [dir=both, arrowtail=tee, arrowhead=crowodot, style=dashed, color="#9CA3AF", fontcolor="#9CA3AF", label="CrsClassificationId\nFatcaClassificationId"];
  "doc.Document" -> "pty.PartyCompliance" [dir=both, arrowtail=tee, arrowhead=crowodot, style=dashed, color="#9CA3AF", fontcolor="#9CA3AF", label="SourceDocumentId"];
  "doc.Document" -> "pty.TaxIdentity" [dir=both, arrowtail=tee, arrowhead=crowodot, style=dashed, color="#9CA3AF", fontcolor="#9CA3AF", label="SourceDocumentId"];
  "org.Company" -> "pty.Party" [dir=both, arrowtail=tee, arrowhead=crowodot, style=dashed, color="#9CA3AF", fontcolor="#9CA3AF", label="LinkedCompanyId"];
  "org.Company" -> "pty.PartyCompliance" [dir=both, arrowtail=tee, arrowhead=crowodot, style=dashed, color="#9CA3AF", fontcolor="#9CA3AF", label="CompanyId"];
  "pty.CustomFieldDefinition" -> "pty.PartyCustomField" [dir=both, arrowtail=tee, arrowhead=crow, style=dashed, color="#9CA3AF", fontcolor="#9CA3AF", label="DefinitionId"];
  "pty.Party" -> "pty.Party" [dir=both, arrowtail=tee, arrowhead=crowodot, style=solid, color="#374151", fontcolor="#374151", label="MergedIntoPartyId"];
  "pty.Party" -> "pty.PartyCompliance" [dir=both, arrowtail=tee, arrowhead=crow, style=solid, color="#374151", fontcolor="#374151", label="PartyId"];
  "pty.Party" -> "pty.PartyCustomField" [dir=both, arrowtail=tee, arrowhead=crow, style=solid, color="#374151", fontcolor="#374151", label="PartyId"];
  "pty.Party" -> "pty.TaxIdentity" [dir=both, arrowtail=tee, arrowhead=crow, style=solid, color="#374151", fontcolor="#374151", label="PartyId"];
  "ref.Country" -> "pty.Party" [dir=both, arrowtail=tee, arrowhead=crowodot, style=dashed, color="#9CA3AF", fontcolor="#9CA3AF", label="BirthCountryId\nCountryId"];
  "ref.Country" -> "pty.TaxIdentity" [dir=both, arrowtail=tee, arrowhead=crow, style=dashed, color="#9CA3AF", fontcolor="#9CA3AF", label="CountryId"];
  "ref.Currency" -> "pty.PartyCustomField" [dir=both, arrowtail=tee, arrowhead=crowodot, style=dashed, color="#9CA3AF", fontcolor="#9CA3AF", label="CurrencyId"];
  "sec.TenantKey" -> "pty.PartyCustomField" [dir=both, arrowtail=tee, arrowhead=crowodot, style=dashed, color="#9CA3AF", fontcolor="#9CA3AF", label="EncKeyId"];
}
