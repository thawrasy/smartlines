digraph G {
  graph [fontname="DejaVu Sans", label=<<B><FONT POINT-SIZE="16">م4 · الأسعار المرجعية والقوائم</FONT></B><BR/><FONT POINT-SIZE="10" COLOR="#4B5563">Base rates &amp; lookup lists</FONT>>, labelloc=t, rankdir=LR, splines=true, nodesep=0.35, ranksep=1.25, pad=0.35, bgcolor="white", dpi=110];
  node [fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=8, color="#374151", arrowsize=0.75];
  "cat.OperationType" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">cat</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>OperationType</B></FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">SupportsCeiling</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">OperationGroup</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(14)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 14 more columns</I></FONT></TD></TR></TABLE>>];
  "cat.OperationTypePowerType" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">cat</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>OperationTypePowerType</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>OperationTypeId</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>PowerTypeId</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 4 more columns</I></FONT></TD></TR></TABLE>>];
  "cat.BaseRate" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">cat</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>BaseRate</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><B>InstitutionId</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><B>CurrencyId</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Kind</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(13)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">FamilyCode</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(40)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Tenor</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">StaleAfterDays</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">integer</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 14 more columns</I></FONT></TD></TR></TABLE>>];
  "cat.BaseRateAlias" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">cat</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>BaseRateAlias</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><B>BaseRateId</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><B>InstitutionId</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Tenor</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Alias</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(60)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">AliasKey</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(60)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 4 more columns</I></FONT></TD></TR></TABLE>>];
  "cat.BaseRateValue" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">cat</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>BaseRateValue</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><B>BaseRateId</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><B>SupersedesId</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><B>EnteredBy</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">EffectiveDate</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">date</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">ValuePct</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">numeric(9,6)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Source</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">SourceNote</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(300)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 6 more columns</I></FONT></TD></TR></TABLE>>];
  "cat.LookupList" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">cat</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>LookupList</B></FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Scope</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">AllowTenantItems</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">AttributeSchema</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">text</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 14 more columns</I></FONT></TD></TR></TABLE>>];
  "cat.LookupItem" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">cat</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>LookupItem</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><B>LookupListId</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Code</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(80)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">NameAr</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Status</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">NameEn</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(200)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 12 more columns</I></FONT></TD></TR></TABLE>>];
  "cat.PowerType" [shape=box, style="rounded,dashed", color="#6B7280", fontcolor="#374151", margin="0.12,0.05", label="cat.PowerType"];
  "ins.Institution" [shape=box, style="rounded,dashed", color="#6B7280", fontcolor="#374151", margin="0.12,0.05", label="ins.Institution"];
  "ref.Currency" [shape=box, style="rounded,dashed", color="#6B7280", fontcolor="#374151", margin="0.12,0.05", label="ref.Currency"];
  "sec.AppUser" [shape=box, style="rounded,dashed", color="#6B7280", fontcolor="#374151", margin="0.12,0.05", label="sec.AppUser"];
  "cat.BaseRate" -> "cat.BaseRateAlias" [dir=both, arrowtail=tee, arrowhead=crow, style=solid, color="#374151", fontcolor="#374151", label="BaseRateId"];
  "cat.BaseRate" -> "cat.BaseRateValue" [dir=both, arrowtail=tee, arrowhead=crow, style=solid, color="#374151", fontcolor="#374151", label="BaseRateId"];
  "cat.BaseRateValue" -> "cat.BaseRateValue" [dir=both, arrowtail=tee, arrowhead=crowodot, style=solid, color="#374151", fontcolor="#374151", label="SupersedesId"];
  "cat.LookupList" -> "cat.LookupItem" [dir=both, arrowtail=tee, arrowhead=crow, style=solid, color="#374151", fontcolor="#374151", label="LookupListId"];
  "cat.OperationType" -> "cat.OperationTypePowerType" [dir=both, arrowtail=tee, arrowhead=crow, style=solid, color="#374151", fontcolor="#374151", label="OperationTypeId"];
  "cat.PowerType" -> "cat.OperationTypePowerType" [dir=both, arrowtail=tee, arrowhead=crow, style=dashed, color="#9CA3AF", fontcolor="#9CA3AF", label="PowerTypeId"];
  "ins.Institution" -> "cat.BaseRate" [dir=both, arrowtail=tee, arrowhead=crowodot, style=dashed, color="#9CA3AF", fontcolor="#9CA3AF", label="InstitutionId"];
  "ins.Institution" -> "cat.BaseRateAlias" [dir=both, arrowtail=tee, arrowhead=crowodot, style=dashed, color="#9CA3AF", fontcolor="#9CA3AF", label="InstitutionId"];
  "ref.Currency" -> "cat.BaseRate" [dir=both, arrowtail=tee, arrowhead=crowodot, style=dashed, color="#9CA3AF", fontcolor="#9CA3AF", label="CurrencyId"];
  "sec.AppUser" -> "cat.BaseRateValue" [dir=both, arrowtail=tee, arrowhead=crow, style=dashed, color="#9CA3AF", fontcolor="#9CA3AF", label="EnteredBy"];
}
