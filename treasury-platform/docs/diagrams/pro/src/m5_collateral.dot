  "ref.Currency" -> "col.ValuationSchedule" [dir=both, arrowtail=tee, arrowhead=crowodot, style=dashed, color="#9CA3AF", fontcolor="#9CA3AF", label="CurrencyId"];
  "sec.AppUser" -> "col.Collateral" [dir=both, arrowtail=tee, arrowhead=crowodot, style=dashed, color="#9CA3AF", fontcolor="#9CA3AF", label="ApprovedBy\nVerifiedBy"];
