digraph G {
  graph [fontname="DejaVu Sans", label=<<B><FONT POINT-SIZE="16">م0 · الجلسات والمفاتيح والمحاولات</FONT></B><BR/><FONT POINT-SIZE="10" COLOR="#4B5563">Sessions, keys &amp; attempts</FONT>>, labelloc=t, rankdir=LR, splines=ortho, nodesep=0.45, ranksep=1.7, pad=0.35, bgcolor="white", dpi=110];
  node [fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=8, color="#374151", arrowsize=0.75];
  "sec.UserSession" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">sec</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>UserSession</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="UserSessionId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="UserSessionId"><B>UserSessionId</B></TD><TD ALIGN="RIGHT" PORT="UserSessionId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="UserId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="UserId"><B>UserId</B></TD><TD ALIGN="RIGHT" PORT="UserId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="EndedBy"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="EndedBy"><B>EndedBy</B></TD><TD ALIGN="RIGHT" PORT="EndedBy"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">TokenHash</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">bytea</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">LastSeenAt</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">timestamp(3)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">IdleExpiresAt</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">timestamp(3)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">MfaVerifiedAt</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">timestamp(3)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 8 more columns</I></FONT></TD></TR></TABLE>>];
  "sec.LoginAttempt" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">sec</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>LoginAttempt</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="LoginAttemptId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="LoginAttemptId"><B>LoginAttemptId</B></TD><TD ALIGN="RIGHT" PORT="LoginAttemptId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="UserId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="UserId"><B>UserId</B></TD><TD ALIGN="RIGHT" PORT="UserId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Outcome</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(15)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">LoginName</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(200)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 3 more columns</I></FONT></TD></TR></TABLE>>];
  "sec.MfaRecoveryCode" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">sec</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>MfaRecoveryCode</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="MfaRecoveryCodeId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="MfaRecoveryCodeId"><B>MfaRecoveryCodeId</B></TD><TD ALIGN="RIGHT" PORT="MfaRecoveryCodeId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="UserId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="UserId"><B>UserId</B></TD><TD ALIGN="RIGHT" PORT="UserId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">CodeHash</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">bytea</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">UsedAt</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">timestamp(3)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 4 more columns</I></FONT></TD></TR></TABLE>>];
  "sec.UserToken" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">sec</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>UserToken</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="UserTokenId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="UserTokenId"><B>UserTokenId</B></TD><TD ALIGN="RIGHT" PORT="UserTokenId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="UserId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="UserId"><B>UserId</B></TD><TD ALIGN="RIGHT" PORT="UserId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="RequestedByUserId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="RequestedByUserId"><B>RequestedByUserId</B></TD><TD ALIGN="RIGHT" PORT="RequestedByUserId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Purpose</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(14)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">TokenHash</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">bytea</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">ExpiresAt</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">timestamp(3)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">UsedAt</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">timestamp(3)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 8 more columns</I></FONT></TD></TR></TABLE>>];
  "sec.UserPasswordHistory" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">sec</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>UserPasswordHistory</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="UserPasswordHistoryId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="UserPasswordHistoryId"><B>UserPasswordHistoryId</B></TD><TD ALIGN="RIGHT" PORT="UserPasswordHistoryId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="UserId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="UserId"><B>UserId</B></TD><TD ALIGN="RIGHT" PORT="UserId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">PasswordHash</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(255)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 1 more columns</I></FONT></TD></TR></TABLE>>];
  "sec.TenantKey" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">sec</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>TenantKey</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="TenantKeyId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="TenantKeyId"><B>TenantKeyId</B></TD><TD ALIGN="RIGHT" PORT="TenantKeyId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Purpose</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(11)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">KeyVersion</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Status</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">ActivatedAt</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">timestamp(3)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 7 more columns</I></FONT></TD></TR></TABLE>>];
  "sec.KeyEvent" [shape=plain, label=<<TABLE BORDER="1" COLOR="#8A7A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF4C7" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#7A6A2E">sec</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><B>KeyEvent</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="KeyEventId"><FONT COLOR="#1D4E89"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="KeyEventId"><B>KeyEventId</B></TD><TD ALIGN="RIGHT" PORT="KeyEventId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="TenantKeyId"><FONT COLOR="#B45309"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="TenantKeyId"><B>TenantKeyId</B></TD><TD ALIGN="RIGHT" PORT="TenantKeyId"><FONT COLOR="#6B7280" POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">EventType</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(18)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">ActorType</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Result</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">ActorId</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B7280"><I>+ 3 more columns</I></FONT></TD></TR></TABLE>>];
  "sec.AppUser" [shape=box, style="rounded,dashed", color="#6B7280", fontcolor="#374151", margin="0.12,0.05", label="sec.AppUser"];
  "sec.AppUser" -> "sec.UserSession":"UserId":w [dir=both, arrowtail=tee, arrowhead=crow, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "sec.AppUser" -> "sec.UserSession":"EndedBy":w [dir=both, arrowtail=tee, arrowhead=crowodot, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "sec.AppUser" -> "sec.LoginAttempt":"UserId":w [dir=both, arrowtail=tee, arrowhead=crowodot, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "sec.AppUser" -> "sec.MfaRecoveryCode":"UserId":w [dir=both, arrowtail=tee, arrowhead=crow, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "sec.AppUser" -> "sec.UserToken":"UserId":w [dir=both, arrowtail=tee, arrowhead=crow, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "sec.AppUser" -> "sec.UserToken":"RequestedByUserId":w [dir=both, arrowtail=tee, arrowhead=crowodot, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "sec.AppUser" -> "sec.UserPasswordHistory":"UserId":w [dir=both, arrowtail=tee, arrowhead=crow, style=dashed, color="#9CA3AF", arrowsize=0.7];
  "sec.TenantKey":"TenantKeyId":e -> "sec.KeyEvent":"TenantKeyId":w [dir=both, arrowtail=tee, arrowhead=crowodot, style=solid, color="#374151", arrowsize=0.7];
}
