# Copy to deploy/.env and fill in. Generate secrets with: openssl rand -base64 36
# The env file is read by docker compose: keep it out of version control.

# Public domain name (DNS must point to this server). Use "localhost" for a local trial.
MASSLAK_DOMAIN=masslak.example.sy

# Database superuser (used only by the migration step)
POSTGRES_DB=masslak
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Login roles created by the migration step
MASSLAK_API_PASSWORD=
MASSLAK_AUDIT_PASSWORD=

# Signs ticket QR codes and verification links (32+ random characters, never change after launch)
MASSLAK_SIGNING_SECRET=

MASSLAK_COOKIE_SECURE=true
MASSLAK_SESSION_HOURS=12

# Test servers only: simulated payment gateway and demo accounts. Keep false in production.
MASSLAK_SANDBOX=false
MASSLAK_SEED_DEMO=false
