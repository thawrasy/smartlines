# Masslak server settings. Create deploy/.env with ./deploy/init-env.sh (it fills every secret with random
# values) or copy this file and fill it in by hand. Never commit deploy/.env.

# ---------------------------------------------------------------- site
# Public domain. Point its DNS A/AAAA record at the server first; Caddy then obtains the HTTPS certificate.
# "localhost" serves a self-signed certificate (local trial only).
MASSLAK_DOMAIN=masslak.com
# E-mail address for the certificate authority (expiry and incident notices)
MASSLAK_ACME_EMAIL=ops@masslak.com
# Interface language shown to first-time visitors: ar or en (both are always available)
MASSLAK_DEFAULT_LOCALE=ar
# Search console ownership: the content of the verification meta tag Google Search Console / Bing Webmaster Tools give you
MASSLAK_GOOGLE_SITE_VERIFICATION=
MASSLAK_BING_SITE_VERIFICATION=
# Contact details on the public contact page (/ar/contact, /en/contact); a line is hidden while its value is empty
MASSLAK_SUPPORT_EMAIL=
MASSLAK_SUPPORT_PHONE=
MASSLAK_SUPPORT_WHATSAPP=
MASSLAK_BUSINESS_EMAIL=
MASSLAK_OFFICE_ADDRESS=
MASSLAK_SUPPORT_HOURS=

# ---------------------------------------------------------------- mode
# Test server: simulated payment gateway and demo data with shared demo passwords.
# Production: both false. Never enable either on a server with real users.
MASSLAK_SANDBOX=false
MASSLAK_SEED_DEMO=false
# Which environment this server is: production, staging (the firm running the launch gates) or development (trial
# and demo servers). Launch gate evidence is filed under it; only staging and production evidence passes a gate.
MASSLAK_ENVIRONMENT=production

# ---------------------------------------------------------------- database
POSTGRES_DB=masslak
POSTGRES_USER=postgres
# Superuser: used only by the migration step and backups
POSTGRES_PASSWORD=
# Login role of the API (row-level security applies) and of the read-only security console
MASSLAK_API_PASSWORD=
MASSLAK_AUDIT_PASSWORD=
# Replication role of the read replica (service db-replica): reports and exports read the replica
MASSLAK_REPLICATION_PASSWORD=
# Data warehouse (optional, deploy/warehouse): the replication login its subscription uses on the primary, the
# warehouse's own superuser, and the analysts' read-only login. Empty: no warehouse login exists on the primary.
MASSLAK_CDC_PASSWORD=
MASSLAK_DW_PASSWORD=
MASSLAK_DW_ANALYST_PASSWORD=
# Telemetry database for vehicle positions (optional, deploy/telemetry): its superuser, the API's append-only login and
# the worker's upkeep login (the only one that drops days past the retention, C-02).
MASSLAK_TELEMETRY_OWNER_PASSWORD=
MASSLAK_TELEMETRY_PASSWORD=
MASSLAK_TELEMETRY_UPKEEP_PASSWORD=

# ---------------------------------------------------------------- keys (keep in a secret store; losing them loses data)
# By hand, one key: python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Never change MASSLAK_FIELD_KEYS (rotate instead, see README), MASSLAK_BIDX_KEY or the signing keys after launch.
# The secret the platform's own keys are derived from: database context tickets (deploy/migrate.sh writes the
# database's copy), identifier hashes (blocked identifiers, sign-in limits) and, on a test server, the token and data keys.
# Changing it makes the blocked identifiers unknown.
MASSLAK_SIGNING_SECRET=
# Rotating ticket QR codes and the verification tokens printed on documents, each with keys of its own:
# kid:base64 of 32 bytes, comma separated. The first signs and every one listed verifies, so a rotation puts the new key
# first and keeps the old one until the tokens it signed are no longer needed (a day for QR codes; documents as long as
# they are checked). Required in production; unset on a test server, keys derived from MASSLAK_SIGNING_SECRET are used.
MASSLAK_QR_KEYS=
MASSLAK_DOCUMENT_KEYS=
# AES-256-GCM keys for identity document numbers, MFA secrets and uploaded files, comma separated:
# <key reference from sec.key_registry>=<base64 32 bytes>. Test servers only: a production server's data keys are made
# by the key service and stored wrapped (below); a key still given here is adopted (wrapped) by the first migration,
# after which it is removed from this file.
MASSLAK_FIELD_KEYS=
# HMAC key for blind indexes (searching encrypted identity numbers): base64 32 bytes; test servers only, as above
MASSLAK_BIDX_KEY=
# Ed25519 seed that signs offline ticket credentials (base64 32 bytes). The apps receive only the public key.
MASSLAK_TICKET_SIGNING_KEY=

# ---------------------------------------------------------------- production profile (docs/operations/PRODUCTION_PROFILE.md)
# The key service (required in production): Vault Transit wraps the data keys; the token may only encrypt and decrypt
# with the transit key MASSLAK_VAULT_TRANSIT_KEY. MASSLAK_VAULT_CA_FILE: the authority of Vault's certificate when it is
# not a public one, copied into deploy/production/trust (e.g. /etc/masslak/trust/vault-ca.crt).
MASSLAK_KMS_PROVIDER=
MASSLAK_VAULT_ADDR=
MASSLAK_VAULT_TOKEN=
MASSLAK_VAULT_TRANSIT_KEY=masslak-field
MASSLAK_VAULT_CA_FILE=
# WAL archiving off this host (required in production): pgBackRest's repository, as pgBackRest's own settings. Object
# storage (s3, gcs, azure), sftp, or a repository host; the repository is encrypted with the cipher pass.
PGBACKREST_REPO1_TYPE=
PGBACKREST_REPO1_PATH=/pgbackrest
PGBACKREST_REPO1_S3_BUCKET=
PGBACKREST_REPO1_S3_ENDPOINT=
PGBACKREST_REPO1_S3_REGION=
PGBACKREST_REPO1_S3_KEY=
PGBACKREST_REPO1_S3_KEY_SECRET=
PGBACKREST_REPO1_CIPHER_PASS=
# the warehouse's address (an address or a network, e.g. 10.0.4.12/32): the only place masslak_cdc may sign in from,
# with the client certificate of deploy/production/tls/masslak_cdc.crt
MASSLAK_WAREHOUSE_ADDRESS=
# further names for the database's certificate (comma separated), when clients reach it by another name
MASSLAK_DB_TLS_NAMES=
# where the database runs (H-01, docs/operations/HIGH_AVAILABILITY.md): ha, on two database hosts with automatic
# failover (Patroni, etcd, HAProxy), or single (the default), on this host. A production server on one host needs the
# owner's written acceptance, who and when (losing the host then means a restore of about 30 minutes, not a failover).
MASSLAK_DB_LAYOUT=
MASSLAK_SINGLE_HOST_ACCEPTED=
# with ha: the database hosts' private IPv4 addresses (two, comma separated), this host's private address (the third
# etcd member), and optionally the private network's range for pg_hba.conf (the hosts' own networks by default).
# deploy/production/init.sh writes MASSLAK_PATRONI_REST_PASSWORD and MASSLAK_ETCD_TOKEN, and each host's bundle.
MASSLAK_DB_HOSTS=
MASSLAK_DB_WITNESS=
MASSLAK_DB_NETWORK=
# the second site's node_exporter (host:port), scraped by Prometheus for the watchdog's figures
MASSLAK_SITE_B_METRICS=
# the token Prometheus reads the API's metrics with (deploy/production/init.sh writes one)
MASSLAK_METRICS_TOKEN=

# ---------------------------------------------------------------- durability and backups
# on: every commit waits until the standby has it, so nothing the platform confirmed is lost with the primary (owner's
# decision 1); with no standby able to confirm, the platform waits rather than confirm without a copy. off: the
# primary confirms alone. Applied by deploy/durability.sh (install and update), on two database hosts through Patroni.
MASSLAK_ZERO_DATA_LOSS=on
# where each nightly backup is copied off this server, for rclone: a remote and path ("offsite:masslak-backups",
# configured with rclone config) or a mounted path. Required outside the sandbox (alert BackupOffsiteStale).
MASSLAK_BACKUP_OFFSITE=
# logs: one JSON object per line (json, the default outside the sandbox) or the classic text lines (text)
MASSLAK_LOG_FORMAT=json
# report files built at once per API process, each in its own thread (a burst beyond waits, then gets 503 EXPORT_BUSY)
MASSLAK_EXPORT_RENDER_SLOTS=2

# ---------------------------------------------------------------- notifications
# smtp / http: real delivery. off (or empty): nothing is sent on that channel, in-app notifications only.
# log: messages, addresses included, are written to a file on the server; sandbox only, refused in production.
MASSLAK_NOTIFY_EMAIL=off
MASSLAK_SMTP_URL=
MASSLAK_MAIL_FROM=Masslak <no-reply@masslak.com>
MASSLAK_NOTIFY_SMS=off
MASSLAK_SMS_URL=
MASSLAK_SMS_TOKEN=
# WhatsApp sign-in codes (two-factor sign-in, decision 2): cloud sends through the WhatsApp Business Cloud API with an
# approved authentication template whose body takes the code.
MASSLAK_NOTIFY_WHATSAPP=off
MASSLAK_WHATSAPP_URL=
MASSLAK_WHATSAPP_TOKEN=
MASSLAK_WHATSAPP_TEMPLATE=masslak_sign_in_code

# ---------------------------------------------------------------- file store (documents and generated reports)
# local: the "files" volume of this server. s3: an S3-compatible object store (AWS S3, MinIO, SeaweedFS, Ceph, ...),
# shared by every API server; required when more than one server runs the API. Files are encrypted by the platform
# before they leave it, and every write also asks the store for server-side encryption and is refused unless the
# store confirms it. Move existing files with python -m app.tools.files_move (docs/operations/RUNBOOKS.md, section 24).
MASSLAK_FILES_BACKEND=local
# https only outside the sandbox; the bucket needs versioning (and replication or object lock) for backups
MASSLAK_FILES_S3_ENDPOINT=
MASSLAK_FILES_S3_BUCKET=
MASSLAK_FILES_S3_REGION=us-east-1
MASSLAK_FILES_S3_PREFIX=
# credentials of a user that may only read and write objects in this bucket
MASSLAK_FILES_S3_ACCESS_KEY=
MASSLAK_FILES_S3_SECRET_KEY=
# AES256 (keys managed by the store) or aws:kms (with MASSLAK_FILES_S3_KMS_KEY_ID, empty for the bucket's default key)
MASSLAK_FILES_S3_SSE=AES256
MASSLAK_FILES_S3_KMS_KEY_ID=
# true: bucket in the path (most self-hosted stores); false: in the host name (bucket.s3.amazonaws.com)
MASSLAK_FILES_S3_PATH_STYLE=true
# true for a store outside this server's private network: through the egress proxy, its domain allowlisted
MASSLAK_FILES_S3_VIA_PROXY=false

# ---------------------------------------------------------------- sessions
MASSLAK_SESSION_HOURS=12
MASSLAK_COOKIE_SECURE=true

# ---------------------------------------------------------------- backups (deploy/backup.sh)
# Directory on the server for nightly backups, and how many days to keep them
MASSLAK_BACKUP_DIR=/var/backups/masslak
MASSLAK_BACKUP_KEEP_DAYS=14
# Encrypts backups with age (https://age-encryption.org): the public key (age1...) here, the private key off the server.
# Required on a production server (MASSLAK_SANDBOX=false): deploy/backup.sh refuses to write plain backups there.
MASSLAK_BACKUP_AGE_RECIPIENT=
# Restore only: path to the age private key file
MASSLAK_BACKUP_AGE_IDENTITY=
