{
 "title": "Masslak operations",
 "uid": "masslak-ops",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "datasource",
    "type": "datasource",
    "query": "prometheus"
   }
  ]
 },
 "panels": [
  {
   "type": "stat",
   "title": "Wallet mismatches",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "masslak_wallet_mismatches",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Outbox oldest (s)",
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 300
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "masslak_outbox_oldest_pending_seconds",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Position partitions missing",
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "masslak_geo_partitions_missing",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "WAL archive age (s)",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 300
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "masslak_db_wal_archive_last_success_age_seconds",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Upkeep age (h)",
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "h",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 26
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "masslak_job_last_success_age_seconds{job=\"maintenance\"} / 3600",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Break-glass open",
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "masslak_break_glass_open",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Requests per second by group",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (group) (rate(masslak_http_requests_total[5m]))",
     "legendFormat": "{{group}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "5xx ratio by group",
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (group) (rate(masslak_http_requests_total{status=\"5xx\"}[5m])) / sum by (group) (rate(masslak_http_requests_total[5m]))",
     "legendFormat": "{{group}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "p95 latency by group",
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le, group) (rate(masslak_http_request_duration_seconds_bucket[5m])))",
     "legendFormat": "{{group}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "p99 latency by group",
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.99, sum by (le, group) (rate(masslak_http_request_duration_seconds_bucket[5m])))",
     "legendFormat": "{{group}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Outbox and deliveries",
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "masslak_outbox_pending",
     "legendFormat": "pending events",
     "refId": "A"
    },
    {
     "expr": "masslak_webhook_deliveries",
     "legendFormat": "deliveries {{status}}",
     "refId": "B"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Connections and locks",
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(masslak_db_connections)",
     "legendFormat": "connections",
     "refId": "A"
    },
    {
     "expr": "masslak_db_lock_waiters",
     "legendFormat": "waiting on locks",
     "refId": "B"
    },
    {
     "expr": "masslak_db_idle_in_transaction",
     "legendFormat": "idle in transaction",
     "refId": "C"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Transactions, rollbacks, deadlocks per second",
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "rate(masslak_db_commits_total[5m])",
     "legendFormat": "commits",
     "refId": "A"
    },
    {
     "expr": "rate(masslak_db_rollbacks_total[5m])",
     "legendFormat": "rollbacks",
     "refId": "B"
    },
    {
     "expr": "rate(masslak_db_deadlocks_total[5m])",
     "legendFormat": "deadlocks",
     "refId": "C"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "WAL written",
   "gridPos": {
    "x": 12,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Bps"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "rate(masslak_db_wal_bytes_total[5m])",
     "legendFormat": "WAL bytes/s",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Longest transaction and replica lag",
   "gridPos": {
    "x": 0,
    "y": 36,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "masslak_db_longest_transaction_seconds",
     "legendFormat": "longest transaction",
     "refId": "A"
    },
    {
     "expr": "max(masslak_db_replication_lag_seconds)",
     "legendFormat": "replica lag",
     "refId": "B"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Dead rows (top tables)",
   "gridPos": {
    "x": 12,
    "y": 36,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "masslak_db_dead_tuples",
     "legendFormat": "{{table}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Database size and cache hit ratio",
   "gridPos": {
    "x": 0,
    "y": 44,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "masslak_db_size_bytes",
     "legendFormat": "size",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Files waiting for scan",
   "gridPos": {
    "x": 12,
    "y": 44,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "masslak_files_pending_scan",
     "legendFormat": "pending",
     "refId": "A"
    },
    {
     "expr": "masslak_files_oldest_pending_scan_seconds",
     "legendFormat": "oldest (s)",
     "refId": "B"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Growing tables (estimated rows)",
   "gridPos": {
    "x": 0,
    "y": 52,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "masslak_table_rows_estimate",
     "legendFormat": "{{table}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Trigger cost per row (ms, needs track_functions)",
   "gridPos": {
    "x": 12,
    "y": 52,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "1000 * rate(masslak_db_function_seconds_total{function=~\".*\\\\.tg_.*\"}[5m]) / clamp_min(rate(masslak_db_function_calls_total{function=~\".*\\\\.tg_.*\"}[5m]), 1e-9)",
     "legendFormat": "{{function}}",
     "refId": "A"
    }
   ]
  }
 ],
 "description": "SLOs and database health (audit T3-16); alert rules in deploy/monitoring/alerts.yml, SLOs in docs/operations/SLO.md"
}
